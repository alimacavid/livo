---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from '../components/Icon.astro';
import { DIVISIONS, PHONE, PHONE_TEL } from '../data/services';

interface Props {
  title: string;
  description?: string;
  tabBar?: boolean;       // mobile bottom tab bar (off on booking page)
  header?: 'solid' | 'overlay';
  footer?: boolean;
}
const {
  title,
  description = 'Interior cleaning, Airbnb turnovers, power washing and junk removal across Port Coquitlam, Coquitlam, Port Moody and Greater Vancouver. Upfront prices. Pay after the job.',
  tabBar = true,
  header = 'solid',
  footer = true,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title.includes('LIVO') ? title : `${title} | LIVO Property Services`;
const tabs = [
  { href: '/', label: 'Home', icon: 'home', on: path === '/' },
  { href: '/services', label: 'Services', icon: 'grid', on: path.startsWith('/services') },
  { href: '/book', label: 'Book', icon: 'calendar', on: path.startsWith('/book'), main: true },
  { href: `tel:${PHONE_TEL}`, label: 'Call', icon: 'phone', on: false },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="LIVO" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:ital,wght@0,700;0,800;1,800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness',
    name: 'LIVO Property Services', url: 'https://livoland.com', telephone: '+1-888-802-5486',
    areaServed: 'Greater Vancouver, BC',
    address: { '@type': 'PostalAddress', addressLocality: 'Port Coquitlam', addressRegion: 'BC', addressCountry: 'CA' },
  })} />
</head>
<body class={tabBar ? 'pb-[88px] md:pb-0' : ''}>
  <!-- ───── Header ───── -->
  <header id="top" data-mode={header}
    class:list={['sticky top-0 z-40 transition-colors',
      header === 'overlay' ? 'bg-white/0 md:bg-white/85' : 'bg-white/85',
      'backdrop-blur-xl border-b border-transparent data-[scrolled]:border-line data-[scrolled]:bg-white/90']}>
    <div class="mx-auto max-w-6xl h-16 px-4 md:px-6 flex items-center justify-between gap-4">
      <a href="/" aria-label="LIVO home" class="shrink-0">
        <Image src={logo} alt="LIVO" class="h-8 w-auto" widths={[140, 280]} sizes="70px" loading="eager" />
      </a>
      <nav class="hidden md:flex items-center gap-1 text-[14px] font-medium">
        <div class="relative group">
          <a href="/services" class="px-3 py-2 rounded-full hover:bg-cloud inline-flex items-center gap-1">Services <Icon name="down" class="size-4" /></a>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition absolute left-0 top-full pt-2">
            <div class="card p-2 w-72">
              {DIVISIONS.map((d) => (
                <a href={`/services/${d.id}`} class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-cloud">
                  <span class="size-9 rounded-lg bg-purple-soft text-purple grid place-items-center"><Icon name={d.icon} class="size-[18px]" /></span>
                  <span><span class="block font-semibold">{d.name}</span><span class="block text-xs text-muted">{d.subs.length} services</span></span>
                </a>
              ))}
            </div>
          </div>
        </div>
        <a href="/#how" class="px-3 py-2 rounded-full hover:bg-cloud">How it works</a>
        <a href="/#areas" class="px-3 py-2 rounded-full hover:bg-cloud">Areas</a>
        <a href="/careers.html" class="px-3 py-2 rounded-full hover:bg-cloud">Careers</a>
      </nav>
      <div class="flex items-center gap-2">
        <a href={`tel:${PHONE_TEL}`} class="hidden md:inline-flex items-center gap-2 text-sm font-semibold px-3 py-2 rounded-full hover:bg-cloud"><Icon name="phone" class="size-4" />{PHONE}</a>
        <a href="/book" class="hidden md:inline-flex btn-lime h-10 px-5 text-sm">Book now</a>
        <a href={`tel:${PHONE_TEL}`} aria-label={`Call ${PHONE}`} class="md:hidden size-10 rounded-full bg-cloud grid place-items-center text-ink active:scale-95 transition"><Icon name="phone" class="size-[18px]" /></a>
      </div>
    </div>
  </header>

  <main><slot /></main>

  <!-- ───── Footer ───── -->
  {footer && <footer class="bg-purple-ink text-white/70 mt-20">
    <div class="mx-auto max-w-6xl px-5 md:px-6 py-12 grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="font-heading font-extrabold text-2xl text-white">LIVO<span class="text-lime">.</span></div>
        <p class="mt-3 text-sm leading-relaxed">Property services across the Tri-Cities and Greater Vancouver. Four divisions. One standard.</p>
        <a href={`tel:${PHONE_TEL}`} class="mt-4 inline-flex items-center gap-2 text-white font-semibold"><Icon name="phone" class="size-4" />{PHONE}</a>
      </div>
      {DIVISIONS.slice(0, 3).map((d) => (
        <div class="hidden md:block">
          <div class="text-white font-semibold text-sm mb-3">{d.name}</div>
          <ul class="space-y-2 text-sm">{d.subs.slice(0, 5).map((s) => <li><a class="hover:text-lime" href={`/services/${d.id}/${s.slug}`}>{s.name}</a></li>)}</ul>
        </div>
      ))}
      <div class="grid grid-cols-2 gap-3 text-sm md:hidden">
        {DIVISIONS.map((d) => <a class="hover:text-lime" href={`/services/${d.id}`}>{d.name}</a>)}
        <a class="hover:text-lime" href="/careers.html">Careers</a>
      </div>
    </div>
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-5 md:px-6 py-5 text-xs flex flex-col md:flex-row gap-2 justify-between">
        <span>© {new Date().getFullYear()} LIVO Property Services · Port Coquitlam, BC</span>
        <span>Licensed & insured · Pay after the job</span>
      </div>
    </div>
  </footer>}

  <!-- ───── Mobile tab bar (app style) ───── -->
  {tabBar && (
    <nav class="md:hidden fixed bottom-0 inset-x-0 z-50 pb-safe bg-white/90 backdrop-blur-xl border-t border-line" aria-label="Main">
      <ul class="grid grid-cols-4 h-[68px] px-2">
        {tabs.map((t) => (
          <li class="flex">
            {t.main ? (
              <a href={t.href} class="flex-1 flex flex-col items-center justify-center gap-1">
                <span class="h-9 px-4 rounded-full bg-lime text-ink grid place-items-center shadow-[0_6px_16px_-6px_rgb(196_214_0/.9)]"><Icon name={t.icon} class="size-[18px]" stroke={2} /></span>
                <span class="text-[10.5px] font-semibold text-ink">{t.label}</span>
              </a>
            ) : (
              <a href={t.href} class:list={['flex-1 flex flex-col items-center justify-center gap-1 transition', t.on ? 'text-purple' : 'text-muted']}>
                <span class="h-9 grid place-items-center"><Icon name={t.icon} class="size-[22px]" stroke={t.on ? 2.1 : 1.7} /></span>
                <span class="text-[10.5px] font-semibold">{t.label}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )}

  <slot name="after" />

  <script>
    const h = document.getElementById('top');
    const onS = () => h && (window.scrollY > 8 ? h.setAttribute('data-scrolled', '') : h.removeAttribute('data-scrolled'));
    addEventListener('scroll', onS, { passive: true }); onS();
    // reveal on scroll
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>
  <style is:global>
    [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s cubic-bezier(.2,.7,.2,1); }
    [data-reveal].in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1; transform: none; transition: none; } }
  </style>
</body>
</html>
