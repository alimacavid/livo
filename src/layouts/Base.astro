---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import logoFooter from '../assets/logo-footer.png';
import Icon from '../components/Icon.astro';
import { DIVISIONS, AREAS, PHONE, PHONE_TEL, CATEGORIES, HOME_CARDS, subMin } from '../data/services';

interface Props {
  title: string;
  description?: string;
  tabBar?: boolean;       // mobile bottom tab bar (off on booking page)
  header?: 'solid' | 'overlay';
  footer?: boolean;
}
const {
  title,
  description = 'House cleaning, move out cleaning, post construction cleaning, Airbnb cleaning, office and commercial kitchen cleaning, and junk removal in Coquitlam, Port Coquitlam and Port Moody. Instant prices or a free quote. Pay after the job.',
  tabBar = true,
  header = 'solid',
  footer = true,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title.includes('LIVO') ? title : `${title} | LIVO Property Services`;
const tabs = [
  { href: '/', label: 'Home', icon: 'home', on: path === '/' },
  { href: '/services', label: 'Services', icon: 'grid', on: path.startsWith('/services') },
  { href: '/book', label: 'Book', icon: 'calendar', on: path.startsWith('/book'), main: true },
  { href: '/my-livo', label: 'My LIVO', icon: 'user', on: path.startsWith('/my-livo') },
  { href: `tel:${PHONE_TEL}`, label: 'Call', icon: 'phone', on: false },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="LIVO" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:ital,wght@0,700;0,800;1,800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness',
    name: 'LIVO Property Services', legalName: 'LIVO Property Services Ltd.', url: 'https://livoland.com', telephone: '+1-888-802-5486',
    logo: 'https://livoland.com/livo-logo.png',
    areaServed: AREAS.map((a) => ({ '@type': 'City', name: `${a}, BC` })),
    makesOffer: DIVISIONS.map((d) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: d.name, url: `https://livoland.com/services/${d.id}` } })),
    address: { '@type': 'PostalAddress', addressLocality: 'Port Coquitlam', addressRegion: 'BC', addressCountry: 'CA' },
  })} />
</head>
<body class={tabBar ? 'pb-[88px] md:pb-0' : ''}>
  <a href="#main" class="sr-only-focusable fixed top-2 left-2 z-[100] btn-dark h-11 px-5 text-sm">Skip to content</a>
  <!-- ───── Header ───── -->
  <header id="top" data-mode={header} style="view-transition-name: site-header"
    class:list={['sticky top-0 z-40 transition-colors',
      header === 'overlay' ? 'bg-white/0 md:bg-white/85' : 'bg-white/85',
      'backdrop-blur-xl border-b border-transparent data-[scrolled]:border-line data-[scrolled]:bg-white/90']}>
    <div class="relative mx-auto max-w-6xl h-16 px-4 md:px-6 flex items-center justify-between gap-4">
      <a href="/" aria-label="LIVO home" class="shrink-0">
        <Image src={logo} alt="LIVO" class="h-8 w-auto" widths={[140, 280]} sizes="70px" loading="eager" />
      </a>
      <nav class="hidden md:flex items-center gap-1 text-[14px] font-medium">
        <div data-dd>
          <a href="/services" id="services-toggle" aria-expanded="false" aria-controls="services-dropdown" class="px-3 min-h-11 rounded-full hover:bg-cloud inline-flex items-center gap-1" data-service-toggle>
            Services <Icon name="down" class="size-4 transition-transform duration-150" />
          </a>
          <div id="services-dropdown" hidden class="absolute inset-x-4 md:inset-x-6 top-full pt-2" data-service-dropdown>
            <div class="card overflow-hidden bg-white text-ink shadow-lift">
              <div class="grid grid-cols-4 gap-2 p-3" data-menu-categories>
                {CATEGORIES.map(({ label, divs: list }) => {
                  const feature = HOME_CARDS.find((card) => card.divisionId === list[0].id)!;
                  const first = list[0].subs[0];
                  return <div class="min-w-0">
                    <a href={list[0].id === 'junk-removal' ? '/services/junk-removal' : `/services/${list[0].id}/${first.slug}`} class="relative block h-[120px] overflow-hidden rounded-xl mb-3" data-category-photo>
                      <Image src={feature.image} alt="" class={`absolute inset-0 size-full object-cover ${feature.pos ?? ''}`} widths={[400, 700, 1000]} sizes="(min-width:1152px) 280px, 25vw" quality={85} />
                      <span class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></span>
                      <span class="absolute inset-x-0 bottom-0 p-3 text-white font-heading font-extrabold text-sm leading-tight">{label}</span>
                    </a>
                    {list.flatMap((d) => d.subs.map((s) => {
                      const price = subMin(s);
                      return <a href={d.id === 'junk-removal' ? '/services/junk-removal' : `/services/${d.id}/${s.slug}`} aria-current={path === `/services/${d.id}/${s.slug}` ? 'page' : undefined} class="mega-service relative flex items-center justify-between gap-2 px-2.5 py-3 rounded-xl min-h-14">
                        <Image src={s.image} alt="" class={`size-10 shrink-0 rounded-lg object-cover ${s.pos ?? ''}`} widths={[80, 160]} sizes="40px" quality={85} />
                        <span class="mega-name flex-1 min-w-0 font-semibold text-[13px] leading-snug">{s.name}</span>
                        <span class="shrink-0 text-right text-[11.5px] text-muted">{price != null ? `from $${price.toLocaleString('en-CA')}${d.segment === 'commercial' ? ' + tax' : ''}` : 'Free quote'}</span>
                      </a>;
                    }))}
                  </div>;
                })}
              </div>
              <div class="flex items-center justify-between gap-4 px-5 py-3 bg-purple-soft border-t border-line">
                <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center min-h-11 text-sm font-semibold text-purple">Not sure? Call {PHONE}</a>
                <a href="/book" class="btn-lime px-6">Book now</a>
              </div>
            </div>
          </div>
        </div>
        <a href="/#how" class="px-3 py-2 rounded-full hover:bg-cloud">How it works</a>
        <a href="#areas" class="px-3 py-2 rounded-full hover:bg-cloud">Areas</a>
        <a href="/careers.html" class="px-3 py-2 rounded-full hover:bg-cloud">Careers</a>
        <a href="/my-livo" aria-current={path.startsWith('/my-livo') ? 'page' : undefined} class="px-3 py-2 rounded-full hover:bg-cloud inline-flex items-center gap-1.5 aria-[current]:text-purple"><Icon name="user" class="size-4" />My LIVO</a>
      </nav>
      <div class="flex items-center gap-2">
        <a href={`tel:${PHONE_TEL}`} class="hidden md:inline-flex items-center gap-2 text-sm font-semibold px-3 py-2 rounded-full hover:bg-cloud"><Icon name="phone" class="size-4" />{PHONE}</a>
        <a href="/book" class="hidden md:inline-flex btn-lime h-10 px-5 text-sm">Book now</a>
        <a href={`tel:${PHONE_TEL}`} aria-label={`Call ${PHONE}`} class="md:hidden size-10 rounded-full bg-cloud grid place-items-center text-ink active:scale-95 transition"><Icon name="phone" class="size-[18px]" /></a>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1" class="outline-none"><slot /></main>

  <!-- ───── Footer ───── -->
  <footer hidden={!footer} data-footer-on-demand={!footer ? "" : undefined} class="on-dark bg-purple-ink text-white/75 mt-20">
    <div class="md:hidden mx-auto max-w-6xl px-5 pt-8 pb-4" data-footer-mobile>
      <Image src={logoFooter} alt="LIVO" class="h-9 w-auto" widths={[160, 320]} sizes="80px" />
      <p class="mt-3 text-sm leading-relaxed">Property services across Greater Vancouver. One crew. One standard.</p>
      <a href={`tel:${PHONE_TEL}`} class="mt-2 min-h-11 inline-flex items-center gap-2 text-white font-semibold"><Icon name="phone" class="size-4" />{PHONE}</a>
      <div class="mt-5 border-t border-white/10">
        {CATEGORIES.map(({ label, divs: list }) => <details class="group border-b border-white/10" data-footer-accordion>
          <summary class="min-h-11 flex items-center justify-between gap-3 list-none text-white font-semibold text-sm">{label}<Icon name="down" class="size-4 transition-transform duration-150 group-open:rotate-180" /></summary>
          <ul class="pb-3 text-sm">{list.flatMap(d => d.subs.map(s => <li><a class="inline-flex items-center min-h-11 hover:text-lime" href={d.id === 'junk-removal' ? '/services/junk-removal' : `/services/${d.id}/${s.slug}`}>{s.name}</a></li>))}</ul>
        </details>)}
      </div>
      <nav aria-label="LIVO footer" class="mt-4 flex items-center gap-6 text-sm">
        <a href="/my-livo" class="min-h-11 inline-flex items-center hover:text-lime">My LIVO</a>
        <a href="/careers.html" class="min-h-11 inline-flex items-center hover:text-lime">Careers</a>
        <a href="/privacy" class="min-h-11 inline-flex items-center hover:text-lime">Privacy Policy</a>
      </nav>
    </div>
    <div class="hidden md:grid mx-auto max-w-6xl px-5 md:px-6 py-12 grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-5">
      <div class="col-span-2 md:col-span-5">
        <Image src={logoFooter} alt="LIVO" class="h-9 w-auto" widths={[160, 320]} sizes="80px" />
        <p class="mt-3 text-sm leading-relaxed">Property services across Greater Vancouver. One crew. One standard.</p>
        <a href={`tel:${PHONE_TEL}`} class="mt-4 inline-flex items-center gap-2 text-white font-semibold"><Icon name="phone" class="size-4" />{PHONE}</a>
      </div>
      {CATEGORIES.map(({ label, divs: list }) => (
        <div>
          <div class="text-white font-semibold text-sm mb-3">{label}</div>
          <ul class="space-y-2 text-sm">{list.flatMap((d) => d.subs.map((s) => <li><a class="hover:text-lime inline-block py-1" href={d.id === 'junk-removal' ? '/services/junk-removal' : `/services/${d.id}/${s.slug}`}>{s.name}</a></li>))}</ul>
        </div>
      ))}
      <div>
        <div class="text-white font-semibold text-sm mb-3">LIVO</div>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-lime inline-block py-1" href="/my-livo">My LIVO</a></li>
          <li><a class="hover:text-lime inline-block py-1" href="/careers.html">Careers</a></li>
          <li><a class="hover:text-lime inline-block py-1" href="/privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <section id="areas" class="mx-auto max-w-6xl px-5 md:px-6 pb-10 scroll-mt-24" aria-labelledby="areas-heading">
      <h2 id="areas-heading" class="hidden md:block text-sm font-bold text-white">Serving Greater Vancouver</h2>
      <p class="md:hidden text-[12px] leading-relaxed" aria-label="Serving Greater Vancouver">{AREAS.slice(0, 3).join(', ')} + {AREAS.length - 3} more areas</p>
      <ul class="hidden md:flex mt-4 flex-wrap gap-2" aria-label="Service areas">
        {AREAS.map((area) => <li class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[12px] text-white/85">{area}</li>)}
      </ul>
    </section>
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-5 md:px-6 py-5 text-xs flex flex-col md:flex-row gap-2 justify-between">
        <span>© {new Date().getFullYear()} LIVO Property Services Ltd.</span>
      </div>
    </div>
  </footer>

  <!-- ───── Mobile tab bar (app style) ───── -->
  {tabBar && (
    <nav class="md:hidden fixed bottom-0 inset-x-0 z-50 pb-safe bg-white/95 backdrop-blur-xl border-t border-line" aria-label="Main" style="view-transition-name: tab-bar">
      <ul class="relative grid grid-cols-5 h-[68px] px-1" data-tabs>
        {tabs.map((t) => (
          <li class="flex">
            {t.main ? (
              <a href={t.href} aria-current={t.on ? 'page' : undefined} class="press flex-1 flex flex-col items-center justify-center gap-1">
                <span class="sheen relative overflow-hidden h-9 px-4 rounded-full bg-lime text-ink grid place-items-center shadow-[0_6px_16px_-6px_rgb(196_214_0/.9)]"><Icon name={t.icon} class="size-[18px]" stroke={2} /></span>
                <span class="text-[11px] font-semibold text-ink">{t.label}</span>
              </a>
            ) : (
              <a href={t.href} aria-current={t.on ? 'page' : undefined} aria-label={t.icon === 'phone' ? `Call ${PHONE}` : undefined}
                class:list={['press relative flex-1 flex flex-col items-center justify-center gap-1 transition-colors', t.on ? 'text-purple' : 'text-[#55555A]']}>
                {t.on && <span class="tab-dot absolute top-1.5 h-1 w-6 rounded-full bg-purple" aria-hidden="true"></span>}
                <span class="h-9 grid place-items-center"><Icon name={t.icon} class="size-[22px]" stroke={t.on ? 2.1 : 1.7} /></span>
                <span class="text-[11px] font-semibold">{t.label}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )}

  <slot name="after" />

  <script>
    const h = document.getElementById('top');
    const onS = () => h && (window.scrollY > 8 ? h.setAttribute('data-scrolled', '') : h.removeAttribute('data-scrolled'));
    addEventListener('scroll', onS, { passive: true }); onS();
    // reveal on scroll — siblings get a small stagger
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
      if (!el.style.getPropertyValue('--i')) el.style.setProperty('--i', String([...(el.parentElement?.children ?? [])].indexOf(el) % 6));
      io.observe(el);
    });
    // Services remains a normal link; hover and focus preview its menu.
    const dd = document.querySelector<HTMLElement>('[data-dd]')!;
    const toggle = document.querySelector<HTMLAnchorElement>('[data-service-toggle]')!;
    const menu = document.querySelector<HTMLElement>('[data-service-dropdown]')!;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    dd.addEventListener('mouseenter', () => setOpen(true));
    dd.addEventListener('mouseleave', () => { if (!dd.contains(document.activeElement)) setOpen(false); });
    dd.addEventListener('focusin', () => setOpen(true));
    dd.addEventListener('focusout', (event) => {
      if (!dd.contains(event.relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener('pointerdown', (event) => {
      if (!dd.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) { toggle.focus(); setOpen(false); }
    });
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    // Booking keeps one screen per step; its Areas link opens the shared footer on demand.
    const onDemandFooter = document.querySelector<HTMLElement>('[data-footer-on-demand]');
    if (onDemandFooter) {
      const syncAreas = () => {
        onDemandFooter.hidden = location.hash !== '#areas';
        if (!onDemandFooter.hidden) document.getElementById('areas')?.scrollIntoView();
      };
      addEventListener('hashchange', syncAreas);
      document.querySelector('header a[href="#areas"]')?.addEventListener('click', () => { onDemandFooter.hidden = false; });
      syncAreas();
    }
  </script>
  <style is:global>
    .tab-dot { animation: pop-in 420ms var(--ease-spring) both; }
    [data-service-toggle][aria-expanded="true"] svg { transform: rotate(180deg); }
    .mega-service, .mega-name { transition: background-color 150ms, color 150ms; }
    .mega-service::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 3px; background: var(--color-lime); opacity: 0; transition: opacity 150ms; }
    .mega-service:is(:hover, :focus-visible) { background: var(--color-purple-soft); }
    .mega-service:is(:hover, :focus-visible) .mega-name { color: var(--color-purple); }
    .mega-service:is(:hover, :focus-visible)::before { opacity: 1; }
    @media (prefers-reduced-motion: reduce) {
      .mega-service, .mega-name, .mega-service::before { transition: none; }
    }
  </style>
</body>
</html>
