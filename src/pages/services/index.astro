---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SubRow from '../../components/SubRow.astro';
import { DIVISIONS } from '../../data/services';
---
<Base title="All Services" description="Every LIVO service with upfront prices: interior cleaning, move-out cleaning, after-construction clean-up, Airbnb turnovers, power washing, window and gutter cleaning, and junk removal.">
  <section class="mx-auto max-w-6xl px-4 md:px-6 pt-4 md:pt-12">
    <h1 class="text-[1.9rem] md:text-5xl font-extrabold">Services</h1>
    <p class="mt-1 text-muted">Upfront prices. Pay after the job.</p>
    <!-- jump chips -->
    <div class="sticky top-16 z-30 -mx-4 px-4 md:mx-0 md:px-0 py-3 bg-white/90 backdrop-blur-xl">
      <div class="flex gap-2 overflow-x-auto no-scrollbar">
        {DIVISIONS.map((d) => <a href={`#${d.id}`} class="shrink-0 inline-flex items-center gap-1.5 h-9 px-4 rounded-full bg-cloud text-[13px] font-semibold hover:bg-purple-soft"><Icon name={d.icon} class="size-4 text-purple" />{d.name}</a>)}
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-4 md:px-6 space-y-10 mt-2">
    {DIVISIONS.map((d) => (
      <section id={d.id} class="scroll-mt-32">
        <div class="flex items-end justify-between">
          <div>
            <h2 class="text-xl md:text-2xl font-extrabold">{d.name}</h2>
            <p class="text-sm text-muted">{d.tagline}</p>
          </div>
          <a href={`/services/${d.id}`} class="text-sm font-semibold text-purple shrink-0">Details</a>
        </div>
        <div class="mt-4 grid md:grid-cols-2 gap-3">
          {d.subs.map((s) => <SubRow div={d} sub={s} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
