---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SubRow from '../../components/SubRow.astro';
import { DIVISIONS } from '../../data/services';
const groups = [
  { id: 'residential', label: 'Residential', line: 'Homes, condos and rentals. Prices show right away.', list: DIVISIONS.filter((d) => d.segment === 'residential') },
  { id: 'commercial', label: 'Commercial', line: 'Offices, stores, strata and restaurants. Free quote, usually the same day.', list: DIVISIONS.filter((d) => d.segment === 'commercial') },
];
---
<Base title="Cleaning & Junk Removal Services in Coquitlam" description="All LIVO services: house cleaning, move out cleaning, post construction cleaning, Airbnb cleaning, office and commercial cleaning, restaurant kitchen cleaning and junk removal in Coquitlam, Port Coquitlam and Port Moody.">
  <section class="mx-auto max-w-6xl px-4 md:px-6 pt-4 md:pt-12">
    <h1 class="rise text-[1.9rem] md:text-5xl font-extrabold" style="--i:0">Services</h1>
    <p class="rise mt-1 text-muted" style="--i:1">Instant prices or a free quote. Pay after the job.</p>
    <!-- jump chips -->
    <div class="sticky top-16 z-30 -mx-4 px-4 md:mx-0 md:px-0 py-3 bg-white/90 backdrop-blur-xl">
      <div class="flex gap-2 overflow-x-auto no-scrollbar">
        {groups.map((g) => g.list.map((d) => <a href={`#${d.id}`} class="press shrink-0 inline-flex items-center gap-1.5 h-11 px-4 rounded-full bg-cloud text-[15px] font-semibold hover:bg-purple-soft transition-colors aria-[current]:bg-purple aria-[current]:text-white" data-chip><Icon name={d.icon} class="size-4" />{d.name}</a>))}
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-4 md:px-6 mt-2">
    {groups.map((g) => (
      <div id={g.id} class="scroll-mt-32 section-gap first:mt-6">
        <div class="flex items-center gap-3">
          <h2 class="text-base font-bold text-ink">{g.label}</h2>
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        </div>
        <p class="mt-1 text-[15px] text-muted">{g.line}</p>
        <div class="service-groups mt-6">
          {g.list.map((d) => (
            <section id={d.id} class="scroll-mt-32">
              <div class="flex items-end justify-between gap-4">
                <div>
                  <h3 class="text-xl md:text-2xl font-extrabold">{d.name}</h3>
                  <p class="text-[15px] text-muted">{d.tagline}</p>
                </div>
                <a href={`/services/${d.id}`} class="text-[15px] font-semibold text-purple shrink-0 min-h-11 inline-flex items-center">Details</a>
              </div>
              <div class="mt-4 grid md:grid-cols-2 gap-x-8">
                {d.subs.map((s) => <div data-reveal><SubRow div={d} sub={s} /></div>)}
              </div>
            </section>
          ))}
        </div>
      </div>
    ))}
  </div>
</Base>

<script>
  // highlight the chip for the section you're looking at
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-chip]')];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    chips.forEach((c) => c.getAttribute('href') === '#' + e.target.id ? (c.setAttribute('aria-current', 'true'), c.parentElement!.scrollTo({ left: c.offsetLeft - 16, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' })) : c.removeAttribute('aria-current'));
  }), { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('section[id]').forEach((s) => io.observe(s));
</script>
