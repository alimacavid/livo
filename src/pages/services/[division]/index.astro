---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import SubRow from '../../../components/SubRow.astro';
import Extras from '../../../components/Extras.astro';
import { Image } from 'astro:assets';
import { DIVISIONS, minPrice, isQuoteSub, type Division } from '../../../data/services';
export function getStaticPaths() {
  return DIVISIONS.map((d) => ({ params: { division: d.id }, props: { d } }));
}
const { d } = Astro.props as { d: Division };
const from = minPrice(d);
const allQuote = d.subs.every(isQuoteSub);
const priceLine = allQuote && from == null ? 'Free quote, usually the same day.' : allQuote ? `From $${from}, final price after photos.` : `Instant prices from $${from}.`;
---
<Base title={d.seoTitle} description={`${d.intro} ${priceLine} LIVO Property Services.`}>
  <section class="page-heading mx-auto max-w-6xl px-4 md:px-6">
    <a href={`/services#${d.segment}`} class="press inline-flex min-h-11 items-center gap-2 text-[15px] font-semibold text-muted"><Icon name="back" class="size-4" />Back to services</a>
    <p class="mt-4 text-[15px] text-muted">{d.segment === 'residential' ? 'Residential' : 'Commercial'}</p>
    <h1 class="rise mt-2 text-3xl md:text-5xl font-extrabold">{d.name}</h1>
    <p class="mt-3 max-w-xl text-base text-muted">{d.tagline}</p>
    <p class="mt-4 font-semibold text-base">{allQuote && from == null ? 'Free quote' : `From $${from}`}</p>
    <div class="mt-6 overflow-hidden rounded-panel bg-cloud h-56 md:h-96">
      <Image src={d.image} alt={`${d.name} by LIVO`} class="size-full object-cover" widths={[480, 900, 1400]} sizes="(min-width:1152px) 1152px, 100vw" loading="eager" />
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <p class="mt-6 text-[15.5px] leading-relaxed text-ink/85 max-w-3xl">{d.intro}</p>
    <section class="section-gap">
      <h2 class="text-lg md:text-2xl font-extrabold">Choose a service</h2>
      <div class="mt-4 grid md:grid-cols-2 gap-3">{d.subs.map((s) => <div data-reveal><SubRow div={d} sub={s} /></div>)}</div>
    </section>
    {d.addons.length > 0 && <section class="section-gap">
      <h2 class="text-lg md:text-2xl font-extrabold">Add-ons</h2>
      <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3">
        {d.addons.map((a) => (
          <div class="py-4">
            <div class="font-semibold text-[14px] leading-snug">{a.name}</div>
            <div class="text-[15px] text-muted">{a.sub}</div>
            <div class="mt-2 text-[15px]"><b>${a.price}</b> <span class="text-muted text-xs">{a.unit}</span></div>
          </div>
        ))}
      </div>
    </section>}
    <div class="max-w-3xl"><Extras d={d} /></div>
    <section class="max-w-3xl section-gap">
      <h2 class="text-lg md:text-2xl font-extrabold">Questions</h2>
      <div class="mt-3 divide-y divide-line ">
        {d.faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-[15px] min-h-11">{f.q}<Icon name="plus" class="size-5 shrink-0 text-muted transition duration-300 group-open:rotate-45 group-open:text-purple" /></summary>
            <p class="mt-2 text-[15px] text-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
</Base>
