---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import BeforeAfter from '../../../components/BeforeAfter.astro';
import Extras from '../../../components/Extras.astro';
import { Image } from 'astro:assets';
import { DIVISIONS, PHONE, PHONE_TEL, FIRST_TIME_DISCOUNT, subMin, isQuoteSub, type Division, type Sub } from '../../../data/services';

export function getStaticPaths() {
  return DIVISIONS.flatMap((d) => d.subs.map((s) => ({ params: { division: d.id, sub: s.slug }, props: { d, s } })));
}
const { d, s } = Astro.props as { d: Division; s: Sub };
const from = subMin(s);
const quote = isQuoteSub(s);
const firstOff = !quote && d.segment === 'residential' ? Math.round(FIRST_TIME_DISCOUNT * 100) : 0;
const cta = quote ? 'Get a free quote' : `Book ${s.name}`;
const def = s.tiers.find((t) => t.popular) ?? s.tiers[0];
const others = d.subs.filter((x) => x.slug !== s.slug);
const bookUrl = (tier: string) => `/book?d=${d.id}&s=${s.slug}&t=${tier}`;
const recurringFreqs = d.freqs.filter((f) => f.discount > 0);
---
<Base title={`${s.name} in Coquitlam & Port Coquitlam`} description={`${s.name} by LIVO in Coquitlam, Port Coquitlam and Port Moody. ${s.short} ${quote ? (from ? `From $${from}, final price after photos.` : 'Free quote, usually the same day.') : `Instant price from $${from}.`} Pay after the job.`} tabBar={false}>

  <!-- Words on white, with an unobstructed service photo -->
  <section class="page-heading mx-auto max-w-6xl px-4 md:px-6">
    <a href={`/services/${d.id}`} class="press inline-flex min-h-11 items-center gap-2 text-[15px] font-semibold text-muted" aria-label={`Back to ${d.name}`}><Icon name="back" class="size-4" />{d.short}</a>
    <p class="mt-4 text-[15px] text-muted">{d.segment === 'residential' ? 'Residential' : 'Commercial'}</p>
    <h1 class="rise mt-2 text-3xl md:text-5xl font-extrabold leading-tight">{s.name}</h1>
    <p class="mt-3 max-w-xl text-base text-muted">{s.short}</p>
    <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-cloud text-ink px-4 py-2 text-[15px] font-semibold">
      {from ? <>From ${from} <span class="font-normal">· {quote ? 'estimate' : s.unit}</span></> : 'Free quote'}
    </div>
    <div class="mt-6 overflow-hidden rounded-panel bg-cloud h-56 md:h-[420px]">
      <Image src={s.image} alt={`${s.name} by LIVO`} class="size-full object-cover" widths={[480, 900, 1400]} sizes="(min-width:1152px) 1152px, 100vw" loading="eager" />
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 md:px-6 md:grid md:grid-cols-[1fr_360px] md:gap-12">
    <div>
      <!-- INTRO -->
      <p class="mt-7 text-[15.5px] leading-relaxed text-ink/85">{s.desc}</p>

      <!-- PRICE TABLE -->
      <section class="section-gap" id="prices">
        <div class="flex items-end justify-between">
          <h2 class="text-xl font-extrabold">{s.recurring ? 'Recurring prices' : quote && from == null ? 'Get a free quote' : quote ? 'Starting prices' : 'Prices'}</h2>
          {s.draft && <span class="text-[11px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 px-2 py-1 rounded-full">Draft prices</span>}
        </div>
        <p class="text-[15px] text-muted mt-0.5">{s.recurring ? 'Per visit. Save more the more often we come.' : quote && from == null ? 'Free, no-obligation. Send photos, or ask for a free site visit.' : quote ? 'Estimated starting price by size. Send photos and we confirm the final price.' : `Pick your ${s.tierLabel.toLowerCase()}. Prices include supplies.`}</p>

        {s.recurring ? (
          <div class="mt-4 card overflow-hidden">
            <table class="w-full text-[15px]">
              <thead class="bg-cloud text-[12px] text-muted">
                <tr><th class="text-left font-semibold p-3">{s.tierLabel}</th>{recurringFreqs.map((f) => <th class="font-semibold p-3 text-right">{f.name}<span class="block text-ink">−{Math.round(f.discount * 100)}%</span></th>)}</tr>
              </thead>
              <tbody class="divide-y divide-line">
                {s.tiers.map((t) => (
                  <tr><td class="p-3"><b class="font-semibold">{t.name}</b><span class="block text-xs text-muted">{t.sub}</span></td>
                    {recurringFreqs.map((f) => <td class="p-3 text-right font-heading font-bold">${Math.round((t.price ?? 0) * (1 - f.discount))}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="mt-4 grid gap-2.5" role="radiogroup" aria-label={s.tierLabel} data-tiers>
            {s.tiers.map((t) => (
              <label class="press relative flex items-center gap-4 p-4 rounded-panel border border-muted bg-white cursor-pointer transition-colors hover:border-gray has-[:checked]:border-purple has-[:checked]:bg-purple-soft/60">
                <input type="radio" name="tier" value={t.id} data-price={t.price ?? ''} data-name={t.name} checked={t.id === def.id} class="peer sr-only" />
                <span aria-hidden="true" class="size-5 rounded-full border-2 border-muted grid place-items-center transition-colors peer-checked:border-purple peer-checked:[&>span]:scale-100"><span class="size-2.5 rounded-full bg-purple scale-0 transition duration-300 ease-[var(--ease-spring)]"></span></span>
                <span class="flex-1 min-w-0">
                  <span class="block font-semibold text-[15px]">{t.name} {t.popular && <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider bg-purple-soft text-ink px-1.5 py-0.5 rounded">Popular</span>}</span>
                  <span class="block text-[15px] text-muted">{t.sub}</span>
                </span>
                <span class="font-heading font-extrabold text-lg">{t.price != null ? <>{quote && <span class="block text-[10.5px] font-sans font-medium text-muted text-right leading-none">from</span>}${t.price}</> : <span class="text-[15px] text-purple">{from == null ? 'Free' : 'Quote'}</span>}</span>
              </label>
            ))}
          </div>
        )}
        {s.quoteNote && <p class="mt-3 text-[15px] text-muted flex gap-2"><Icon name="camera" class="size-4 shrink-0 mt-0.5 text-purple" />{s.quoteNote}</p>}
        {quote && (
          <ol class="mt-5 grid grid-cols-3 gap-2 text-center">
            {[['camera', 'Send photos'], ['clock', 'Quote, usually same day'], ['calendar', 'Pick your date']].map(([ic, t], i) => (
              <li class="py-3"><span class="mx-auto size-9 rounded-full bg-white text-purple grid place-items-center shadow-soft" aria-hidden="true"><Icon name={ic} class="size-[18px]" /></span><span class="block mt-2 text-[15px] font-semibold leading-snug"><span class="sr-only">Step {i + 1}: </span>{t}</span></li>
            ))}
          </ol>
        )}
      </section>

      <!-- INCLUDED -->
      <section class="section-gap">
        <h2 class="text-xl font-extrabold">What's included</h2>
        <ul id="included-items" class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-3">
          {s.included.map((i, index) => (
            <li data-included-extra={index >= 4 ? true : undefined} class="flex gap-3 text-base"><span class="shrink-0 size-6 rounded-full bg-lime-soft text-ink grid place-items-center"><Icon name="check" class="size-3.5" stroke={3} /></span>{i}</li>
          ))}
        </ul>
        {s.included.length > 4 && <button type="button" data-included-toggle aria-controls="included-items" aria-expanded="false" class="press hidden mt-4 min-h-11 items-center gap-2 text-[15px] font-semibold text-purple underline underline-offset-4">Show all</button>}
      </section>

      {s.before && s.after && (
        <section class="section-gap">
          <h2 class="text-xl font-extrabold">Before & after</h2>
          <BeforeAfter before={s.before} after={s.after} alt={s.name} class="mt-4" />
        </section>
      )}

      <!-- ADD-ONS -->
      {d.addons.length > 0 && <section class="section-gap">
        <h2 class="text-xl font-extrabold">Popular add-ons</h2>
        <p class="text-[15px] text-muted mt-0.5">Tap to add. They carry over to your booking.</p>
        <div class="mt-4 flex gap-3 overflow-x-auto no-scrollbar -mx-4 px-4 md:mx-0 md:px-0 md:grid md:grid-cols-3" data-addons>
          {d.addons.map((a) => (
            <button type="button" data-addon={a.id} data-aprice={a.price} aria-pressed="false"
              class="press group relative shrink-0 w-40 md:w-auto text-left rounded-card border border-muted bg-white p-4 transition-colors aria-pressed:border-purple aria-pressed:bg-purple-soft">
              <span aria-hidden="true" class="absolute top-3 right-3 size-6 rounded-full grid place-items-center bg-white text-muted transition duration-300 group-aria-pressed:bg-purple group-aria-pressed:text-white group-aria-pressed:rotate-[360deg]">
                <Icon name="plus" class="size-3.5 group-aria-pressed:hidden" stroke={2.4} /><Icon name="check" class="size-3.5 hidden group-aria-pressed:block" stroke={3} />
              </span>
              <span class="block font-semibold text-[14px] leading-snug pr-7">{a.name}</span>
              <span class="block text-[12px] text-muted">{a.sub}</span>
              <span class="block mt-2 text-[15px]"><b>+${a.price}</b> <span class="text-muted text-[11px]">{a.unit}</span></span>
            </button>
          ))}
        </div>
      </section>}

      <Extras d={d} skip={s.slug} />

      <!-- GOOD FOR -->
      <section class="section-gap">
        <h2 class="text-xl font-extrabold">Great for</h2>
        <div class="mt-3 flex flex-wrap gap-2">{s.goodFor.map((g) => <span class="px-3.5 py-2 rounded-full bg-purple-soft text-purple text-[15px] font-semibold">{g}</span>)}</div>
      </section>

      <!-- FAQ -->
      <section class="section-gap">
        <h2 class="text-xl font-extrabold">Questions</h2>
        <div class="mt-2 divide-y divide-line ">
          {d.faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-[15px] min-h-11">{f.q}<Icon name="plus" class="size-5 shrink-0 text-muted transition duration-300 group-open:rotate-45 group-open:text-purple" /></summary>
              <p class="mt-2 text-[15px] text-muted leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- MORE -->
      {others.length > 0 && (
        <section class="section-gap">
          <h2 class="text-xl font-extrabold">More {d.short.toLowerCase()} services</h2>
          <div class="mt-4 flex gap-3 overflow-x-auto no-scrollbar -mx-4 px-4 md:mx-0 md:px-0 snap-x">
            {others.map((o) => (
              <a href={`/services/${d.id}/${o.slug}`} class="snap-start shrink-0 w-56 rounded-card overflow-hidden">
                <div class="aspect-[16/10] bg-cloud overflow-hidden"><Image src={o.image} alt="" class="size-full object-cover" widths={[320, 480]} sizes="224px" /></div>
                <div class="p-3.5"><div class="font-heading font-bold text-[14px]">{o.name}</div><div class="text-[15px] text-muted">{subMin(o) ? `From $${subMin(o)}` : 'Free quote'}</div></div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- DESKTOP BOOKING CARD -->
    <aside class="hidden md:block">
      <div class="sticky top-24 mt-10 p-6 rounded-panel bg-cloud">
        <div class="text-[15px] text-muted">{quote ? (from ? 'Starting from' : 'Price') : 'Your price'}</div>
        <div class="font-heading font-extrabold text-4xl mt-1" data-price-out data-from={quote ? '' : undefined} aria-live="polite">{def.price != null ? `${quote ? 'from ' : ''}$${def.price}` : 'Free quote'}</div>
        <div class="text-[15px] text-muted" data-name-out>{def.name}</div>
        <a href={bookUrl(def.id)} data-book class="sheen btn-lime w-full mt-5">{cta}</a>
        <a href={`tel:${PHONE_TEL}`} class="btn-ghost w-full mt-2 text-ink"><Icon name="phone" class="size-4" />{PHONE}</a>
        <ul class="mt-5 space-y-2 text-[15px] text-muted">
          <li class="flex gap-2"><Icon name="check" class="size-4 text-ink" stroke={2.5} />Pay after the job</li>
          {firstOff > 0 && <li class="flex gap-2"><Icon name="check" class="size-4 text-ink" stroke={2.5} />{firstOff}% off your first booking</li>}
          {quote && <li class="flex gap-2"><Icon name="check" class="size-4 text-ink" stroke={2.5} />Free quote, no obligation</li>}
          <li class="flex gap-2"><Icon name="check" class="size-4 text-ink" stroke={2.5} />Uniformed LIVO crew</li>
        </ul>
      </div>
    </aside>
  </div>

  <!-- MOBILE STICKY BOOK BAR -->
  <div slot="after" style="view-transition-name: tab-bar" class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/92 backdrop-blur-xl border-t border-line pb-safe">
    <div class="flex items-center gap-3 px-4 h-[76px]">
      <div class="flex-1 min-w-0">
        <div class="font-heading font-extrabold text-xl leading-none" data-price-out data-from={quote ? '' : undefined}>{def.price != null ? `${quote ? 'from ' : ''}$${def.price}` : 'Free quote'}</div>
        <div class="text-[12px] text-muted truncate mt-1" data-name-out>{def.name}</div>
      </div>
      <a href={`tel:${PHONE_TEL}`} aria-label={`Call ${PHONE}`} class="press size-12 rounded-full bg-cloud grid place-items-center"><Icon name="phone" class="size-5" /></a>
      <a href={bookUrl(def.id)} data-book class="sheen btn-lime px-7">{quote ? 'Get quote' : 'Book now'}</a>
    </div>
  </div>
  <div class="md:hidden h-24"></div>
</Base>

<script>
  const includedToggle = document.querySelector<HTMLButtonElement>('[data-included-toggle]');
  includedToggle?.addEventListener('click', () => {
    const expanded = includedToggle.getAttribute('aria-expanded') !== 'true';
    includedToggle.setAttribute('aria-expanded', String(expanded));
    document.getElementById('included-items')?.classList.toggle('expanded', expanded);
    includedToggle.textContent = expanded ? 'Show less' : 'Show all';
  });
  // selected size + add-ons → live price, name and Book link
  const st = { tier: '', price: null as number | null, name: '', addons: new Set<string>() };
  const checked = document.querySelector<HTMLInputElement>('[data-tiers] input:checked');
  if (checked) { st.tier = checked.value; st.price = checked.dataset.price ? +checked.dataset.price : null; st.name = checked.dataset.name!; }
  else {
    const a = document.querySelector<HTMLAnchorElement>('[data-book]');
    const u = a ? new URL(a.href) : null; st.tier = u?.searchParams.get('t') ?? '';
    const out = document.querySelector('[data-price-out]')?.textContent ?? '';
    st.price = out.startsWith('$') ? +out.slice(1) : null; st.name = document.querySelector('[data-name-out]')?.textContent ?? '';
  }
  function update() {
    let add = 0; const names: string[] = [];
    document.querySelectorAll<HTMLButtonElement>('[data-addon]').forEach((b) => {
      if (st.addons.has(b.dataset.addon!)) { add += +b.dataset.aprice!; names.push(b.querySelector('span.block')!.textContent!); }
    });
    const pre = document.querySelector('[data-price-out]')?.hasAttribute('data-from') ? 'from ' : '';
    const price = st.price != null ? `${pre}$${st.price + add}` : 'Free quote';
    document.querySelectorAll<HTMLElement>('[data-price-out]').forEach((el) => {
      if (el.textContent === price) return;
      el.textContent = price; el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump');
    });
    document.querySelectorAll('[data-name-out]').forEach((el) => (el.textContent = st.name + (names.length ? ` + ${names.length} add-on${names.length > 1 ? 's' : ''}` : '')));
    document.querySelectorAll<HTMLAnchorElement>('[data-book]').forEach((a) => {
      const u = new URL(a.href); u.searchParams.set('t', st.tier);
      st.addons.size ? u.searchParams.set('a', [...st.addons].join(',')) : u.searchParams.delete('a');
      a.href = u.pathname + u.search;
    });
  }
  document.querySelector('[data-tiers]')?.addEventListener('change', (e) => {
    const r = e.target as HTMLInputElement;
    st.tier = r.value; st.price = r.dataset.price ? +r.dataset.price : null; st.name = r.dataset.name!;
    update();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-addon]').forEach((b) => b.addEventListener('click', () => {
    const id = b.dataset.addon!;
    st.addons.has(id) ? st.addons.delete(id) : st.addons.add(id);
    b.setAttribute('aria-pressed', String(st.addons.has(id)));
    update();
  }));
</script>
