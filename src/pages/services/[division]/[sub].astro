---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import BeforeAfter from '../../../components/BeforeAfter.astro';
import Extras from '../../../components/Extras.astro';
import { Image } from 'astro:assets';
import { DIVISIONS, PHONE, PHONE_TEL, FIRST_TIME_DISCOUNT, subMin, isQuoteSub, subFreqs, subAddons, ADDON_IMAGES, type Division, type Sub } from '../../../data/services';

export function getStaticPaths() {
  return DIVISIONS.flatMap((d) => d.subs.map((s) => ({ params: { division: d.id, sub: s.slug }, props: { d, s } })));
}
const { d, s } = Astro.props as { d: Division; s: Sub };
const from = subMin(s);
const quote = isQuoteSub(s);
const firstOff = !quote && d.segment === 'residential' ? Math.round(FIRST_TIME_DISCOUNT * 100) : 0;
const cta = quote ? 'Get a free quote' : 'Book now';
const others = d.subs.filter((x) => x.slug !== s.slug);
// choices (size, add-ons, how often) are made in booking, one step at a time — this page only informs
const bookUrl = `/book?d=${d.id}&s=${s.slug}`;
const recurringFreqs = subFreqs(d, s).filter((f) => f.id !== 'onetime' && f.discount > 0);
const monthly = subFreqs(d, s).some((f) => f.id === 'monthly');
const junk = d.id === 'junk-removal';
const addons = [...subAddons(d, s)].sort((a, b) => Number(!junk && !!ADDON_IMAGES[b.id]) - Number(!junk && !!ADDON_IMAGES[a.id])); // photo cards first
const commercial = d.segment === 'commercial';
const tax = commercial ? ' + tax' : '';
const $ = (n: number) => '$' + n.toLocaleString('en-CA');
const priceText = from != null ? `${quote || s.tiers.length > 1 ? 'from ' : ''}${$(from)}${tax}` : 'Free quote';
---
<Base title={`${s.name} in Coquitlam & Port Coquitlam`} description={`${s.name} by LIVO in Coquitlam, Port Coquitlam and Port Moody. ${s.short} ${quote ? (from ? `From $${from}, final price after photos.` : 'Free quote, usually the same day.') : `Instant price from $${from}.`} Pay after the job.`} tabBar={false}>

  <!-- HERO -->
  <section class="px-3 md:px-6 pt-1 md:pt-6">
    <div class="on-dark relative mx-auto max-w-6xl overflow-hidden rounded-[28px] h-72 md:h-[420px] bg-purple-ink">
      <Image src={s.image} alt={`${s.name} by LIVO`} class="kenburns absolute inset-0 size-full object-cover" widths={[480, 900, 1400]} sizes="(min-width:1152px) 1152px, 100vw" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-purple-ink/95 via-purple-ink/35 to-transparent"></div>
      <a href={d.subs.length > 1 ? `/services/${d.id}` : '/services'} class="press absolute top-3 left-3 h-11 pl-3 pr-4 rounded-full bg-white/90 backdrop-blur inline-flex items-center gap-1.5 text-[13px] font-semibold text-ink" aria-label={d.subs.length > 1 ? `Back to ${d.name}` : 'Back to all services'}><Icon name="back" class="size-4" />{d.subs.length > 1 ? d.short : 'Services'}</a>
      <div class="absolute bottom-0 inset-x-0 p-6 md:p-12">
        <h1 class="rise text-white text-[1.9rem] md:text-5xl font-extrabold leading-tight" style="--i:0">{s.name}</h1>
        <p class="rise mt-1.5 text-white/85 text-[15px]" style="--i:1">{s.short}</p>
        <div class="rise mt-3 inline-flex items-center gap-2 rounded-full bg-lime text-ink px-3.5 py-1.5 text-[13px] font-bold" style="--i:2">
          {from ? <>From {$(from)}{tax} <span class="font-medium">· {s.unit}</span></> : 'Free quote'}
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 md:px-6 md:grid md:grid-cols-[1fr_360px] md:gap-12">
    <div>
      <!-- INTRO -->
      <p class="mt-7 text-[15.5px] leading-relaxed text-ink/85">{s.desc}</p>

      <!-- PRICES (information only; size is picked in booking) -->
      <section class="mt-8" id="prices">
        <div class="flex items-end justify-between">
          <h2 class="text-xl font-extrabold">{quote && from == null ? 'Get a free quote' : quote ? 'Starting prices' : 'Prices'}</h2>
          {s.draft && <span class="text-[11px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 px-2 py-1 rounded-full">Draft prices</span>}
        </div>
        <p class="text-sm text-muted mt-0.5">{quote && from == null ? 'Free, no-obligation. Send photos, or ask for a free site visit.' : quote ? `Starting prices${commercial ? ', before tax' : ''}. Send photos and we confirm the final price.` : junk ? 'Loading and disposal included.' : `By ${s.tierLabel.toLowerCase()}. Supplies included.`}</p>
        <ul class="mt-4 card divide-y divide-line overflow-hidden">
          {s.tiers.map((t) => (
            <li class="flex items-center gap-4 px-4 py-3.5">
              <span class="flex-1 min-w-0">
                <span class="block font-semibold text-[15px]">{t.name} {t.popular && <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider bg-lime text-ink px-1.5 py-0.5 rounded">Popular</span>}</span>
                <span class="block text-[13px] text-muted">{t.sub}</span>
              </span>
              <span class="font-heading font-extrabold text-lg text-right">{t.price != null ? <>{quote && <span class="block text-[10.5px] font-sans font-medium text-muted leading-none">from</span>}{$(t.price)}</> : <span class="text-sm text-purple">{from == null ? 'Free' : 'Quote'}</span>}</span>
            </li>
          ))}
        </ul>
        {!quote && recurringFreqs.length > 0 && (
          <div class="mt-3 rounded-panel bg-lime-soft border border-lime/40 p-4 flex gap-3">
            <span class="shrink-0 size-10 rounded-full bg-white text-lime-ink grid place-items-center" aria-hidden="true"><Icon name="calendar" class="size-5" /></span>
            <div>
              <div class="font-heading font-bold text-[15px]">Save with a regular schedule</div>
              <div class="mt-1.5 flex flex-wrap gap-1.5">
                {recurringFreqs.map((f) => <span class="rounded-full bg-white px-2.5 py-1 text-[12.5px] font-semibold">{f.name} <span class="text-lime-ink">−{Math.round(f.discount * 100)}%</span></span>)}
                {monthly && <span class="rounded-full bg-white px-2.5 py-1 text-[12.5px] font-semibold">Monthly <span class="text-muted font-medium">regular price</span></span>}
              </div>
              <p class="mt-1.5 text-[12.5px] text-ink/70">Choose how often when you book. Savings start from your 2nd visit.</p>
            </div>
          </div>
        )}
        {s.priceNote && <p class="mt-3 text-[13px] text-muted">{s.priceNote}</p>}
        {s.quoteNote && <p class="mt-3 text-[13px] text-muted flex gap-2"><Icon name="camera" class="size-4 shrink-0 mt-0.5 text-purple" />{s.quoteNote}</p>}
        {quote && (
          <ol class="mt-5 grid grid-cols-3 gap-2 text-center">
            {[['camera', 'Send photos'], ['clock', 'Quote, usually same day'], ['calendar', 'Pick your date']].map(([ic, t], i) => (
              <li class="rounded-panel bg-cloud p-3"><span class="mx-auto size-9 rounded-full bg-white text-purple grid place-items-center shadow-soft" aria-hidden="true"><Icon name={ic} class="size-[18px]" /></span><span class="block mt-2 text-[12.5px] font-semibold leading-snug"><span class="sr-only">Step {i + 1}: </span>{t}</span></li>
            ))}
          </ol>
        )}
      </section>

      <!-- ADD-ONS (information; added in booking) -->
      {addons.length > 0 && <section class="mt-10">
        <h2 class="text-xl font-extrabold">Add-ons</h2>
        <p class="text-sm text-muted mt-0.5">Add any of these when you book.</p>
        <ul tabindex="0" aria-label="Add-ons, scroll sideways for more" class="mt-4 flex gap-3 overflow-x-auto no-scrollbar -mx-4 px-4 md:mx-0 md:px-0 md:grid md:grid-cols-3 rounded-panel">
          {addons.map((a) => (
            <li class="relative overflow-hidden shrink-0 w-40 md:w-auto rounded-panel bg-cloud p-4">
              {!junk && ADDON_IMAGES[a.id] && <Image src={ADDON_IMAGES[a.id]} alt="" class="-mx-4 -mt-4 mb-3 w-[calc(100%+2rem)] max-w-none aspect-[16/9] object-cover" widths={[240, 400]} sizes="(min-width:768px) 260px, 160px" />}
              <span class="block font-semibold text-[14px] leading-snug">{a.name}</span>
              <span class="block text-[12px] text-muted">{a.sub}</span>
              <span class="block mt-2 text-sm"><b>+${a.price}</b> <span class="text-muted text-[11px]">{a.unit}</span></span>
            </li>
          ))}
        </ul>
      </section>}

      <!-- INCLUDED / NOT INCLUDED -->
      <section class="mt-10 grid md:grid-cols-[1.35fr_1fr] gap-3" aria-label="What is and is not included">
        <div class="on-dark relative overflow-hidden rounded-[24px] bg-purple-ink text-white p-6 md:p-7">
          <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-purple/40 blur-2xl"></div>
          <div class="relative">
            <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-lime">{quote ? 'In every job' : 'In every visit'}</div>
            <h2 class="mt-1 text-2xl font-extrabold text-white">What's included</h2>
            <ul class="mt-5 space-y-3">
              {s.included.map((i) => (
                <li class="flex gap-3 text-[14.5px] text-white/90"><span class="shrink-0 size-6 rounded-full bg-lime text-ink grid place-items-center" aria-hidden="true"><Icon name="check" class="size-3.5" stroke={3} /></span>{i}</li>
              ))}
            </ul>
          </div>
        </div>
        <div class="rounded-[24px] bg-cloud p-6 md:p-7">
          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-muted">Good to know</div>
          <h2 class="mt-1 text-2xl font-extrabold">Not included</h2>
          <ul class="mt-5 space-y-3">
            {d.notIncluded.map((x) => (
              <li class="flex gap-3 text-[14.5px] text-ink/80"><span class="shrink-0 size-6 rounded-full bg-white border border-line text-muted grid place-items-center" aria-hidden="true"><Icon name="x" class="size-3.5" stroke={2.6} /></span>{x}</li>
            ))}
          </ul>
          <p class="mt-5 text-[13px] text-muted">Not sure? Call <a href={`tel:${PHONE_TEL}`} class="font-semibold text-ink underline">{PHONE}</a>.</p>
        </div>
      </section>

      {s.before && s.after && (
        <section class="mt-10">
          <h2 class="text-xl font-extrabold">Before & after</h2>
          <BeforeAfter before={s.before} after={s.after} alt={s.name} class="mt-4" />
        </section>
      )}

      <Extras d={d} skip={s.slug} hideNotIncluded />

      <!-- FAQ -->
      <section class="mt-10">
        <h2 class="text-xl font-extrabold">Questions</h2>
        <div class="mt-2 divide-y divide-line border-y border-line">
          {d.faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-[15px] min-h-11">{f.q}<Icon name="plus" class="size-5 shrink-0 text-muted transition duration-300 group-open:rotate-45 group-open:text-purple" /></summary>
              <p class="mt-2 text-sm text-muted leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- MORE -->
      {others.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-extrabold">More {d.short.toLowerCase()} services</h2>
          <div class="mt-4 flex gap-3 overflow-x-auto no-scrollbar -mx-4 px-4 md:mx-0 md:px-0 snap-x">
            {others.map((o) => (
              <a href={`/services/${d.id}/${o.slug}`} class="snap-start shrink-0 w-56 card overflow-hidden">
                <div class="aspect-[16/10] bg-cloud overflow-hidden"><Image src={o.image} alt="" class="size-full object-cover" widths={[320, 480]} sizes="224px" /></div>
                <div class="p-3.5"><div class="font-heading font-bold text-[14px]">{o.name}</div><div class="text-[12.5px] text-muted">{subMin(o) ? `From ${$(subMin(o)!)}${tax}` : 'Free quote'}</div></div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- DESKTOP BOOKING CARD -->
    <aside class="hidden md:block">
      <div class="sticky top-24 mt-8 card p-6">
        <div class="text-sm text-muted">{quote ? (from ? 'Estimate' : 'Price') : 'Price'}</div>
        <div class="font-heading font-extrabold text-4xl mt-1">{priceText}</div>
        <div class="text-sm text-muted">{s.unit}</div>
        <a href={bookUrl} class="sheen btn-lime w-full mt-5">{cta}</a>
        <a href={`tel:${PHONE_TEL}`} class="btn-ghost w-full mt-2 text-ink"><Icon name="phone" class="size-4" />{PHONE}</a>
        <ul class="mt-5 space-y-2 text-[13px] text-muted">
          <li class="flex gap-2"><Icon name="check" class="size-4 text-lime-ink" stroke={2.5} />Pay after the job</li>
          {firstOff > 0 && <li class="flex gap-2"><Icon name="check" class="size-4 text-lime-ink" stroke={2.5} />{firstOff}% off your first booking</li>}
          {quote && <li class="flex gap-2"><Icon name="check" class="size-4 text-lime-ink" stroke={2.5} />Free quote, no obligation</li>}
          <li class="flex gap-2"><Icon name="check" class="size-4 text-lime-ink" stroke={2.5} />Uniformed LIVO crew</li>
        </ul>
      </div>
    </aside>
  </div>

  <!-- MOBILE STICKY BOOK BAR -->
  <div slot="after" style="view-transition-name: tab-bar" class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/92 backdrop-blur-xl border-t border-line pb-safe">
    <div class="flex items-center gap-3 px-4 h-[76px]">
      <div class="flex-1 min-w-0">
        <div class={`font-heading font-extrabold leading-none whitespace-nowrap ${tax ? 'text-[17px]' : 'text-xl'}`}>{priceText}</div>
        <div class="text-[12px] text-muted truncate mt-1">{s.unit}</div>
      </div>
      <a href={`tel:${PHONE_TEL}`} aria-label={`Call ${PHONE}`} class="press size-12 rounded-full bg-cloud grid place-items-center"><Icon name="phone" class="size-5" /></a>
      <a href={bookUrl} class="sheen btn-lime px-7">{quote ? 'Get quote' : 'Book now'}</a>
    </div>
  </div>
  <div class="md:hidden h-24"></div>
</Base>

