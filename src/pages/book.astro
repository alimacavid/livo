---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { DIVISIONS, FIRST_TIME_DISCOUNT, PHONE, PHONE_TEL, isQuoteSub, subFreqs, subAddons, ADDON_IMAGES, PREP } from '../data/services';

// small photos for the add-on cards (junk 'fridge' = disposal, so no cleaning photo there)
const ADDON_SRC: Record<string, string> = {};
for (const [id, img] of Object.entries(ADDON_IMAGES)) ADDON_SRC[id] = (await getImage({ src: img, width: 544, quality: 85, format: 'webp' })).src;
const DIV_SRC: Record<string, string> = {};
for (const d of DIVISIONS) DIV_SRC[d.id] = (await getImage({ src: d.image, width: 1088, quality: 85, format: 'webp' })).src;
const SUB_SRC: Record<string, string> = {};
for (const d of DIVISIONS.filter((d) => d.id === 'commercial-cleaning')) {
  for (const sub of d.subs) SUB_SRC[sub.slug] = (await getImage({ src: sub.image, width: 128, quality: 85, format: 'webp' })).src;
}

// send only plain data to the browser (no images)
const data = DIVISIONS.map((d) => ({
  id: d.id, name: d.name, short: d.short, icon: d.icon, segment: d.segment, img: DIV_SRC[d.id], prep: PREP[d.id] ?? [],
  subs: d.subs.map((s) => ({ slug: s.slug, img: SUB_SRC[s.slug] ?? '', name: s.name, short: s.short, unit: s.unit, tierLabel: s.tierLabel, tiers: s.tiers, quoteNote: s.quoteNote ?? '', fromPrice: s.fromPrice, minOrder: s.minOrder, itemsRequired: !!s.itemsRequired, pos: s.pos ?? '', quote: isQuoteSub(s), freqs: subFreqs(d, s), addons: subAddons(d, s).map(({ line, before, after, ...a }) => ({ ...a, img: d.id !== 'junk-removal' ? ADDON_SRC[a.id] ?? '' : '' })) })),
  times: d.times,
}));
// divisions businesses can ask about (quote-type services only)
const COMMERCIAL_DIVS = ['commercial-cleaning', 'restaurant-kitchen-cleaning', 'construction-cleaning', 'junk-removal'];
---
<Base title="Book a Service or Get a Quote" description="Book house cleaning, move out cleaning, Airbnb cleaning or junk removal online, or send photos for a free commercial cleaning quote. LIVO Property Services, Coquitlam." tabBar={false} footer={false}>
  <script type="application/json" id="livo-data" set:html={JSON.stringify({ divisions: data, commercialDivs: COMMERCIAL_DIVS, firstTime: FIRST_TIME_DISCOUNT, phone: PHONE, tel: PHONE_TEL })} />

  <div id="bk-wrap" class="mx-auto max-w-xl px-4 pt-2 md:pt-6 flex flex-col min-h-[calc(100dvh-66px)]">
    <!-- progress -->
    <div class="flex items-center gap-3" id="bk-top">
      <div class="flex-1">
        <div class="flex justify-between text-[12px] font-semibold text-muted"><span id="bk-stepname">Service</span><span id="bk-count">1 / 6</span></div>
        <div id="bk-prog" role="progressbar" aria-label="Progress" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1" class="mt-1.5 h-1.5 rounded-full bg-cloud overflow-hidden"><div id="bk-bar" class="h-full bg-gradient-to-r from-purple to-[#8B5CC8] rounded-full transition-[width] duration-700 ease-[var(--ease-out-expo)]" style="width:16%"></div></div>
      </div>
    </div>
    <p id="bk-testbar" hidden class="mt-2 self-start text-[11.5px] font-semibold rounded-full bg-amber-50 text-amber-900 border border-amber-200 px-3 py-1">Test version: nothing is sent or charged. Try anything.</p>

    <div id="bk-live" class="sr-only" aria-live="polite"></div>
    <!-- each step is centred in the screen; long steps are split so nothing needs scrolling -->
    <div id="bk-stage" class="flex-1 flex flex-col justify-center py-4 md:py-5">
      <div id="bk-view"></div>
    </div>
    <div class="h-[96px] md:hidden" aria-hidden="true"></div>

  <!-- bottom bar: fixed on phones, right under the step on computers -->
  <div style="view-transition-name: tab-bar" class="fixed bottom-0 inset-x-0 z-50 bg-white/92 backdrop-blur-xl border-t border-line pb-safe md:static md:bg-transparent md:backdrop-blur-none md:border-0 md:pb-6" id="bk-bottom">
    <div class="mx-auto max-w-xl flex items-center gap-3 px-4 h-[80px] md:px-0 md:h-auto md:py-4 md:border-t md:border-line">
      <button id="bk-back" class="press size-12 shrink-0 rounded-full bg-cloud border border-line grid place-items-center disabled:hidden" aria-label="Back to previous step">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      </button>
      <div id="bk-sum" class="flex-1 min-w-0 text-left" aria-live="polite">
        <div class="text-[11.5px] text-muted font-medium" id="bk-totlabel">Total</div>
        <div class="flex items-baseline gap-2">
          <span id="bk-total" class="font-heading font-extrabold text-2xl leading-none">$0</span>
          <span id="bk-was" class="text-sm text-muted line-through"></span>
        </div>
      </div>
      <button id="bk-next" class="sheen btn-lime px-8 disabled:opacity-40 disabled:shadow-none disabled:[&::after]:hidden">Continue</button>
    </div>
  </div>
  </div>
</Base>

<style is:global>
  /* every step fits the screen: if it would scroll, the page script adds .bk-tight, then .bk-tighter */
  /* Full-width sub-service rows on phones; card interiors on desktop. */
  @media (max-width: 767px) {
    .bk-subservices { grid-template-columns: minmax(0, 1fr); }
  }
  @media (min-width: 768px) {
    .bk-services [data-sub] { flex-wrap: wrap; gap: .5rem; align-content: start; }
    .bk-services [data-sub] > .flex-1 { flex-basis: calc(100% - 2rem); }
    .bk-services [data-sub] > .text-right { width: 100%; text-align: left; padding-left: 1.75rem; }
  }
  /* Keep incomplete add-on rows centred without changing card widths. */
  .bk-addons { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .bk-addons > * { grid-column: span 2; }
  .bk-addons > :last-child:nth-child(odd) { grid-column: 2 / span 2; }
  @media (min-width: 768px) {
    .bk-addons { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .bk-addons > :last-child:nth-child(odd) { grid-column: span 2; }
    .bk-addons > :last-child:nth-child(3n+1) { grid-column: 3 / span 2; }
    .bk-addons > :nth-last-child(2):nth-child(3n+1) { grid-column: 2 / span 2; }
    .bk-addons > :last-child:nth-child(3n+2) { grid-column: 4 / span 2; }
    .bk-services [data-sub]:has(img) > .flex-1 { flex-basis: calc(100% - 5.5rem); }
  }
  .bk-items .bk-itemprice { flex-wrap: wrap; }
  .bk-items .bk-itemprice > span:first-child { width: 100%; }
  @media (min-width: 768px) {
    #bk-view .bk-items { margin-top: .75rem; }
    .bk-items .bk-addimg { aspect-ratio: 12 / 5; }
  }
  @media (max-height: 720px) {
    #bk-view .bk-items > div:not(:has(img)) { padding-block: .5rem; }
    #bk-view .bk-review { padding: .75rem; margin-top: .5rem; }
    #bk-view .bk-review .mt-4 { margin-top: .5rem; }
    #bk-view .bk-review .pt-4 { padding-top: .5rem; }
  }
  html.bk-fitting #bk-view * { transition: none !important; }
  html.bk-tight #bk-view h1 { font-size: 1.35rem; }
  html.bk-tight #bk-view h1 + p { font-size: 13px; }
  html.bk-tight #bk-view .mt-5 { margin-top: .75rem; }
  html.bk-tight #bk-view [data-tier], html.bk-tight #bk-view [data-sub], html.bk-tight #bk-view [data-time] { padding-top: .5rem; padding-bottom: .5rem; }
  html.bk-tight #bk-view [data-date] { height: 2.4rem; }
  html.bk-tight #bk-view input:not([type=file]) { height: 2.75rem; }
  html.bk-tight #bk-view textarea { height: 4.5rem; }
  html.bk-tight #bk-view .bk-addimg { aspect-ratio: 16 / 9; }
  html.bk-tight #bk-wrap { padding-top: .5rem; }
  html.bk-tight #bk-stage { padding-top: .5rem; padding-bottom: .5rem; }
  html.bk-tight #bk-testbar { margin-top: .25rem; padding-top: 2px; padding-bottom: 2px; }
  @media (min-width: 768px) {
    html.bk-tight #bk-bottom { padding-bottom: .5rem; }
    html.bk-tight #bk-bottom > div { padding-top: .6rem; padding-bottom: .25rem; }
  }
  html.bk-tighter #bk-view h1 + p { display: none; }
  html.bk-tightest #bk-view .bk-x, html.bk-tightest #bk-testbar { display: none !important; }
  html.bk-tightest #bk-view .mt-5, html.bk-tightest #bk-view .mt-4 { margin-top: .5rem; }
  html.bk-tightest #bk-view .p-5, html.bk-tightest #bk-view .p-4 { padding: .75rem; }
  html.bk-tightest #bk-view .pt-4 { padding-top: .5rem; }
  html.bk-tightest #bk-view .bk-addimg, html.bk-tightest #bk-view .bk-addphoto { display: none; }
  html.bk-tightest #bk-view .bk-addcopy:has(.bk-addqty) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 4px; }
  html.bk-tightest #bk-view .bk-addcopy:has(.bk-addqty) > :first-child { grid-column: 1 / -1; }
  html.bk-tightest #bk-view .bk-addqty { margin-top: 0; padding: 0; box-shadow: none; }
  html.bk-tightest #bk-view .bk-addcopy:has(.bk-addqty) .bk-addprice .text-muted { display: none; }
  html.bk-tighter #bk-view .mt-3 { margin-top: .4rem; }
  html.bk-tighter #bk-view textarea { height: 3rem; }
  html.bk-tighter #bk-view input:not([type=file]) { height: 2.5rem; }
  html.bk-tighter #bk-view h1 { font-size: 1.2rem; }
  html.bk-tighter #bk-view .bk-addimg { aspect-ratio: 5 / 2; }
  html.bk-tighter #bk-view [data-tier], html.bk-tighter #bk-view [data-sub], html.bk-tighter #bk-view [data-time] { padding-top: .35rem; padding-bottom: .35rem; }
  html.bk-tighter #bk-view [data-date] { height: 2.1rem; }
</style>

<script>
  import { TEST, sendRequest, signedIn, getProfile, normPhone, type Profile, type Place } from '../lib/api';

  type Tier = { id: string; name: string; sub?: string; price: number | null; popular?: boolean };
  type Addon = { id: string; name: string; sub: string; price: number; unit: string; qty?: boolean; img?: string };
  type Freq = { id: string; name: string; sub: string; discount: number };
  type SubD = { slug: string; img?: string; name: string; short: string; unit: string; tierLabel: string; tiers: Tier[]; quoteNote: string; fromPrice?: number; minOrder?: number; itemsRequired: boolean; pos?: string; quote: boolean; freqs: Freq[]; addons: Addon[] };
  type Seg = 'residential' | 'commercial';
  type Div = { id: string; name: string; short: string; icon: string; segment: Seg; subs: SubD[]; times: { id: string; sub: string }[] };

  const D = JSON.parse(document.getElementById('livo-data')!.textContent!) as { divisions: Div[]; commercialDivs: string[]; firstTime: number; phone: string; tel: string };
  const FT = Math.round(D.firstTime * 100);
  const MAX_PHOTOS = 10;

  const ALL_STEPS = ['service', 'size', 'addons', 'photos', 'freq', 'date', 'time', 'contact', 'address', 'review'] as const;
  type Step = (typeof ALL_STEPS)[number];

  const q = new URLSearchParams(location.search);
  const qDiv = D.divisions.find((d) => d.id === q.get('d'));
  const st = {
    step: 'service' as Step | 'done',
    seg: (q.get('seg') === 'commercial' || (!q.get('seg') && qDiv?.segment === 'commercial') ? 'commercial' : 'residential') as Seg,
    forBusiness: false,
    div: qDiv?.id ?? '',
    sub: q.get('s') ?? '',
    tier: q.get('t') ?? '',
    addons: {} as Record<string, number>,
    freq: 'onetime',
    date: '',
    time: '',
    month: (() => { const n = new Date(); return { y: n.getFullYear(), m: n.getMonth() }; })(),
    firstTime: true,
    photos: [] as { file: File; url: string }[],
    c: { name: '', phone: '', email: '', business: '', address: '', access: '', description: '', notes: '' },
    save: true,
    placeId: q.get('place') ?? '',
    profile: null as Profile | null,
    sending: false,
    progress: '',
  };
  const divsFor = (seg: Seg) => seg === 'residential' ? D.divisions.filter((d) => d.segment === 'residential') : D.commercialDivs.map((id) => D.divisions.find((d) => d.id === id)!);
  const subsFor = (d: Div) => st.seg === 'commercial' ? d.subs.filter((s) => s.quote) : d.subs;
  if (!st.div || !divsFor(st.seg).some((d) => d.id === st.div)) st.div = divsFor(st.seg)[0].id;
  const div = () => D.divisions.find((d) => d.id === st.div)!;
  const sub = () => subsFor(div()).find((s) => s.slug === st.sub);
  const tier = () => sub()?.tiers.find((t) => t.id === st.tier);
  // add-ons and "how often" options belong to the chosen service (e.g. Deep Cleaning is one-time only)
  const addons = (): Addon[] => sub()?.addons ?? [];
  const freqs = (): Freq[] => sub()?.freqs ?? [{ id: 'onetime', name: 'One-Time', sub: 'Single visit', discount: 0 }];
  const freq = () => freqs().find((f) => f.id === st.freq) ?? freqs()[0];
  const isQuote = () => !!sub()?.quote || (tier() != null && tier()!.price == null);
  const segment = (): Seg => (div().segment === 'commercial' || st.seg === 'commercial' || st.forBusiness ? 'commercial' : 'residential');
  const discountOK = () => D.firstTime > 0 && !isQuote() && segment() === 'residential';
  const steps = () => ALL_STEPS.filter((x) =>
    (x !== 'addons' || (!isQuote() && addons().length > 0)) &&
    (x !== 'photos' || isQuote()) &&
    (x !== 'freq' || freqs().length > 1));
  const NAMES: Record<string, string> = { service: 'Service', size: 'Size', addons: 'Add-ons', photos: 'Photos & details', freq: 'How often', date: 'Date', time: 'Time', contact: 'Your details', address: 'Address', review: 'Review' };
  const stepName = (x: Step) => x === 'size' && isQuote() && sub()?.tiers.every((t) => t.price == null) ? 'How to quote' : x === 'date' && isQuote() ? 'Preferred date' : NAMES[x];

  if (!sub()) st.sub = '';
  if (st.seg === 'commercial') st.forBusiness = true;
  (q.get('a') ?? '').split(',').forEach((entry) => {
    const [id, raw = '1'] = entry.split(':');
    const a = addons().find((a) => a.id === id);
    const n = Number(raw);
    if (a && Number.isSafeInteger(n) && n > 0) st.addons[id] = a.qty ? n : 1;
  });
  if (sub() && !tier()) st.tier = (sub()!.tiers.find((t) => t.popular) ?? sub()!.tiers[0]).id;
  if (sub()) st.freq = freq().id;
  if (st.sub) st.step = sub()?.itemsRequired && Object.keys(st.addons).length ? 'addons' : 'size'; // Item links keep selections and open the items step; other links start at size.
  // back from sign-in: restore everything the customer already picked and continue at "Your details"
  const RESUME = 'livo-book-resume'; let resumed = false;
  if (q.get('resume')) {
    try {
      const saved = JSON.parse(sessionStorage.getItem(RESUME) ?? 'null');
      if (saved) {
        for (const k of ['seg', 'forBusiness', 'div', 'sub', 'tier', 'addons', 'freq', 'date', 'time', 'month', 'firstTime', 'save', 'placeId']) if (k in saved) (st as any)[k] = saved[k];
        Object.assign(st.c, saved.c ?? {});
        st.step = 'contact'; resumed = true;
      }
    } catch { /* storage blocked: start normally */ }
    sessionStorage.removeItem(RESUME);
    history.replaceState(null, '', st.sub ? `/book?d=${st.div}&s=${st.sub}` : '/book');
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-signin]')) return;
    try { const { photos, profile, sending, progress, step, ...keep } = st; sessionStorage.setItem(RESUME, JSON.stringify(keep)); } catch { /* ignore */ }
  });

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (n: number) => '$' + Math.round(n).toLocaleString('en-CA');

  function totals() {
    const base = tier()?.price ?? 0;
    const add = isQuote() ? 0 : addons().reduce((s, a) => s + (st.addons[a.id] ?? 0) * a.price, 0);
    // first visit = regular price; recurring discount starts on the 2nd visit and applies to the service only, not add-ons
    const sub = base + add;
    const repeat = Math.round(base * (1 - freq().discount) + add);
    const total = discountOK() && st.firstTime ? sub * (1 - D.firstTime) : sub;
    return { base, add, sub: Math.round(sub), total: Math.round(total), repeat };
  }

  const ic = (p: string, c = 'size-5') => `<svg aria-hidden="true" viewBox="0 0 24 24" class="${c}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
  const CHECK = '<path d="m5 12.5 4.5 4.5L19 7.5"/>';
  const radio = (on: boolean) => `<span aria-hidden="true" class="size-5 shrink-0 rounded-full border-2 grid place-items-center ${on ? 'border-purple' : 'border-gray'}"><span class="size-2.5 rounded-full bg-purple transition duration-300 ease-[var(--ease-spring)] ${on ? 'scale-100' : 'scale-0'}"></span></span>`;
  const optCls = (on: boolean) => `press w-full text-left flex items-center gap-4 px-4 py-3 rounded-[18px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft/60' : 'border-line bg-white hover:border-gray'}" aria-pressed="${on}`;
  const h1 = (t: string, s = '') => `<h1 tabindex="-1" class="outline-none text-[1.65rem] md:text-3xl font-extrabold leading-tight">${t}</h1>${s ? `<p class="mt-1 text-muted text-[15px]">${s}</p>` : ''}`;
  const segTabs = (cur: Seg, attr: string, labels: [string, string]) => `<div role="group" aria-label="Customer type" class="grid grid-cols-2 p-1 rounded-full bg-cloud">
      ${(['residential', 'commercial'] as Seg[]).map((s, i) => `<button ${attr}="${s}" aria-pressed="${cur === s}" class="press h-11 rounded-full text-[14px] font-heading font-bold transition-colors ${cur === s ? 'bg-white shadow-soft text-purple' : 'text-muted'}">${labels[i]}</button>`).join('')}
    </div>`;

  // step 1: pick a service area (photo cards, no sideways scrolling); areas with several services show them next
  let pickedDiv = !!(q.get('d') && !q.get('s'));
  function vService() {
    const d = div();
    if (pickedDiv && subsFor(d).length > 1) {
      return `<button data-alldivs class="press -mt-1 mb-3 inline-flex items-center gap-1.5 rounded-full bg-cloud px-3.5 h-10 text-[13px] font-semibold">${ic('<path d="M19 12H5M11 6l-6 6 6 6"/>', 'size-4')}All services</button>
        ${h1(d.name, 'Which one do you need?')}
        <div class="mt-5 service-card-grid bk-services bk-subservices gap-2.5" data-count="${subsFor(d).length}">
          ${subsFor(d).map((s) => {
            const p = s.tiers.map((t) => t.price).filter((x) => x != null) as number[];
            return `<button data-sub="${s.slug}" class="${optCls(st.sub === s.slug)}">${radio(st.sub === s.slug)}
              ${s.img ? `<img src="${s.img}" alt="" class="size-12 shrink-0 rounded-lg object-cover ${s.pos ?? ''}" />` : ''}
              <span class="flex-1 min-w-0"><span class="block font-semibold text-[15px]">${s.name}</span><span class="bk-x block text-[13px] text-muted leading-snug">${s.short}</span></span>
              <span class="text-right shrink-0">${p.length ? `<span class="block text-[11px] text-muted">from</span><span class="font-heading font-extrabold">${money(Math.min(...p))}</span>${d.segment === 'commercial' ? '<span class="block text-[10.5px] text-muted">+ tax</span>' : ''}` : `<span class="text-[13px] font-semibold text-purple">Free quote</span>`}</span></button>`;
          }).join('')}
        </div>`;
    }
    return `${h1(st.seg === 'residential' ? 'What do you need?' : 'What does your business need?', st.seg === 'residential' ? 'Pick a service.' : 'Pick a service. Free quote, usually the same day.')}
      <div class="mt-4">${segTabs(st.seg, 'data-seg', ['Home', 'Business'])}</div>
      <div class="mt-4 service-card-grid bk-services gap-2.5" data-count="${divsFor(st.seg).length}" role="group" aria-label="Services">
        ${divsFor(st.seg).map((x) => {
          const ps = subsFor(x).flatMap((s) => s.fromPrice != null ? [s.fromPrice] : s.tiers.map((t) => t.price)).filter((v) => v != null) as number[];
          const name = x.id === 'junk-removal' && st.seg === 'commercial' ? 'Junk & Debris' : x.name.replace(' Cleaning', '');
          return `<button data-div="${x.id}" class="press relative overflow-hidden rounded-[18px] bg-cloud text-left border-2 border-transparent hover:border-line">
            <img src="${x.img}" alt="" class="bk-addimg w-full aspect-[16/10] object-cover bg-line ${subsFor(x).find((s) => s.pos)?.pos ?? ''}" />
            <span class="block px-3 py-2"><span class="block font-semibold text-[13.5px] leading-tight">${name}</span><span class="block text-[12px] text-muted">${ps.length ? `from ${money(Math.min(...ps))}${x.segment === 'commercial' ? ' + tax' : ''}` : 'Free quote'}</span></span>
          </button>`;
        }).join('')}
      </div>`;
  }

  function vSize() {
    const s = sub()!; const allQuote = s.tiers.every((t) => t.price == null);
    return `${h1(allQuote ? 'How should we quote?' : s.tierLabel, s.name)}
      <div class="mt-5 grid gap-2.5">
        ${s.tiers.map((t) => `<button data-tier="${t.id}" class="${optCls(st.tier === t.id)}">${radio(st.tier === t.id)}
          <span class="flex-1"><span class="block font-semibold text-[15px]">${t.name}${t.popular ? ' <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider bg-lime text-ink px-1.5 py-0.5 rounded">Popular</span>' : ''}</span><span class="bk-x block text-[13px] text-muted">${t.sub ?? ''}</span></span>
          <span class="font-heading font-extrabold text-lg text-right">${t.price != null ? `${s.quote ? '<span class="block text-[10.5px] font-sans font-medium text-muted leading-none">from</span>' : ''}${money(t.price)}` : `<span class="text-sm text-purple">${allQuote ? 'Free' : 'Quote'}</span>`}</span></button>`).join('')}
      </div>
      ${s.quoteNote ? `<p class="mt-4 text-[13px] text-muted">${s.quoteNote}</p>` : ''}`;
  }

  function vAddons() {
    return `${h1(sub()?.itemsRequired ? 'Pick your items' : 'Add anything else?', sub()?.itemsRequired ? 'Choose at least one. One visit fee per order.' : 'Optional. Tap to add.')}
      <div class="mt-5 bk-addons gap-2 ${sub()?.itemsRequired ? 'bk-items' : ''}">
        ${addons().map((a) => {
          const n = st.addons[a.id] ?? 0; const on = n > 0;
          if (a.img) return `<div class="press relative h-full flex flex-col overflow-hidden rounded-[18px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft' : 'border-transparent bg-cloud hover:border-line'}">
            <button data-add="${a.id}" class="absolute inset-0 z-10 rounded-[18px]" aria-pressed="${on}" aria-label="${a.name} (${a.sub}), plus ${money(a.price)} ${a.unit}"></button>
            <div class="relative bk-addphoto">
              <img src="${a.img}" alt="" class="bk-addimg w-full aspect-[4/3] object-cover bg-line" />
              <span aria-hidden="true" class="absolute top-2 right-2 size-8 rounded-full grid place-items-center shadow-md transition duration-300 ${on ? 'bg-purple text-white rotate-[360deg]' : 'bg-white text-ink'}">${ic(on ? CHECK : '<path d="M12 5v14M5 12h14"/>', 'size-4')}</span>

            </div>
            <div class="bk-addcopy px-3 py-2 flex flex-col">
              <div class="font-semibold text-[13.5px] leading-tight truncate">${a.name}</div>
              <div class="bk-addprice text-[12.5px] truncate"><b>+${money(a.price)}</b> <span class="text-muted text-[11px]">${a.unit}</span></div>
              ${a.qty && on ? `<span class="bk-addqty relative z-20 mt-1 self-end flex items-center gap-1 rounded-full bg-white/95 shadow-md p-1">
                <button data-dec="${a.id}" class="press size-9 rounded-full bg-cloud grid place-items-center" aria-label="One less ${a.name}">${ic('<path d="M5 12h14"/>', 'size-4')}</button>
                <span class="w-4 text-center font-bold text-sm" aria-live="polite">${n}</span>
                <button data-inc="${a.id}" class="press size-9 rounded-full bg-cloud grid place-items-center" aria-label="One more ${a.name}">${ic('<path d="M12 5v14M5 12h14"/>', 'size-4')}</button></span>` : ''}
            </div>
          </div>`;
          return `<div class="press relative px-3.5 py-3 rounded-[16px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft/60' : 'border-line bg-white hover:border-gray'}">
            <button data-add="${a.id}" class="absolute inset-0 rounded-[16px]" aria-pressed="${on}" aria-label="${a.name} (${a.sub}), plus ${money(a.price)} ${a.unit}"></button>
            <div class="flex items-start justify-between gap-2">
              <span class="font-semibold text-[13.5px] leading-tight">${a.name}</span>
              <span aria-hidden="true" class="size-6 shrink-0 rounded-full grid place-items-center transition duration-300 ${on ? 'bg-purple text-white rotate-[360deg]' : 'bg-cloud text-muted'}">${ic(on ? CHECK : '<path d="M12 5v14M5 12h14"/>', 'size-3.5')}</span>
            </div>
            <div class="bk-itemprice mt-1 flex items-center justify-between gap-1">
              <span class="text-[12.5px]"><b>+${money(a.price)}</b> <span class="text-muted text-[11px]">${a.unit}</span></span>
              ${a.qty && on ? `<span class="relative flex items-center gap-1">
                <button data-dec="${a.id}" class="press size-9 rounded-full bg-white border border-line grid place-items-center" aria-label="One less ${a.name}">${ic('<path d="M5 12h14"/>', 'size-4')}</button>
                <span class="w-5 text-center font-bold text-sm" aria-live="polite">${n}</span>
                <button data-inc="${a.id}" class="press size-9 rounded-full bg-white border border-line grid place-items-center" aria-label="One more ${a.name}">${ic('<path d="M12 5v14M5 12h14"/>', 'size-4')}</button></span>` : ''}
            </div>
          </div>`;
        }).join('')}
      </div>
      <p id="e-items" role="alert" tabindex="-1" class="mt-2 text-sm text-red-700 empty:hidden outline-none"></p>`;
  }

  const needPhotos = () => isQuote() && st.tier !== 'visit';
  const needBusiness = () => segment() === 'commercial';
  function vPhotos() {
    const canBeHome = div().segment === 'residential';
    return `${h1('Show us the job', needPhotos() ? 'Add at least 1 photo. More photos, more accurate quote.' : 'Photos are optional for a site visit, but they help.')}
      ${canBeHome ? `<div class="mt-5"><div class="text-[13px] font-semibold text-ink/80 mb-1.5">This is for a</div>${segTabs(st.forBusiness ? 'commercial' : 'residential', 'data-for', ['Home', 'Business'])}</div>` : ''}
      <div class="mt-5">
        <div class="flex items-baseline justify-between"><span id="ph-label" class="text-[13px] font-semibold text-ink/80">Photos ${needPhotos() ? '' : '<span class="font-normal text-muted">(optional)</span>'}</span><span class="text-[12px] text-muted">${st.photos.length} / ${MAX_PHOTOS}</span></div>
        <div class="mt-2 grid grid-cols-4 md:grid-cols-5 gap-2" role="list" aria-labelledby="ph-label">
          ${st.photos.map((p, i) => `<div role="listitem" class="relative aspect-square rounded-[12px] overflow-hidden bg-cloud">
              <img src="${p.url}" alt="Photo ${i + 1}" class="size-full object-cover" />
              <button data-rmphoto="${i}" class="press absolute top-1 right-1 size-9 rounded-full bg-white/90 grid place-items-center" aria-label="Remove photo ${i + 1}">${ic('<path d="M6 6l12 12M18 6 6 18"/>', 'size-4')}</button>
            </div>`).join('')}
          ${st.photos.length < MAX_PHOTOS ? `<div role="listitem"><label class="press size-full aspect-square rounded-[12px] border-2 border-dashed border-gray hover:border-purple grid place-items-center text-center cursor-pointer transition-colors">
              <input id="ph-input" type="file" accept="image/*" multiple class="sr-only" aria-describedby="e-photos" />
              <span class="text-purple">${ic('<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>', 'size-6 mx-auto')}<span class="block mt-1 text-[12px] font-semibold">Add photos</span></span>
            </label></div>` : ''}
        </div>
        <p id="e-photos" class="mt-1 text-[13px] text-red-700 empty:hidden"></p>
      </div>
      ${needBusiness() ? fld('business', 'Business name', 'text', 'organization', '', true) : ''}
      <div class="mt-4"><label for="c-description" class="text-[13px] font-semibold text-ink/80">Tell us about the job <span class="font-normal text-muted">(optional)</span></label>
        <textarea id="c-description" rows="3" placeholder="${needBusiness() ? 'Size of the space, how often, opening hours…' : 'Rooms, how much dust or debris, deadline…'}" class="resize-none mt-1 w-full px-4 py-3 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15">${esc(st.c.description)}</textarea></div>`;
  }

  function vFreq() {
    const t = totals();
    return `${h1('How often?', isQuote() ? 'We include it in your quote.' : 'Regular clients save on every visit.')}
      <div class="mt-5 grid grid-cols-2 gap-2.5">
        ${freqs().map((f) => {
          const on = st.freq === f.id;
          return `<button data-freq="${f.id}" aria-pressed="${on}" class="press text-left p-4 rounded-[20px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft/60' : 'border-line bg-white hover:border-gray'}">
            <div class="flex items-center justify-between gap-2"><span class="font-semibold text-[15px]">${f.name}</span>${f.discount ? `<span class="text-[11px] font-bold bg-lime text-ink px-1.5 py-0.5 rounded">−${Math.round(f.discount * 100)}%</span>` : ''}</div>
            <div class="text-[12.5px] text-muted">${f.sub}</div>
            ${isQuote() ? '' : `<div class="mt-3 font-heading font-extrabold">${money(t.base * (1 - f.discount) + t.add)}<span class="text-[11px] font-sans font-medium text-muted"> /visit${f.discount ? ' from 2nd' : ''}</span></div>`}
          </button>`;
        }).join('')}
      </div>`;
  }

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  function vDate() {
    const { y, m } = st.month;
    const first = new Date(y, m, 1).getDay(); const days = new Date(y, m + 1, 0).getDate();
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const canPrev = new Date(y, m, 1) > today;
    let cells = '';
    for (let i = 0; i < first; i++) cells += '<span></span>';
    for (let dd = 1; dd <= days; dd++) {
      const dt = new Date(y, m, dd); const iso = `${y}-${String(m + 1).padStart(2, '0')}-${String(dd).padStart(2, '0')}`;
      const past = dt <= today; const sel = st.date === iso;
      const lbl = dt.toLocaleDateString('en-CA', { weekday: 'long', month: 'long', day: 'numeric' });
      cells += `<button data-date="${iso}" ${past ? 'disabled' : ''} aria-pressed="${sel}" aria-label="${lbl}${past ? ', unavailable' : ''}" class="h-11 rounded-full text-[14px] font-semibold transition duration-300 ${sel ? 'bg-purple text-white shadow-lift scale-105' : past ? 'text-gray line-through decoration-1' : 'hover:bg-cloud'}">${dd}</button>`;
    }
    return `${h1(isQuote() ? 'Preferred date' : 'Which day?', isQuote() ? 'We confirm the date with you when we send the quote.' : 'Pick a day. Next you choose a time window.')}
      <div class="mt-5 card p-4">
        <div class="flex items-center justify-between mb-3">
          <button data-mon="-1" ${canPrev ? '' : 'disabled'} aria-label="Previous month" class="press size-11 rounded-full bg-cloud grid place-items-center disabled:opacity-30">${ic('<path d="m15 6-6 6 6 6"/>', 'size-4')}</button>
          <span class="font-heading font-bold" aria-live="polite">${MONTHS[m]} ${y}</span>
          <button data-mon="1" aria-label="Next month" class="press size-11 rounded-full bg-cloud grid place-items-center">${ic('<path d="m9 6 6 6-6 6"/>', 'size-4')}</button>
        </div>
        <div aria-hidden="true" class="grid grid-cols-7 text-center text-[11px] font-semibold text-muted mb-1">${['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((x) => `<span>${x}</span>`).join('')}</div>
        <div class="grid grid-cols-7 gap-1" role="group" aria-label="Choose a date">${cells}</div>
      </div>`;
  }

  const niceDate = () => st.date ? new Date(st.date + 'T12:00').toLocaleDateString('en-CA', { weekday: 'long', month: 'long', day: 'numeric' }) : '';
  const TIME_IC: Record<string, string> = {
    rise: '<path d="M12 3v3M5.6 7.6l1.4 1.4M18.4 7.6 17 9M3 15h18M7 15a5 5 0 0 1 10 0M8 19h8"/>',
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
    set: '<path d="M12 9V6M5.6 10.6 7 12M18.4 10.6 17 12M3 16h18M7 16a5 5 0 0 1 10 0M8 20h8"/>',
    moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>',
    day: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  };
  const timeIcon = (id: string, i: number) => /after hours|after closing/i.test(id) ? 'moon' : /closed day/i.test(id) ? 'day' : /before|early|morning/i.test(id) ? 'rise' : /late|afternoon/i.test(id) ? 'set' : i === 0 ? 'rise' : 'sun';
  function vTime() {
    return `${h1(isQuote() ? 'Preferred time' : 'What time works?', '')}
      <button data-back-date class="press -mt-1 inline-flex items-center gap-2 rounded-full bg-purple-soft text-purple px-3.5 py-1.5 text-[13px] font-semibold">${ic('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>', 'size-4')}${niceDate()}<span class="font-medium underline underline-offset-2">change</span></button>
      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="group" aria-label="Time window">
        ${div().times.map((t, i) => { const on = st.time === t.id; return `<button data-time="${t.id}" aria-pressed="${on}" class="press relative text-left flex sm:flex-col sm:items-start items-center gap-3 sm:gap-2 p-4 rounded-[20px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft' : 'border-line bg-white hover:border-gray'}">
          <span class="size-11 shrink-0 rounded-full grid place-items-center ${on ? 'bg-purple text-white' : 'bg-lime-soft text-lime-ink'}">${ic(TIME_IC[timeIcon(t.id, i)], 'size-[22px]')}</span>
          <span class="flex-1"><span class="block font-heading font-bold text-[16px]">${t.id}</span><span class="block text-[13px] text-muted">${t.sub}</span></span>
          <span aria-hidden="true" class="sm:absolute sm:top-3 sm:right-3 size-5 rounded-full grid place-items-center ${on ? 'bg-purple text-white' : 'border-2 border-gray'}">${on ? ic(CHECK, 'size-3') : ''}</span>
        </button>`; }).join('')}
      </div>
      <p class="mt-4 text-[13px] text-muted">${isQuote() ? 'We confirm the exact time with your quote.' : 'Your crew arrives inside this window. We text you when they are on the way.'}</p>`;
  }


  function fld(id: string, label: string, type = 'text', ac = '', im = '', req = true, hint = '') {
    return `<div class="mt-3 first:mt-0"><label for="c-${id}" class="text-[13px] font-semibold text-ink/80">${label}${req ? '' : ' <span class="font-normal text-muted">(optional)</span>'}</label>
        ${hint ? `<p id="h-${id}" class="text-[12px] text-muted">${hint}</p>` : ''}
        <input id="c-${id}" name="${id}" type="${type}" ${req ? 'required aria-required="true"' : ''} aria-describedby="e-${id}${hint ? ` h-${id}` : ''}" ${ac ? `autocomplete="${ac}"` : ''} ${im ? `inputmode="${im}"` : ''} value="${esc((st.c as any)[id])}" class="mt-1 w-full h-12 px-4 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15 aria-[invalid=true]:border-red-600 aria-[invalid=true]:ring-red-600/10 transition" />
        <p id="e-${id}" class="mt-1 text-[13px] text-red-700 empty:hidden"></p></div>`;
  }

  const biz = () => needBusiness();
  function vContact() {
    return `${h1('Your details', 'So we can confirm your ' + (isQuote() ? 'quote.' : 'booking.'))}
      ${st.profile ? `<div class="mt-5 rounded-[16px] bg-purple-soft/70 p-3.5 text-[13px] font-semibold text-purple">Signed in · ${esc(st.profile.customer.phone)}</div>`
        : `<a data-signin href="/my-livo?next=${encodeURIComponent('/book?resume=1')}" class="press mt-5 flex items-center gap-3.5 rounded-[18px] bg-purple-ink text-white p-4 hover:bg-purple transition-colors">
            <span class="size-11 shrink-0 rounded-full bg-lime text-ink grid place-items-center">${ic('<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>', 'size-5')}</span>
            <span class="flex-1 min-w-0"><span class="block font-heading font-bold text-[15px]">Booked with LIVO before?</span><span class="bk-x block text-[12.5px] text-white/75">Sign in with your phone and we fill this in.</span></span>
            <span class="shrink-0 rounded-full bg-white text-ink px-3.5 py-2 text-[13px] font-bold">Sign in</span>
          </a>
          <div class="bk-x mt-4 flex items-center gap-3 text-[12px] text-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span>or enter your details<span class="h-px flex-1 bg-line"></span></div>`}
      <div class="mt-2">
        ${fld('name', biz() ? 'Contact name' : 'Full name', 'text', 'name')}
        ${fld('phone', 'Mobile number', 'tel', 'tel', 'tel')}
        ${fld('email', 'Email', 'email', 'email', 'email')}
      </div>`;
  }

  function vAddress() {
    const places = (st.profile?.places ?? []).filter((p) => (p.segment === 'commercial') === biz());
    return `${h1(biz() ? 'Where is the business?' : 'Where should we come?', 'Only your crew sees the access notes.')}
      ${places.length ? `<div class="mt-5"><div class="text-[13px] text-ink/80">Use a saved ${biz() ? 'business' : 'place'}:</div>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Saved places">
            ${places.map((p) => `<button data-place="${p.id}" aria-pressed="${st.placeId === p.id}" class="press min-h-11 px-4 rounded-full text-[13px] font-semibold border-2 transition-colors ${st.placeId === p.id ? 'border-purple bg-white text-purple' : 'border-line bg-white text-ink'}">${esc(p.label)}</button>`).join('')}
            <button data-place="" aria-pressed="${!st.placeId}" class="press min-h-11 px-4 rounded-full text-[13px] font-semibold border-2 transition-colors ${!st.placeId ? 'border-purple bg-white text-purple' : 'border-line bg-white text-ink'}">+ New address</button>
          </div></div>` : ''}
      <div class="mt-5">
        ${fld('address', biz() ? 'Business address' : 'Service address', 'text', 'street-address')}
        ${fld('access', biz() ? 'Access and hours' : 'Parking, entry and pets', 'text', 'off', '', false)}
        <div class="mt-3"><label for="c-notes" class="text-[13px] font-semibold text-ink/80">Notes <span class="font-normal text-muted">(optional)</span></label>
          <textarea id="c-notes" rows="2" class="resize-none mt-1 w-full px-4 py-3 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15">${esc(st.c.notes)}</textarea></div>
      </div>
      ${st.profile ? `<p class="mt-4 text-[12.5px] text-muted">Saved to your LIVO account for next time.</p>` : `<button id="sv" role="checkbox" aria-checked="${st.save}" class="press mt-4 w-full flex items-start gap-3 p-3 min-h-12 rounded-[12px] bg-cloud text-left">
          <span aria-hidden="true" class="mt-0.5 size-5 shrink-0 rounded-[6px] grid place-items-center ${st.save ? 'bg-purple text-white' : 'border-2 border-gray bg-white'}">${st.save ? ic(CHECK, 'size-3.5') : ''}</span>
          <span class="text-[13.5px]"><b>Save my details for next time.</b> <span class="text-muted">Sign in later with your phone.</span></span>
        </button>`}`;
  }

  function vReview() {
    const t = totals(); const s = sub()!; const tr = tier()!; const f = freq(); const quote = isQuote();
    const lines = [
      [`${s.name} · ${tr.name}`, tr.price != null ? `${quote ? 'from ' : ''}${money(tr.price)}` : 'Free quote'],
      ...(quote ? [] : addons().filter((a) => st.addons[a.id]).map((a) => [`${a.name}${st.addons[a.id] > 1 ? ' × ' + st.addons[a.id] : ''}`, money(a.price * st.addons[a.id])])),
      ...(quote && st.photos.length ? [[`${st.photos.length} photo${st.photos.length > 1 ? 's' : ''} attached`, '']] : []),
    ];
    const when = st.date ? new Date(st.date + 'T12:00').toLocaleDateString('en-CA', { weekday: 'short', month: 'short', day: 'numeric' }) : '';
    return `${h1(quote ? 'Check and send' : 'Check and confirm', 'Nothing is charged now.')}
      <div class="mt-5 card p-5 bk-review">
        <div class="space-y-2 text-[14px]">
          ${lines.map(([a, b]) => `<div class="flex justify-between gap-4"><span class="text-ink/80">${a}</span><span class="font-semibold">${b}</span></div>`).join('')}
          ${!quote && f.id !== 'onetime' ? `<div class="flex justify-between"><span class="text-ink/80">${f.name}${f.discount ? `, −${Math.round(f.discount * 100)}% from 2nd visit` : ''}</span><span class="font-semibold">${money(t.repeat)}/visit</span></div>` : ''}
          ${quote && freqs().length > 1 ? `<div class="flex justify-between"><span class="text-ink/80">How often</span><span class="font-semibold">${f.name}</span></div>` : ''}
        </div>
        <div class="mt-4 pt-4 border-t border-line space-y-1.5 text-[13.5px]">
          <div class="flex justify-between gap-4"><span class="text-muted">${quote ? 'Preferred' : 'When'}</span><span class="font-semibold text-right">${when} · ${esc(st.time)}</span></div>
          <div class="flex justify-between gap-4"><span class="text-muted">Where</span><span class="font-semibold text-right">${esc(st.c.address)}</span></div>
          <div class="flex justify-between gap-4"><span class="text-muted">Contact</span><span class="font-semibold text-right">${esc(st.c.name)} · ${esc(st.c.phone)}</span></div>
        </div>
        ${discountOK() ? `<button id="ft" role="checkbox" aria-checked="${st.firstTime}" class="press mt-4 w-full flex items-center gap-3 p-3 min-h-12 rounded-[12px] transition-colors ${st.firstTime ? 'bg-lime-soft' : 'bg-cloud'} text-left">
          <span aria-hidden="true" class="size-5 shrink-0 rounded-[6px] grid place-items-center ${st.firstTime ? 'bg-purple text-white' : 'border-2 border-gray'}">${st.firstTime ? ic(CHECK, 'size-3.5') : ''}</span>
          <span class="text-[13.5px]">First time with LIVO? <b>${FT}% off</b></span>
        </button>` : ''}
        <div class="mt-4 pt-4 border-t border-line flex justify-between items-baseline">
          <span class="font-semibold">${quote ? 'Price' : f.id !== 'onetime' ? 'First visit' : 'Total'}</span>
          <span class="font-heading font-extrabold text-2xl">${quote ? (tr.price != null ? `from ${money(tr.price)}` : 'Free quote') : money(t.total)}</span>
        </div>
        <p class="mt-1 text-[12px] text-muted">${quote ? `Final price confirmed after we review your photos or visit${needBusiness() ? ', plus tax' : ''}. No obligation.` : f.id !== 'onetime' ? 'Your first visit is the regular price. You pay after each visit; skip or cancel anytime.' : 'You pay after the job.'}</p>
      </div>
      <p class="mt-3 text-[12px] text-muted">We use your details only for this ${quote ? 'quote' : 'booking'}${st.profile || st.save ? ' and your next ones' : ''}. <a href="/privacy" class="underline">Privacy Policy</a></p>
      <div id="bk-err" role="alert" tabindex="-1" class="mt-3 text-sm text-red-700 font-medium outline-none empty:hidden rounded-[12px] bg-red-50 p-3"></div>`;
  }

  function vDone(ref: string, quote: boolean, test: boolean, saved: boolean) {
    const prep: string[] = quote ? [] : (div() as any).prep ?? [];
    const next = quote
      ? ['We look at your photos and details.', 'You get your quote by text and email, usually the same day.', 'Say yes and we lock in your date.']
      : prep;
    return `<div class="text-center">
      <div class="relative mx-auto size-16">
        <div class="confetti absolute inset-0" aria-hidden="true">${Array.from({ length: 18 }, (_, i) => { const a = (i / 18) * Math.PI * 2, r = 60 + (i % 3) * 20; return `<i style="--x:${Math.round(Math.cos(a) * r)}px;--y:${Math.round(Math.sin(a) * r)}px;--r:${i * 47}deg;background:${['#C4D600', '#6B3FA0', '#2C2C2C'][i % 3]}"></i>`; }).join('')}</div>
        <div class="ring pop-in relative isolate size-16 rounded-full bg-lime grid place-items-center"><span class="draw">${ic(CHECK, 'size-8')}</span></div>
      </div>
      <h1 tabindex="-1" class="rise outline-none mt-4 text-[1.8rem] font-extrabold" style="--i:2">${quote ? 'Quote request sent!' : "You're booked!"}</h1>
      <p class="rise mt-1 text-muted text-[14px]" style="--i:3">Reference <b class="text-purple">#${esc(ref)}</b> · ${test ? 'test only, nothing was sent' : 'check your text and email'}</p>
    </div>
    ${next.length ? `<div class="rise mt-5 rounded-[20px] bg-cloud p-5" style="--i:4">
      <div class="font-heading font-bold text-[16px]">${quote ? 'What happens next' : 'Get ready for your crew'}</div>
      <ul class="mt-3 space-y-2.5">${next.map((x, i) => `<li class="flex gap-3 text-[14px]"><span class="shrink-0 size-6 rounded-full ${quote ? 'bg-purple text-white text-[12px] font-bold' : 'bg-lime text-ink'} grid place-items-center" aria-hidden="true">${quote ? i + 1 : ic(CHECK, 'size-3.5')}</span>${esc(x)}</li>`).join('')}</ul>
      ${quote ? '' : `<p class="mt-3 text-[12.5px] text-muted">We text you when your crew is on the way. Need a change? Call ${esc(D.phone)}.</p>`}
    </div>` : ''}
    <div class="rise mt-5 flex flex-col items-center gap-3" style="--i:5">
      <a href="/" class="btn-dark">Back to home</a>
      ${saved ? `<p class="text-[13px] text-muted">Details saved. Next time just <a href="/my-livo" class="font-semibold text-purple underline">sign in</a>.</p>` : ''}
    </div>`;
  }

  function canNext() {
    switch (st.step) {
      case 'service': return !!sub();
      case 'size': return !!tier();
      case 'addons': case 'freq': case 'photos': return true;
      case 'date': return !!st.date;
      case 'time': return !!st.time;
      case 'contact': case 'address': return true;
      case 'review': return !st.sending;
    }
    return false;
  }

  function render() {
    const v = $('#bk-view');
    if (st.step === 'done') return;
    const i = steps().indexOf(st.step as Step);
    $('#bk-stepname').textContent = stepName(st.step as Step);
    $('#bk-count').textContent = `${i + 1} / ${steps().length}`;
    $('#bk-bar').style.width = `${((i + 1) / steps().length) * 100}%`;
    $('#bk-prog').setAttribute('aria-valuenow', String(i + 1));
    $('#bk-prog').setAttribute('aria-valuemax', String(steps().length));
    $('#bk-prog').setAttribute('aria-valuetext', `Step ${i + 1} of ${steps().length}: ${stepName(st.step as Step)}`);
    ($('#bk-back') as HTMLButtonElement).disabled = i === 0;
    v.innerHTML = ({ service: vService, size: vSize, addons: vAddons, photos: vPhotos, freq: vFreq, date: vDate, time: vTime, contact: vContact, address: vAddress, review: vReview } as any)[st.step]();
    const t = totals(); const tr = tier();
    const tot = !sub() ? '—' : isQuote() ? (tr?.price != null ? `from ${money(tr.price)}` : 'Free') : money(t.total);
    $('#bk-totlabel').textContent = isQuote() ? (tr?.price == null ? 'Quote' : 'Price') : 'Total';
    $('#bk-bottom').style.display = st.step === 'service' ? 'none' : ''; // tapping a card moves on; no empty Total / Continue
    const te = $('#bk-total');
    if (te.textContent !== tot) { te.textContent = tot; te.classList.remove('bump'); void te.offsetWidth; te.classList.add('bump'); }
    $('#bk-was').textContent = !isQuote() && t.total !== t.sub ? money(t.sub) : '';
    const nx = $('#bk-next') as HTMLButtonElement;
    nx.disabled = !canNext();
    nx.textContent = st.step === 'review' ? (st.sending ? (st.progress || 'Sending…') : isQuote() ? 'Send quote request' : 'Confirm booking') : 'Continue';
  }

  function go(step: Step) {
    const fwd = steps().indexOf(step) > steps().indexOf(st.step as Step);
    st.step = step; render();
    const v = $('#bk-view'); v.classList.remove('step-fwd', 'step-back'); void v.offsetWidth; v.classList.add(fwd ? 'step-fwd' : 'step-back');
    scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    const i = steps().indexOf(step);
    $('#bk-live').textContent = `Step ${i + 1} of ${steps().length}: ${stepName(step)}`;
    v.querySelector<HTMLElement>('h1')?.focus({ preventScroll: true });
  }

  function applyPlace(p?: Place) {
    st.placeId = p?.id ?? '';
    st.c.address = p?.address ?? ''; st.c.access = p?.access ?? '';
    if (p?.business) st.c.business = p.business;
  }

  $('#bk-view').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null; if (!b || b.disabled) return;
    const ds = b.dataset;
    if (ds.seg) { pickedDiv = false; st.seg = ds.seg as Seg; st.forBusiness = st.seg === 'commercial'; st.div = divsFor(st.seg)[0].id; st.sub = ''; st.tier = ''; st.addons = {}; st.freq = 'onetime'; st.time = ''; }
    else if (ds.div) {
      st.div = ds.div; st.sub = ''; st.tier = ''; st.addons = {}; st.freq = 'onetime'; st.time = '';
      const only = subsFor(div()); if (only.length === 1) { st.sub = only[0].slug; const s = sub()!; st.tier = (s.tiers.find((t) => t.popular) ?? s.tiers[0]).id; st.freq = freqs()[0].id; go('size'); return; }
      pickedDiv = true;
    }
    else if (ds.alldivs !== undefined) { pickedDiv = false; }
    else if (ds.sub) { st.sub = ds.sub; const s = sub()!; st.tier = (s.tiers.find((t) => t.popular) ?? s.tiers[0]).id; st.addons = {}; st.freq = freqs()[0].id; render(); setTimeout(() => go('size'), 160); return; }
    else if (ds.tier) { st.tier = ds.tier; }
    else if (ds.add) { const a = addons().find((x) => x.id === ds.add)!; st.addons[a.id] = st.addons[a.id] ? 0 : 1; }
    else if (ds.inc) { st.addons[ds.inc] = (st.addons[ds.inc] ?? 0) + 1; }
    else if (ds.dec) { st.addons[ds.dec] = Math.max(0, (st.addons[ds.dec] ?? 0) - 1); }
    else if (ds.freq) { st.freq = ds.freq; }
    else if (ds.mon) { let { y, m } = st.month; m += +ds.mon; if (m < 0) { m = 11; y--; } if (m > 11) { m = 0; y++; } st.month = { y, m }; }
    else if (ds.date) { st.date = ds.date; }
    else if (ds.backDate !== undefined) { go('date'); return; }
    else if (ds.time) { st.time = ds.time; }
    else if (ds.for !== undefined) { st.forBusiness = ds.for === 'commercial'; }
    else if (ds.rmphoto !== undefined) { const [p] = st.photos.splice(+ds.rmphoto, 1); URL.revokeObjectURL(p.url); }
    else if (ds.place !== undefined) { applyPlace(st.profile?.places.find((p) => p.id === ds.place)); }
    else if (b.id === 'ft') { st.firstTime = !st.firstTime; }
    else if (b.id === 'sv') { st.save = !st.save; }
    else return;
    const key = Object.keys(ds)[0]; const sel = b.id ? `#${b.id}` : key ? `[data-${key.replace(/[A-Z]/g, (c) => '-' + c.toLowerCase())}="${ds[key]}"]` : '';
    render();
    if (sel) $('#bk-view').querySelector<HTMLElement>(sel)?.focus({ preventScroll: true });
    if (ds.rmphoto !== undefined) $('#bk-view').querySelector<HTMLElement>('#ph-input')?.focus();
  });
  $('#bk-view').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement; const k = el.id.replace('c-', '');
    if (k in st.c) (st.c as any)[k] = el.value;
  });
  $('#bk-view').addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement; if (el.id !== 'ph-input' || !el.files) return;
    const room = MAX_PHOTOS - st.photos.length;
    [...el.files].filter((f) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name)).slice(0, room).forEach((file) => st.photos.push({ file, url: URL.createObjectURL(file) }));
    render(); $('#bk-view').querySelector<HTMLElement>('#ph-input')?.focus();
    $('#bk-live').textContent = `${st.photos.length} photo${st.photos.length === 1 ? '' : 's'} added`;
  });
  function fit() {
    const root = document.documentElement;
    const over = () => root.scrollHeight > innerHeight + 1;
    if (st.step === 'done') { root.classList.remove('bk-tight', 'bk-tighter', 'bk-tightest'); return; }
    // Measure final field heights; height transitions otherwise report the previous step's compact size.
    root.classList.add('bk-fitting');
    root.classList.remove('bk-tight', 'bk-tighter', 'bk-tightest');
    for (const c of ['bk-tight', 'bk-tighter', 'bk-tightest']) { if (!over()) break; root.classList.add(c); }
    void root.offsetHeight;
    root.classList.remove('bk-fitting');
  }
  new MutationObserver(() => requestAnimationFrame(fit)).observe($('#bk-view'), { childList: true });
  addEventListener('resize', () => requestAnimationFrame(fit));
  document.fonts?.ready.then(() => requestAnimationFrame(fit)); // fonts can change heights after first paint
  $('#bk-view').addEventListener('load', () => requestAnimationFrame(fit), true); // add-on photos
  $('#bk-back').addEventListener('click', () => { const i = steps().indexOf(st.step as Step); if (i > 0) go(steps()[i - 1]); });
  $('#bk-next').addEventListener('click', () => {
    if (!canNext()) return;
    if (st.step === 'photos' && !checkPhotos()) return;
    if (st.step === 'addons' && !checkItems()) return;
    const i = steps().indexOf(st.step as Step);
    if ((st.step === 'contact' || st.step === 'address') && !checkFields(st.step === 'contact' ? ['name', 'phone', 'email'] : ['address'])) return;
    if (st.step === 'review') submit(); else go(steps()[i + 1]);
  });

  function itemError() {
    if (sub()?.itemsRequired && !addons().some((a) => (st.addons[a.id] ?? 0) > 0)) return 'Pick at least one item to continue.';
    const minimum = sub()?.minOrder;
    if (minimum != null && totals().total < minimum) return `Minimum order is ${money(minimum)}. Add another item.`;
    return '';
  }

  function checkItems() {
    const message = itemError();
    if (!message) return true;
    const error = document.getElementById('e-items');
    if (error) { error.textContent = message; error.focus({ preventScroll: true }); }
    fit();
    return false;
  }

  function checkPhotos() {
    const ep = document.getElementById('e-photos'); const eb = document.getElementById('e-business');
    let ok = true;
    if (needPhotos() && !st.photos.length) { if (ep) ep.textContent = 'Add at least 1 photo, or go back and choose a free site visit.'; ok = false; } else if (ep) ep.textContent = '';
    if (needBusiness() && !st.c.business.trim()) { if (eb) eb.textContent = 'Enter the business name.'; document.getElementById('c-business')?.setAttribute('aria-invalid', 'true'); ok = false; }
    if (!ok) (document.querySelector<HTMLElement>('#e-photos:not(:empty)') ? document.getElementById('ph-input') : document.getElementById('c-business'))?.focus();
    return ok;
  }

  const MSG: Record<string, string> = { name: 'Enter your name.', phone: 'Enter a 10-digit mobile number.', email: 'Enter an email like name@example.com.', address: 'Enter the address where we should come.' };
  const badFields = (keys: string[]) => keys.filter((k) => k === 'name' ? !st.c.name.trim() : k === 'phone' ? !normPhone(st.c.phone) : k === 'email' ? !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(st.c.email.trim()) : !st.c.address.trim());
  function checkFields(keys: string[]) {
    const bad = badFields(keys);
    keys.forEach((k) => {
      const inp = document.getElementById('c-' + k); const e = document.getElementById('e-' + k);
      inp?.setAttribute('aria-invalid', String(bad.includes(k))); if (e) e.textContent = bad.includes(k) ? MSG[k] : '';
    });
    if (bad.length) document.getElementById('c-' + bad[0])?.focus();
    return !bad.length;
  }

  async function submit() {
    if (itemError()) { go('addons'); checkItems(); return; }
    const err = $('#bk-err'); const c = st.c;
    const phone = normPhone(c.phone);
    // fields live on earlier screens: send the customer back to the first one that needs fixing
    if (badFields(['name', 'phone', 'email']).length) { go('contact'); checkFields(['name', 'phone', 'email']); return; }
    if (badFields(['address']).length) { go('address'); checkFields(['address']); return; }

    const d = div(), s = sub()!, tr = tier()!, f = freq(), t = totals(), quote = isQuote();
    const items = [
      { svcName: d.name, group: s.name, size: tr.name, freq: f.name, price: quote ? 0 : Math.round(tr.price ?? 0) },
      ...(quote ? [] : addons().filter((a) => st.addons[a.id]).map((a) => ({ svcName: d.name, group: 'Add-on: ' + a.name, size: `× ${st.addons[a.id]}`, freq: f.name, price: Math.round(a.price * st.addons[a.id]) }))),
    ];
    st.sending = true; render(); err.textContent = '';
    try {
      const r = await sendRequest({
        kind: quote ? 'quote' : 'booking', segment: segment(),
        name: c.name.trim(), email: c.email.trim(), phone,
        business: needBusiness() ? c.business.trim() : undefined,
        address: c.address.trim(), access: c.access.trim() || undefined,
        date: st.date, time: st.time,
        div: d.id, sub: s.slug, tier: tr.id, service: s.name,
        items, total: quote ? 0 : t.total, firstTime: discountOK() && st.firstTime,
        description: c.description.trim() || undefined,
        notes: [c.notes.trim(), !quote && f.id !== 'onetime' ? `${f.name}: first visit ${money(t.total)}, then ${money(t.repeat)}/visit from the 2nd visit.` : ''].filter(Boolean).join(' · ') || undefined,
        save: !!st.profile || st.save, placeId: st.placeId || undefined,
        prep: quote ? [] : (div() as any).prep ?? [],
      }, st.photos.map((p) => p.file), (n, all) => { st.progress = `Uploading photo ${n} of ${all}…`; render(); });
      st.step = 'done';
      $('#bk-view').innerHTML = vDone(r.ref, quote, r.test, !!st.profile || st.save);
      $('#bk-view').querySelector<HTMLElement>('h1')?.focus({ preventScroll: true });
      $('#bk-bottom').style.display = 'none';
      $('#bk-top').classList.add('invisible');
    } catch {
      st.sending = false; st.progress = ''; render();
      $('#bk-err').textContent = `Something went wrong. Please call ${D.phone} or try again.`;
    }
  }

  if (TEST) $('#bk-testbar').hidden = false;
  if (resumed && needPhotos() && !st.photos.length) st.step = 'photos'; // photos can't survive a page change: ask again
  render();

  // signed-in customers: fill in their details and saved places
  if (signedIn()) getProfile().then((p) => {
    if (!p) return;
    st.profile = p;
    st.c.name ||= p.customer.name; st.c.phone ||= p.customer.phone; st.c.email ||= p.customer.email;
    if (p.customer.company) st.c.business ||= p.customer.company;
    if (p.history.some((h) => h.kind === 'booking')) st.firstTime = false;
    const pre = p.places.find((x) => x.id === st.placeId);
    if (pre) { applyPlace(pre); if (pre.segment === 'commercial') st.forBusiness = true; }
    else st.placeId = '';
    if (st.step === 'contact' || st.step === 'address') render();
  });
</script>
