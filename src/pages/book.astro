---
import Base from '../layouts/Base.astro';
import { DIVISIONS, FIRST_TIME_DISCOUNT, PHONE, PHONE_TEL, isQuoteSub } from '../data/services';

// send only plain data to the browser (no images)
const data = DIVISIONS.map((d) => ({
  id: d.id, name: d.name, short: d.short, icon: d.icon, segment: d.segment,
  subs: d.subs.map((s) => ({ slug: s.slug, name: s.name, short: s.short, unit: s.unit, tierLabel: s.tierLabel, tiers: s.tiers, quoteNote: s.quoteNote ?? '', quote: isQuoteSub(s) })),
  addons: d.addons, freqs: d.freqs, times: d.times,
}));
// divisions businesses can ask about (quote-type services only)
const COMMERCIAL_DIVS = ['commercial-cleaning', 'restaurant-kitchen-cleaning', 'construction-cleaning', 'junk-removal'];
---
<Base title="Book a Service or Get a Quote" description="Book house cleaning, move out cleaning, Airbnb cleaning or junk removal online, or send photos for a free commercial cleaning quote. LIVO Property Services, Coquitlam." tabBar={false} footer={false}>
  <script type="application/json" id="livo-data" set:html={JSON.stringify({ divisions: data, commercialDivs: COMMERCIAL_DIVS, firstTime: FIRST_TIME_DISCOUNT, phone: PHONE, tel: PHONE_TEL })} />

  <div class="mx-auto max-w-xl px-4 pt-2 md:pt-8 pb-40">
    <!-- progress -->
    <div class="flex items-center gap-3" id="bk-top">
      <button id="bk-back" class="press size-11 shrink-0 rounded-full bg-cloud grid place-items-center disabled:opacity-0 disabled:pointer-events-none transition-opacity" aria-label="Previous step">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      </button>
      <div class="flex-1">
        <div class="flex justify-between text-[12px] font-semibold text-muted"><span id="bk-stepname">Service</span><span id="bk-count">1 / 6</span></div>
        <div id="bk-prog" role="progressbar" aria-label="Progress" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1" class="mt-1.5 h-1.5 rounded-full bg-cloud overflow-hidden"><div id="bk-bar" class="h-full bg-gradient-to-r from-purple to-[#8B5CC8] rounded-full transition-[width] duration-700 ease-[var(--ease-out-expo)]" style="width:16%"></div></div>
      </div>
    </div>
    <p id="bk-testbar" hidden class="mt-3 text-[12.5px] font-semibold rounded-[12px] bg-amber-50 text-amber-900 border border-amber-200 px-3 py-2">Test version: nothing is sent or charged. Try anything.</p>

    <div id="bk-live" class="sr-only" aria-live="polite"></div>
    <div id="bk-view" class="mt-6"></div>
  </div>

  <!-- bottom bar -->
  <div slot="after" style="view-transition-name: tab-bar" class="fixed bottom-0 inset-x-0 z-50 bg-white/92 backdrop-blur-xl border-t border-line pb-safe" id="bk-bottom">
    <div class="mx-auto max-w-xl flex items-center gap-3 px-4 h-[80px]">
      <div id="bk-sum" class="flex-1 min-w-0 text-left" aria-live="polite">
        <div class="text-[11.5px] text-muted font-medium" id="bk-totlabel">Total</div>
        <div class="flex items-baseline gap-2">
          <span id="bk-total" class="font-heading font-extrabold text-2xl leading-none">$0</span>
          <span id="bk-was" class="text-sm text-muted line-through"></span>
        </div>
      </div>
      <button id="bk-next" class="sheen btn-lime px-8 disabled:opacity-40 disabled:shadow-none disabled:[&::after]:hidden">Continue</button>
    </div>
  </div>
</Base>

<script>
  import { TEST, sendRequest, signedIn, getProfile, normPhone, type Profile, type Place } from '../lib/api';

  type Tier = { id: string; name: string; sub?: string; price: number | null; popular?: boolean };
  type Addon = { id: string; name: string; sub: string; price: number; unit: string; qty?: boolean };
  type Freq = { id: string; name: string; sub: string; discount: number };
  type SubD = { slug: string; name: string; short: string; unit: string; tierLabel: string; tiers: Tier[]; quoteNote: string; quote: boolean };
  type Seg = 'residential' | 'commercial';
  type Div = { id: string; name: string; short: string; icon: string; segment: Seg; subs: SubD[]; addons: Addon[]; freqs: Freq[]; times: { id: string; sub: string }[] };

  const D = JSON.parse(document.getElementById('livo-data')!.textContent!) as { divisions: Div[]; commercialDivs: string[]; firstTime: number; phone: string; tel: string };
  const FT = Math.round(D.firstTime * 100);
  const MAX_PHOTOS = 10;

  const ALL_STEPS = ['service', 'size', 'addons', 'photos', 'freq', 'when', 'details'] as const;
  type Step = (typeof ALL_STEPS)[number];

  const q = new URLSearchParams(location.search);
  const qDiv = D.divisions.find((d) => d.id === q.get('d'));
  const st = {
    step: 'service' as Step | 'done',
    seg: (q.get('seg') === 'commercial' || (!q.get('seg') && qDiv?.segment === 'commercial') ? 'commercial' : 'residential') as Seg,
    forBusiness: false,
    div: qDiv?.id ?? '',
    sub: q.get('s') ?? '',
    tier: q.get('t') ?? '',
    addons: {} as Record<string, number>,
    freq: 'onetime',
    date: '',
    time: '',
    month: (() => { const n = new Date(); return { y: n.getFullYear(), m: n.getMonth() }; })(),
    firstTime: true,
    photos: [] as { file: File; url: string }[],
    c: { name: '', phone: '', email: '', business: '', address: '', access: '', description: '', notes: '' },
    save: true,
    placeId: q.get('place') ?? '',
    profile: null as Profile | null,
    sending: false,
    progress: '',
  };
  const divsFor = (seg: Seg) => seg === 'residential' ? D.divisions.filter((d) => d.segment === 'residential') : D.commercialDivs.map((id) => D.divisions.find((d) => d.id === id)!);
  const subsFor = (d: Div) => st.seg === 'commercial' ? d.subs.filter((s) => s.quote) : d.subs;
  if (!st.div || !divsFor(st.seg).some((d) => d.id === st.div)) st.div = divsFor(st.seg)[0].id;
  const div = () => D.divisions.find((d) => d.id === st.div)!;
  const sub = () => subsFor(div()).find((s) => s.slug === st.sub);
  const tier = () => sub()?.tiers.find((t) => t.id === st.tier);
  const freq = () => div().freqs.find((f) => f.id === st.freq) ?? div().freqs[0];
  const isQuote = () => !!sub()?.quote || (tier() != null && tier()!.price == null);
  const segment = (): Seg => (div().segment === 'commercial' || st.seg === 'commercial' || st.forBusiness ? 'commercial' : 'residential');
  const discountOK = () => !isQuote() && segment() === 'residential';
  const steps = () => ALL_STEPS.filter((x) =>
    (x !== 'addons' || (!isQuote() && div().addons.length > 0)) &&
    (x !== 'photos' || isQuote()) &&
    (x !== 'freq' || div().freqs.length > 1));
  const NAMES: Record<string, string> = { service: 'Service', size: 'Size', addons: 'Add-ons', photos: 'Photos & details', freq: 'How often', when: 'Date & time', details: 'Your details' };
  const stepName = (x: Step) => x === 'size' && isQuote() && sub()?.tiers.every((t) => t.price == null) ? 'How to quote' : x === 'when' && isQuote() ? 'Preferred date' : NAMES[x];

  if (!sub()) st.sub = '';
  if (st.seg === 'commercial') st.forBusiness = true;
  (q.get('a') ?? '').split(',').forEach((id) => { if (div().addons.some((a) => a.id === id)) st.addons[id] = 1; });
  if (sub() && !tier()) st.tier = (sub()!.tiers.find((t) => t.popular) ?? sub()!.tiers[0]).id;
  if (st.sub && st.tier) st.step = steps()[2];
  else if (st.sub) st.step = 'size';

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (n: number) => '$' + Math.round(n);

  function totals() {
    const base = tier()?.price ?? 0;
    const add = isQuote() ? 0 : div().addons.reduce((s, a) => s + (st.addons[a.id] ?? 0) * a.price, 0);
    const sub = (base + add) * (1 - freq().discount);
    const total = discountOK() && st.firstTime ? sub * (1 - D.firstTime) : sub;
    return { base, add, sub: Math.round(sub), total: Math.round(total) };
  }

  const ic = (p: string, c = 'size-5') => `<svg aria-hidden="true" viewBox="0 0 24 24" class="${c}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
  const CHECK = '<path d="m5 12.5 4.5 4.5L19 7.5"/>';
  const radio = (on: boolean) => `<span aria-hidden="true" class="size-5 shrink-0 rounded-full border-2 grid place-items-center ${on ? 'border-purple' : 'border-gray'}"><span class="size-2.5 rounded-full bg-purple transition duration-300 ease-[var(--ease-spring)] ${on ? 'scale-100' : 'scale-0'}"></span></span>`;
  const optCls = (on: boolean) => `press w-full text-left flex items-center gap-4 p-4 rounded-[20px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft/60' : 'border-line bg-white hover:border-gray'}" aria-pressed="${on}`;
  const h1 = (t: string, s = '') => `<h1 tabindex="-1" class="outline-none text-[1.65rem] md:text-3xl font-extrabold leading-tight">${t}</h1>${s ? `<p class="mt-1 text-muted text-[15px]">${s}</p>` : ''}`;
  const segTabs = (cur: Seg, attr: string, labels: [string, string]) => `<div role="group" aria-label="Customer type" class="grid grid-cols-2 p-1 rounded-full bg-cloud">
      ${(['residential', 'commercial'] as Seg[]).map((s, i) => `<button ${attr}="${s}" aria-pressed="${cur === s}" class="press h-11 rounded-full text-[14px] font-heading font-bold transition-colors ${cur === s ? 'bg-white shadow-soft text-purple' : 'text-muted'}">${labels[i]}</button>`).join('')}
    </div>`;

  function vService() {
    const d = div();
    return `${h1(st.seg === 'residential' ? 'What do you need?' : 'What does your business need?', st.seg === 'residential' ? 'Pick a service. Prices show right away.' : 'Pick a service. We send a free quote, usually the same day.')}
      <div class="mt-5">${segTabs(st.seg, 'data-seg', ['Residential', 'Commercial'])}</div>
      <div class="mt-4 flex gap-2 overflow-x-auto no-scrollbar -mx-4 px-4 py-1" role="group" aria-label="Service type">
        ${divsFor(st.seg).map((x) => `<button data-div="${x.id}" aria-pressed="${x.id === d.id}" class="press shrink-0 h-11 px-4 rounded-full text-[13.5px] font-semibold transition-colors ${x.id === d.id ? 'bg-purple text-white' : 'bg-cloud text-ink hover:bg-purple-soft'}">${x.id === 'junk-removal' && st.seg === 'commercial' ? 'Junk & Debris' : x.name}</button>`).join('')}
      </div>
      <div class="mt-4 grid gap-2.5">
        ${subsFor(d).map((s) => {
          const p = s.tiers.map((t) => t.price).filter((x) => x != null) as number[];
          return `<button data-sub="${s.slug}" class="${optCls(st.sub === s.slug)}">${radio(st.sub === s.slug)}
            <span class="flex-1 min-w-0"><span class="block font-semibold text-[15px]">${s.name}</span><span class="block text-[13px] text-muted leading-snug">${s.short}</span></span>
            <span class="text-right shrink-0">${p.length && !(st.seg === 'commercial') ? `<span class="block text-[11px] text-muted">from</span><span class="font-heading font-extrabold">${money(Math.min(...p))}</span>` : `<span class="text-[13px] font-semibold text-purple">Free quote</span>`}</span></button>`;
        }).join('')}
      </div>`;
  }

  function vSize() {
    const s = sub()!; const allQuote = s.tiers.every((t) => t.price == null);
    return `${h1(allQuote ? 'How should we quote?' : s.tierLabel, s.name)}
      <div class="mt-5 grid gap-2.5">
        ${s.tiers.map((t) => `<button data-tier="${t.id}" class="${optCls(st.tier === t.id)}">${radio(st.tier === t.id)}
          <span class="flex-1"><span class="block font-semibold text-[15px]">${t.name}${t.popular ? ' <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider bg-lime text-ink px-1.5 py-0.5 rounded">Popular</span>' : ''}</span><span class="block text-[13px] text-muted">${t.sub ?? ''}</span></span>
          <span class="font-heading font-extrabold text-lg text-right">${t.price != null ? `${s.quote ? '<span class="block text-[10.5px] font-sans font-medium text-muted leading-none">from</span>' : ''}${money(t.price)}` : `<span class="text-sm text-purple">${allQuote ? 'Free' : 'Quote'}</span>`}</span></button>`).join('')}
      </div>
      ${s.quoteNote ? `<p class="mt-4 text-[13px] text-muted">${s.quoteNote}</p>` : ''}`;
  }

  function vAddons() {
    const d = div();
    return `${h1('Add anything else?', 'Optional. Tap to add.')}
      <div class="mt-5 grid grid-cols-2 gap-2.5">
        ${d.addons.map((a) => {
          const n = st.addons[a.id] ?? 0; const on = n > 0;
          return `<div class="press relative p-4 rounded-[20px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft/60' : 'border-line bg-white hover:border-gray'}">
            <button data-add="${a.id}" class="absolute inset-0 rounded-[20px]" aria-pressed="${on}" aria-label="${a.name}, plus ${money(a.price)} ${a.unit}"></button>
            <div class="flex items-start justify-between gap-2">
              <span class="font-semibold text-[14px] leading-snug">${a.name}</span>
              <span aria-hidden="true" class="size-6 shrink-0 rounded-full grid place-items-center transition duration-300 ${on ? 'bg-purple text-white rotate-[360deg]' : 'bg-cloud text-muted'}">${ic(on ? CHECK : '<path d="M12 5v14M5 12h14"/>', 'size-3.5')}</span>
            </div>
            <div class="text-[12px] text-muted mt-0.5">${a.sub}</div>
            <div class="mt-3 text-[13px]"><b>+${money(a.price)}</b> <span class="text-muted text-[11px]">${a.unit}</span></div>
            ${a.qty && on ? `<div class="relative mt-3 flex items-center justify-between rounded-full bg-white border border-line p-1">
              <button data-dec="${a.id}" class="press size-9 rounded-full bg-cloud grid place-items-center" aria-label="One less ${a.name}">${ic('<path d="M5 12h14"/>', 'size-4')}</button>
              <span class="font-bold text-sm" aria-live="polite">${n}</span>
              <button data-inc="${a.id}" class="press size-9 rounded-full bg-cloud grid place-items-center" aria-label="One more ${a.name}">${ic('<path d="M12 5v14M5 12h14"/>', 'size-4')}</button></div>` : ''}
          </div>`;
        }).join('')}
      </div>`;
  }

  const needPhotos = () => isQuote() && st.tier !== 'visit';
  const needBusiness = () => segment() === 'commercial';
  function vPhotos() {
    const canBeHome = div().segment === 'residential';
    return `${h1('Show us the job', needPhotos() ? 'Add at least 1 photo. More photos, more accurate quote.' : 'Photos are optional for a site visit, but they help.')}
      ${canBeHome ? `<div class="mt-5"><div class="text-[13px] font-semibold text-ink/80 mb-1.5">This is for a</div>${segTabs(st.forBusiness ? 'commercial' : 'residential', 'data-for', ['Home', 'Business'])}</div>` : ''}
      <div class="mt-5">
        <div class="flex items-baseline justify-between"><span id="ph-label" class="text-[13px] font-semibold text-ink/80">Photos ${needPhotos() ? '' : '<span class="font-normal text-muted">(optional)</span>'}</span><span class="text-[12px] text-muted">${st.photos.length} / ${MAX_PHOTOS}</span></div>
        <div class="mt-2 grid grid-cols-3 gap-2" role="list" aria-labelledby="ph-label">
          ${st.photos.map((p, i) => `<div role="listitem" class="relative aspect-square rounded-[12px] overflow-hidden bg-cloud">
              <img src="${p.url}" alt="Photo ${i + 1}" class="size-full object-cover" />
              <button data-rmphoto="${i}" class="press absolute top-1 right-1 size-9 rounded-full bg-white/90 grid place-items-center" aria-label="Remove photo ${i + 1}">${ic('<path d="M6 6l12 12M18 6 6 18"/>', 'size-4')}</button>
            </div>`).join('')}
          ${st.photos.length < MAX_PHOTOS ? `<div role="listitem"><label class="press size-full aspect-square rounded-[12px] border-2 border-dashed border-gray hover:border-purple grid place-items-center text-center cursor-pointer transition-colors">
              <input id="ph-input" type="file" accept="image/*" multiple class="sr-only" aria-describedby="e-photos" />
              <span class="text-purple">${ic('<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>', 'size-6 mx-auto')}<span class="block mt-1 text-[12px] font-semibold">Add photos</span></span>
            </label></div>` : ''}
        </div>
        <p id="e-photos" class="mt-1 text-[13px] text-red-700 empty:hidden"></p>
      </div>
      ${needBusiness() ? fld('business', 'Business name', 'text', 'organization', '', true) : ''}
      <div class="mt-4"><label for="c-description" class="text-[13px] font-semibold text-ink/80">Tell us about the job <span class="font-normal text-muted">(optional)</span></label>
        <textarea id="c-description" rows="3" placeholder="${needBusiness() ? 'Size of the space, how often, opening hours…' : 'Rooms, how much dust or debris, deadline…'}" class="mt-1 w-full px-4 py-3 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15">${esc(st.c.description)}</textarea></div>`;
  }

  function vFreq() {
    const d = div(); const t = totals(); const base = t.base + t.add;
    return `${h1('How often?', isQuote() ? 'We include it in your quote.' : 'Regular clients save on every visit.')}
      <div class="mt-5 grid grid-cols-2 gap-2.5">
        ${d.freqs.map((f) => {
          const on = st.freq === f.id;
          return `<button data-freq="${f.id}" aria-pressed="${on}" class="press text-left p-4 rounded-[20px] border-2 transition-colors ${on ? 'border-purple bg-purple-soft/60' : 'border-line bg-white hover:border-gray'}">
            <div class="flex items-center justify-between"><span class="font-semibold text-[15px]">${f.name}</span>${f.discount ? `<span class="text-[11px] font-bold bg-lime text-ink px-1.5 py-0.5 rounded">−${Math.round(f.discount * 100)}%</span>` : ''}</div>
            <div class="text-[12.5px] text-muted">${f.sub}</div>
            ${isQuote() ? '' : `<div class="mt-3 font-heading font-extrabold">${money(base * (1 - f.discount))}<span class="text-[11px] font-sans font-medium text-muted"> /visit</span></div>`}
          </button>`;
        }).join('')}
      </div>`;
  }

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  function vWhen() {
    const { y, m } = st.month;
    const first = new Date(y, m, 1).getDay(); const days = new Date(y, m + 1, 0).getDate();
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const canPrev = new Date(y, m, 1) > today;
    let cells = '';
    for (let i = 0; i < first; i++) cells += '<span></span>';
    for (let dd = 1; dd <= days; dd++) {
      const dt = new Date(y, m, dd); const iso = `${y}-${String(m + 1).padStart(2, '0')}-${String(dd).padStart(2, '0')}`;
      const past = dt <= today; const sel = st.date === iso;
      const lbl = dt.toLocaleDateString('en-CA', { weekday: 'long', month: 'long', day: 'numeric' });
      cells += `<button data-date="${iso}" ${past ? 'disabled' : ''} aria-pressed="${sel}" aria-label="${lbl}${past ? ', unavailable' : ''}" class="aspect-square min-h-10 rounded-full text-[14px] font-semibold transition duration-300 ${sel ? 'bg-purple text-white shadow-lift scale-105' : past ? 'text-gray line-through decoration-1' : 'hover:bg-cloud'}">${dd}</button>`;
    }
    return `${h1(isQuote() ? 'Preferred date' : 'When should we come?', isQuote() ? 'We confirm the date with you when we send the quote.' : 'Pick a day and a time window.')}
      <div class="mt-5 card p-4">
        <div class="flex items-center justify-between mb-3">
          <button data-mon="-1" ${canPrev ? '' : 'disabled'} aria-label="Previous month" class="press size-11 rounded-full bg-cloud grid place-items-center disabled:opacity-30">${ic('<path d="m15 6-6 6 6 6"/>', 'size-4')}</button>
          <span class="font-heading font-bold" aria-live="polite">${MONTHS[m]} ${y}</span>
          <button data-mon="1" aria-label="Next month" class="press size-11 rounded-full bg-cloud grid place-items-center">${ic('<path d="m9 6 6 6-6 6"/>', 'size-4')}</button>
        </div>
        <div aria-hidden="true" class="grid grid-cols-7 text-center text-[11px] font-semibold text-muted mb-1">${['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((x) => `<span>${x}</span>`).join('')}</div>
        <div class="grid grid-cols-7 gap-1" role="group" aria-label="Choose a date">${cells}</div>
      </div>
      <div class="mt-5 grid gap-2.5" role="group" aria-label="Time window">
        ${div().times.map((t) => `<button data-time="${t.id}" class="${optCls(st.time === t.id)}">${radio(st.time === t.id)}<span class="flex-1 font-semibold text-[15px]">${t.id}</span><span class="text-[13px] text-muted">${t.sub}</span></button>`).join('')}
      </div>`;
  }

  function fld(id: string, label: string, type = 'text', ac = '', im = '', req = true, hint = '') {
    return `<div class="mt-3 first:mt-0"><label for="c-${id}" class="text-[13px] font-semibold text-ink/80">${label}${req ? '' : ' <span class="font-normal text-muted">(optional)</span>'}</label>
        ${hint ? `<p id="h-${id}" class="text-[12px] text-muted">${hint}</p>` : ''}
        <input id="c-${id}" name="${id}" type="${type}" ${req ? 'required aria-required="true"' : ''} aria-describedby="e-${id}${hint ? ` h-${id}` : ''}" ${ac ? `autocomplete="${ac}"` : ''} ${im ? `inputmode="${im}"` : ''} value="${esc((st.c as any)[id])}" class="mt-1 w-full h-12 px-4 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15 aria-[invalid=true]:border-red-600 aria-[invalid=true]:ring-red-600/10 transition" />
        <p id="e-${id}" class="mt-1 text-[13px] text-red-700 empty:hidden"></p></div>`;
  }

  function vDetails() {
    const t = totals(); const s = sub()!; const tr = tier()!; const f = freq(); const quote = isQuote(); const biz = needBusiness();
    const places = (st.profile?.places ?? []).filter((p) => (p.segment === 'commercial') === biz);
    const lines = [
      [`${s.name} · ${tr.name}`, tr.price != null ? `${quote ? 'from ' : ''}${money(tr.price)}` : 'Free quote'],
      ...(quote ? [] : div().addons.filter((a) => st.addons[a.id]).map((a) => [`${a.name}${st.addons[a.id] > 1 ? ' × ' + st.addons[a.id] : ''}`, money(a.price * st.addons[a.id])])),
      ...(quote && st.photos.length ? [[`${st.photos.length} photo${st.photos.length > 1 ? 's' : ''} attached`, '']] : []),
    ];
    const when = st.date ? new Date(st.date + 'T12:00').toLocaleDateString('en-CA', { weekday: 'short', month: 'short', day: 'numeric' }) : '';
    return `${h1('Almost done', `${quote ? 'Preferred: ' : ''}${when} · ${st.time}`)}
      ${st.profile ? `<div class="mt-5 rounded-[16px] bg-purple-soft/70 p-4">
          <div class="text-[13px] font-semibold text-purple">Signed in · ${esc(st.profile.customer.phone)}</div>
          ${places.length ? `<div class="mt-2 text-[13px] text-ink/80">Use a saved ${biz ? 'business' : 'place'}:</div>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Saved places">
            ${places.map((p) => `<button data-place="${p.id}" aria-pressed="${st.placeId === p.id}" class="press min-h-11 px-4 rounded-full text-[13px] font-semibold border-2 transition-colors ${st.placeId === p.id ? 'border-purple bg-white text-purple' : 'border-transparent bg-white text-ink'}">${esc(p.label)}</button>`).join('')}
            <button data-place="" aria-pressed="${!st.placeId}" class="press min-h-11 px-4 rounded-full text-[13px] font-semibold border-2 transition-colors ${!st.placeId ? 'border-purple bg-white text-purple' : 'border-transparent bg-white text-ink'}">+ New address</button>
          </div>` : ''}
        </div>` : `<a href="/my-livo?next=${encodeURIComponent(location.pathname + location.search)}" class="press mt-5 flex items-center gap-3 rounded-[16px] border border-line p-3.5 text-[13.5px] hover:border-gray"><span class="size-9 shrink-0 rounded-full bg-purple-soft text-purple grid place-items-center">${ic('<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>', 'size-[18px]')}</span><span class="flex-1"><b>Booked before?</b> Sign in to fill this in.</span>${ic('<path d="m9 6 6 6-6 6"/>', 'size-4 text-muted')}</a>`}
      <div class="mt-5">
        ${fld('name', biz ? 'Contact name' : 'Full name', 'text', 'name')}
        ${fld('phone', 'Mobile number', 'tel', 'tel', 'tel')}
        ${fld('email', 'Email', 'email', 'email', 'email')}
        ${fld('address', biz ? 'Business address' : 'Service address', 'text', 'street-address')}
        ${fld('access', biz ? 'Access and hours' : 'Parking, entry and pets', 'text', 'off', '', false, 'Only your crew sees this.')}
        <div class="mt-3"><label for="c-notes" class="text-[13px] font-semibold text-ink/80">Notes <span class="font-normal text-muted">(optional)</span></label>
          <textarea id="c-notes" rows="2" class="mt-1 w-full px-4 py-3 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15">${esc(st.c.notes)}</textarea></div>
      </div>
      ${st.profile ? `<p class="mt-4 text-[12.5px] text-muted">Saved to your LIVO account for next time.</p>` : `<button id="sv" role="checkbox" aria-checked="${st.save}" class="press mt-4 w-full flex items-start gap-3 p-3 min-h-12 rounded-[12px] bg-cloud text-left">
          <span aria-hidden="true" class="mt-0.5 size-5 shrink-0 rounded-[6px] grid place-items-center ${st.save ? 'bg-purple text-white' : 'border-2 border-gray bg-white'}">${st.save ? ic(CHECK, 'size-3.5') : ''}</span>
          <span class="text-[13.5px]"><b>Save my details for next time.</b> <span class="text-muted">Sign in later with your phone and skip this step.</span></span>
        </button>`}
      <p class="mt-2 text-[12px] text-muted">We use your details only for this ${quote ? 'quote' : 'booking'}${st.profile || st.save ? ' and your next ones' : ''}. <a href="/privacy" class="underline">Privacy Policy</a></p>
      <div class="mt-6 card p-5">
        <div class="font-heading font-bold">Summary</div>
        <div class="mt-3 space-y-2 text-[14px]">
          ${lines.map(([a, b]) => `<div class="flex justify-between gap-4"><span class="text-ink/80">${a}</span><span class="font-semibold">${b}</span></div>`).join('')}
          ${!quote && f.discount ? `<div class="flex justify-between"><span class="text-ink/80">${f.name} discount</span><span class="font-semibold text-lime-ink">−${Math.round(f.discount * 100)}%</span></div>` : ''}
          ${quote && div().freqs.length > 1 ? `<div class="flex justify-between"><span class="text-ink/80">How often</span><span class="font-semibold">${f.name}</span></div>` : ''}
        </div>
        ${discountOK() ? `<button id="ft" role="checkbox" aria-checked="${st.firstTime}" class="press mt-4 w-full flex items-center gap-3 p-3 min-h-12 rounded-[12px] transition-colors ${st.firstTime ? 'bg-lime-soft' : 'bg-cloud'} text-left">
          <span aria-hidden="true" class="size-5 shrink-0 rounded-[6px] grid place-items-center ${st.firstTime ? 'bg-purple text-white' : 'border-2 border-gray'}">${st.firstTime ? ic(CHECK, 'size-3.5') : ''}</span>
          <span class="text-[13.5px]">First time with LIVO? <b>${FT}% off</b></span>
        </button>` : ''}
        <div class="mt-4 pt-4 border-t border-line flex justify-between items-baseline">
          <span class="font-semibold">${quote ? 'Price' : 'Total'}</span>
          <span class="font-heading font-extrabold text-2xl">${quote ? (tr.price != null ? `from ${money(tr.price)}` : 'Free quote') : money(t.total)}</span>
        </div>
        <p class="mt-1 text-[12px] text-muted">${quote ? 'Final price confirmed after we review your photos or visit. No obligation.' : 'You pay after the job.'}</p>
      </div>
      <div id="bk-err" role="alert" tabindex="-1" class="mt-4 text-sm text-red-700 font-medium outline-none empty:hidden rounded-[12px] bg-red-50 p-3"></div>`;
  }

  function vDone(ref: string, quote: boolean, test: boolean, saved: boolean) {
    return `<div class="text-center pt-6">
      <div class="relative mx-auto size-20">
        <div class="confetti absolute inset-0" aria-hidden="true">${Array.from({ length: 18 }, (_, i) => { const a = (i / 18) * Math.PI * 2, r = 70 + (i % 3) * 22; return `<i style="--x:${Math.round(Math.cos(a) * r)}px;--y:${Math.round(Math.sin(a) * r)}px;--r:${i * 47}deg;background:${['#C4D600', '#6B3FA0', '#2C2C2C'][i % 3]}"></i>`; }).join('')}</div>
        <div class="ring pop-in relative isolate size-20 rounded-full bg-lime grid place-items-center"><span class="draw">${ic(CHECK, 'size-10')}</span></div>
      </div>
      <h1 tabindex="-1" class="rise outline-none mt-6 text-3xl font-extrabold" style="--i:2">${quote ? 'Quote request sent!' : "You're booked!"}</h1>
      <p class="rise mt-2 text-muted" style="--i:3">${test ? 'Test version: nothing was sent.' : 'Confirmation sent by text and email.'}<br/>Reference <b class="text-purple">#${esc(ref)}</b></p>
      <p class="rise mt-6 text-sm text-muted" style="--i:4">${quote ? "We'll review your photos and send your quote, usually the same day." : "We'll call shortly to confirm the details."}</p>
      ${saved ? `<p class="rise mt-4 text-sm" style="--i:4">Your details are saved. Next time, <a href="/my-livo" class="font-semibold text-purple underline">sign in with your phone</a>.</p>` : ''}
      <a href="/" class="rise btn-dark mt-8" style="--i:5">Back to home</a>
    </div>`;
  }

  function canNext() {
    switch (st.step) {
      case 'service': return !!sub();
      case 'size': return !!tier();
      case 'addons': case 'freq': case 'photos': return true;
      case 'when': return !!(st.date && st.time);
      case 'details': return !st.sending;
    }
    return false;
  }

  function render() {
    const v = $('#bk-view');
    if (st.step === 'done') return;
    const i = steps().indexOf(st.step as Step);
    $('#bk-stepname').textContent = stepName(st.step as Step);
    $('#bk-count').textContent = `${i + 1} / ${steps().length}`;
    $('#bk-bar').style.width = `${((i + 1) / steps().length) * 100}%`;
    $('#bk-prog').setAttribute('aria-valuenow', String(i + 1));
    $('#bk-prog').setAttribute('aria-valuemax', String(steps().length));
    $('#bk-prog').setAttribute('aria-valuetext', `Step ${i + 1} of ${steps().length}: ${stepName(st.step as Step)}`);
    ($('#bk-back') as HTMLButtonElement).disabled = i === 0;
    v.innerHTML = ({ service: vService, size: vSize, addons: vAddons, photos: vPhotos, freq: vFreq, when: vWhen, details: vDetails } as any)[st.step]();
    const t = totals(); const tr = tier();
    const tot = !sub() ? '—' : isQuote() ? (tr?.price != null ? `from ${money(tr.price)}` : 'Free quote') : money(t.total);
    $('#bk-totlabel').textContent = isQuote() ? 'Price' : 'Total';
    const te = $('#bk-total');
    if (te.textContent !== tot) { te.textContent = tot; te.classList.remove('bump'); void te.offsetWidth; te.classList.add('bump'); }
    $('#bk-was').textContent = !isQuote() && t.total !== t.sub ? money(t.sub) : '';
    const nx = $('#bk-next') as HTMLButtonElement;
    nx.disabled = !canNext();
    nx.textContent = st.step === 'details' ? (st.sending ? (st.progress || 'Sending…') : isQuote() ? 'Send quote request' : 'Confirm booking') : 'Continue';
  }

  function go(step: Step) {
    const fwd = steps().indexOf(step) > steps().indexOf(st.step as Step);
    st.step = step; render();
    const v = $('#bk-view'); v.classList.remove('step-fwd', 'step-back'); void v.offsetWidth; v.classList.add(fwd ? 'step-fwd' : 'step-back');
    scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    const i = steps().indexOf(step);
    $('#bk-live').textContent = `Step ${i + 1} of ${steps().length}: ${stepName(step)}`;
    v.querySelector<HTMLElement>('h1')?.focus({ preventScroll: true });
  }

  function applyPlace(p?: Place) {
    st.placeId = p?.id ?? '';
    st.c.address = p?.address ?? ''; st.c.access = p?.access ?? '';
    if (p?.business) st.c.business = p.business;
  }

  $('#bk-view').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null; if (!b || b.disabled) return;
    const ds = b.dataset;
    if (ds.seg) { st.seg = ds.seg as Seg; st.forBusiness = st.seg === 'commercial'; st.div = divsFor(st.seg)[0].id; st.sub = ''; st.tier = ''; st.addons = {}; st.freq = 'onetime'; st.time = ''; }
    else if (ds.div) { st.div = ds.div; st.sub = ''; st.tier = ''; st.addons = {}; st.freq = 'onetime'; st.time = ''; }
    else if (ds.sub) { st.sub = ds.sub; const s = sub()!; st.tier = (s.tiers.find((t) => t.popular) ?? s.tiers[0]).id; render(); setTimeout(() => go('size'), 160); return; }
    else if (ds.tier) { st.tier = ds.tier; }
    else if (ds.add) { const a = div().addons.find((x) => x.id === ds.add)!; st.addons[a.id] = st.addons[a.id] ? 0 : 1; }
    else if (ds.inc) { st.addons[ds.inc] = (st.addons[ds.inc] ?? 0) + 1; }
    else if (ds.dec) { st.addons[ds.dec] = Math.max(0, (st.addons[ds.dec] ?? 0) - 1); }
    else if (ds.freq) { st.freq = ds.freq; }
    else if (ds.mon) { let { y, m } = st.month; m += +ds.mon; if (m < 0) { m = 11; y--; } if (m > 11) { m = 0; y++; } st.month = { y, m }; }
    else if (ds.date) { st.date = ds.date; }
    else if (ds.time) { st.time = ds.time; }
    else if (ds.for !== undefined) { st.forBusiness = ds.for === 'commercial'; }
    else if (ds.rmphoto !== undefined) { const [p] = st.photos.splice(+ds.rmphoto, 1); URL.revokeObjectURL(p.url); }
    else if (ds.place !== undefined) { applyPlace(st.profile?.places.find((p) => p.id === ds.place)); }
    else if (b.id === 'ft') { st.firstTime = !st.firstTime; }
    else if (b.id === 'sv') { st.save = !st.save; }
    else return;
    const key = Object.keys(ds)[0]; const sel = b.id ? `#${b.id}` : key ? `[data-${key.replace(/[A-Z]/g, (c) => '-' + c.toLowerCase())}="${ds[key]}"]` : '';
    render();
    if (sel) $('#bk-view').querySelector<HTMLElement>(sel)?.focus({ preventScroll: true });
    if (ds.rmphoto !== undefined) $('#bk-view').querySelector<HTMLElement>('#ph-input')?.focus();
  });
  $('#bk-view').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement; const k = el.id.replace('c-', '');
    if (k in st.c) (st.c as any)[k] = el.value;
  });
  $('#bk-view').addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement; if (el.id !== 'ph-input' || !el.files) return;
    const room = MAX_PHOTOS - st.photos.length;
    [...el.files].filter((f) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name)).slice(0, room).forEach((file) => st.photos.push({ file, url: URL.createObjectURL(file) }));
    render(); $('#bk-view').querySelector<HTMLElement>('#ph-input')?.focus();
    $('#bk-live').textContent = `${st.photos.length} photo${st.photos.length === 1 ? '' : 's'} added`;
  });
  $('#bk-back').addEventListener('click', () => { const i = steps().indexOf(st.step as Step); if (i > 0) go(steps()[i - 1]); });
  $('#bk-next').addEventListener('click', () => {
    if (!canNext()) return;
    if (st.step === 'photos' && !checkPhotos()) return;
    const i = steps().indexOf(st.step as Step);
    if (st.step === 'details') submit(); else go(steps()[i + 1]);
  });

  function checkPhotos() {
    const ep = document.getElementById('e-photos'); const eb = document.getElementById('e-business');
    let ok = true;
    if (needPhotos() && !st.photos.length) { if (ep) ep.textContent = 'Add at least 1 photo, or go back and choose a free site visit.'; ok = false; } else if (ep) ep.textContent = '';
    if (needBusiness() && !st.c.business.trim()) { if (eb) eb.textContent = 'Enter the business name.'; document.getElementById('c-business')?.setAttribute('aria-invalid', 'true'); ok = false; }
    if (!ok) (document.querySelector<HTMLElement>('#e-photos:not(:empty)') ? document.getElementById('ph-input') : document.getElementById('c-business'))?.focus();
    return ok;
  }

  async function submit() {
    const err = $('#bk-err'); const c = st.c;
    const phone = normPhone(c.phone);
    const bad: string[] = [];
    if (!c.name.trim()) bad.push('name');
    if (!phone) bad.push('phone');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email.trim())) bad.push('email');
    if (!c.address.trim()) bad.push('address');
    const MSG: Record<string, string> = { name: 'Enter your name.', phone: 'Enter a 10-digit mobile number.', email: 'Enter an email like name@example.com.', address: 'Enter the address where we should come.' };
    ['name', 'phone', 'email', 'address'].forEach((k) => {
      const inp = document.getElementById('c-' + k); const e = document.getElementById('e-' + k);
      inp?.setAttribute('aria-invalid', String(bad.includes(k))); if (e) e.textContent = bad.includes(k) ? MSG[k] : '';
    });
    if (bad.length) { err.textContent = `Please fix ${bad.length} field${bad.length > 1 ? 's' : ''} above.`; document.getElementById('c-' + bad[0])?.focus(); return; }

    const d = div(), s = sub()!, tr = tier()!, f = freq(), t = totals(), quote = isQuote();
    const k = 1 - f.discount;
    const items = [
      { svcName: d.name, group: s.name, size: tr.name, freq: f.name, price: quote ? 0 : Math.round((tr.price ?? 0) * k) },
      ...(quote ? [] : d.addons.filter((a) => st.addons[a.id]).map((a) => ({ svcName: d.name, group: 'Add-on: ' + a.name, size: `× ${st.addons[a.id]}`, freq: f.name, price: Math.round(a.price * st.addons[a.id] * k) }))),
    ];
    st.sending = true; render(); err.textContent = '';
    try {
      const r = await sendRequest({
        kind: quote ? 'quote' : 'booking', segment: segment(),
        name: c.name.trim(), email: c.email.trim(), phone,
        business: needBusiness() ? c.business.trim() : undefined,
        address: c.address.trim(), access: c.access.trim() || undefined,
        date: st.date, time: st.time,
        div: d.id, sub: s.slug, tier: tr.id, service: s.name,
        items, total: quote ? 0 : t.total, firstTime: discountOK() && st.firstTime,
        description: c.description.trim() || undefined,
        notes: c.notes.trim() || undefined,
        save: !!st.profile || st.save, placeId: st.placeId || undefined,
      }, st.photos.map((p) => p.file), (n, all) => { st.progress = `Uploading photo ${n} of ${all}…`; render(); });
      st.step = 'done';
      $('#bk-view').innerHTML = vDone(r.ref, quote, r.test, !!st.profile || st.save);
      $('#bk-view').querySelector<HTMLElement>('h1')?.focus({ preventScroll: true });
      $('#bk-bottom').style.display = 'none';
      $('#bk-top').classList.add('invisible');
    } catch {
      st.sending = false; st.progress = ''; render();
      $('#bk-err').textContent = `Something went wrong. Please call ${D.phone} or try again.`;
    }
  }

  if (TEST) $('#bk-testbar').hidden = false;
  render();

  // signed-in customers: fill in their details and saved places
  if (signedIn()) getProfile().then((p) => {
    if (!p) return;
    st.profile = p;
    st.c.name ||= p.customer.name; st.c.phone ||= p.customer.phone; st.c.email ||= p.customer.email;
    if (p.customer.company) st.c.business ||= p.customer.company;
    if (p.history.some((h) => h.kind === 'booking')) st.firstTime = false;
    const pre = p.places.find((x) => x.id === st.placeId);
    if (pre) { applyPlace(pre); if (pre.segment === 'commercial') st.forBusiness = true; }
    else st.placeId = '';
    if (st.step === 'details') render();
  });
</script>
