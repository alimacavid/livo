---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { PHONE, PHONE_TEL } from '../data/services';
---
<Base title="My LIVO — Sign In" description="Sign in to LIVO with your phone number to see your saved homes and businesses, past jobs, and book again in seconds.">
  <div class="mx-auto max-w-xl px-4 md:px-6 pt-6 md:pt-12 pb-16">
    <p id="ml-testbar" hidden class="mb-4 text-[12.5px] font-semibold rounded-[12px] bg-amber-50 text-amber-900 border border-amber-200 px-3 py-2">Test version: no real text is sent. Your test code is shown on screen.</p>
    <div id="ml-live" class="sr-only" aria-live="polite"></div>
    <div id="ml-view" aria-busy="true">
      <div class="h-40 rounded-panel bg-cloud animate-pulse motion-reduce:animate-none"></div>
    </div>
    <p class="mt-10 text-center text-[13px] text-muted">Need help? Call <a href={`tel:${PHONE_TEL}`} class="font-semibold text-ink underline">{PHONE}</a></p>
  </div>
</Base>

<script>
  import { TEST, sendCode, verifyCode, signedIn, getProfile, signOut, removePlace, clearTestData, normPhone, type Profile } from '../lib/api';

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const esc = (x: string) => (x ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const ic = (p: string, c = 'size-5') => `<svg aria-hidden="true" viewBox="0 0 24 24" class="${c}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
  const next = new URLSearchParams(location.search).get('next');
  const safeNext = next && next.startsWith('/') && !next.startsWith('//') ? next : '';
  const st = { phone: '', step: 'phone' as 'phone' | 'code' | 'profile', busy: false, err: '', testCode: '', profile: null as Profile | null };

  const field = (id: string, label: string, type: string, ac: string, im: string, val: string, hint = '') => `
    <label for="${id}" class="block text-[13px] font-semibold text-ink/80">${label}</label>
    ${hint ? `<p id="${id}-h" class="text-[12px] text-muted">${hint}</p>` : ''}
    <input id="${id}" type="${type}" autocomplete="${ac}" inputmode="${im}" value="${esc(val)}" aria-describedby="ml-err${hint ? ` ${id}-h` : ''}" ${st.err ? 'aria-invalid="true"' : ''}
      class="mt-1 w-full h-12 px-4 rounded-[8px] border border-line bg-white text-[16px] outline-none focus:border-purple focus:ring-4 focus:ring-purple/15 aria-[invalid=true]:border-red-600 transition" />
    <p id="ml-err" class="mt-1 text-[13px] text-red-700 empty:hidden">${esc(st.err)}</p>`;

  function vPhone() {
    return `<span class="size-14 rounded-full bg-purple-soft text-purple grid place-items-center">${ic('<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>', 'size-7')}</span>
      <h1 tabindex="-1" class="outline-none mt-4 text-[1.9rem] md:text-4xl font-extrabold">My LIVO</h1>
      <p class="mt-1 text-muted">Sign in with your phone. No password. Your saved homes and businesses fill in your next booking.</p>
      <form id="f-phone" class="mt-6" novalidate>
        ${field('phone', 'Mobile number', 'tel', 'tel', 'tel', st.phone, 'We text you a 6-digit code.')}
        <button class="sheen btn-lime w-full mt-4" ${st.busy ? 'disabled' : ''}>${st.busy ? 'Sending…' : 'Text me a code'}</button>
      </form>
      <p class="mt-6 text-[13px] text-muted">New to LIVO? Your account is created the first time you book and tick "Save my details". <a href="/privacy" class="underline">Privacy Policy</a></p>`;
  }

  function vCode() {
    return `<h1 tabindex="-1" class="outline-none text-[1.9rem] font-extrabold">Enter your code</h1>
      <p class="mt-1 text-muted">Sent to ${esc(st.phone)}. <button type="button" data-act="change" class="font-semibold text-purple underline min-h-11">Change number</button></p>
      ${st.testCode ? `<p class="mt-4 rounded-[12px] bg-amber-50 border border-amber-200 text-amber-900 px-3 py-2 text-[13.5px]">Test code: <b class="tracking-widest">${st.testCode}</b></p>` : ''}
      <form id="f-code" class="mt-5" novalidate>
        ${field('code', '6-digit code', 'text', 'one-time-code', 'numeric', '')}
        <button class="sheen btn-lime w-full mt-4" ${st.busy ? 'disabled' : ''}>${st.busy ? 'Checking…' : 'Sign in'}</button>
      </form>
      <button type="button" data-act="resend" class="mt-3 w-full btn-ghost text-ink">Send a new code</button>`;
  }

  const money = (n: number | null) => (n == null ? 'Quote' : '$' + n);
  function vProfile() {
    const p = st.profile!; const c = p.customer;
    const placeName = (id?: string) => p.places.find((x) => x.id === id)?.label ?? '';
    return `<div class="flex items-start justify-between gap-4">
        <div><h1 tabindex="-1" class="outline-none text-[1.9rem] md:text-4xl font-extrabold">${c.name ? `Hi ${esc(c.name.split(' ')[0])}` : 'My LIVO'}</h1>
        <p class="mt-1 text-muted text-[14px]">${esc(c.phone)}${c.email ? ` · ${esc(c.email)}` : ''}</p></div>
        <button type="button" data-act="signout" class="btn-ghost h-11 px-4 text-sm text-ink shrink-0">Sign out</button>
      </div>

      ${safeNext ? `<a href="${esc(safeNext)}" class="sheen btn-lime w-full mt-6">Continue your booking ${ic('<path d="M5 12h14M13 6l6 6-6 6"/>', 'size-4')}</a>` : ''}

      <section class="mt-8">
        <h2 class="text-lg font-extrabold">Saved places</h2>
        ${p.places.length ? `<ul class="mt-3 grid gap-2.5">${p.places.map((pl) => `<li class="card p-4">
            <div class="flex items-start gap-3">
              <span class="size-10 shrink-0 rounded-full bg-purple-soft text-purple grid place-items-center">${pl.segment === 'commercial' ? ic('<rect x="4" y="3" width="11" height="18" rx="1"/><path d="M15 9h5v12h-5M8 7h3M8 11h3M8 15h3M3 21h18"/>', 'size-[18px]') : ic('<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>', 'size-[18px]')}</span>
              <div class="flex-1 min-w-0"><div class="font-semibold">${esc(pl.label)}</div><div class="text-[13px] text-muted">${esc(pl.address)}</div>${pl.access ? `<div class="mt-1 text-[12px] text-muted">${ic('<rect x="4.5" y="10.5" width="15" height="10.5" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>', 'size-3.5 inline -mt-0.5')} Entry notes saved</div>` : ''}</div>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <a href="/book?seg=${pl.segment}&place=${pl.id}" class="btn-lime h-11 text-sm">${pl.segment === 'commercial' ? 'Get a quote' : 'Book here'}</a>
              <button type="button" data-rm="${pl.id}" class="btn-ghost h-11 text-sm text-ink">Remove</button>
            </div></li>`).join('')}</ul>`
          : `<p class="mt-2 text-[14px] text-muted">No saved places yet. Book once and tick "Save my details".</p>`}
      </section>

      <section class="mt-8">
        <h2 class="text-lg font-extrabold">Past jobs</h2>
        ${p.history.length ? `<ul class="mt-3 divide-y divide-line border-y border-line">${p.history.map((h) => `<li class="py-3 flex items-center gap-3">
            <div class="flex-1 min-w-0"><div class="font-semibold text-[14.5px]">${esc(h.service)}</div>
              <div class="text-[12.5px] text-muted">${esc(h.date)} · ${h.kind === 'quote' ? 'Quote request' : money(h.total)}${placeName(h.placeId) ? ` · ${esc(placeName(h.placeId))}` : ''} · #${esc(h.ref)}</div></div>
            <a href="/book?d=${h.div}&s=${h.sub}&t=${h.tier}${h.placeId ? `&place=${h.placeId}` : ''}" class="btn-ghost h-11 px-4 text-sm text-ink shrink-0">${h.kind === 'quote' ? 'Ask again' : 'Book again'}</a>
          </li>`).join('')}</ul>`
          : `<p class="mt-2 text-[14px] text-muted">Nothing yet.</p>`}
      </section>
      ${TEST ? `<button type="button" data-act="wipe" class="mt-8 text-[13px] text-muted underline min-h-11">Test version: clear my test data</button>` : ''}`;
  }

  function render(focus = true) {
    const v = $('#ml-view'); v.removeAttribute('aria-busy');
    v.innerHTML = st.step === 'phone' ? vPhone() : st.step === 'code' ? vCode() : vProfile();
    if (focus) (v.querySelector<HTMLElement>(st.err ? 'input' : st.step === 'code' ? '#code' : 'h1'))?.focus({ preventScroll: true });
  }

  async function loadProfile() {
    st.profile = await getProfile();
    st.step = st.profile ? 'profile' : 'phone'; st.err = '';
    render();
  }

  $('#ml-view').addEventListener('submit', async (e) => {
    e.preventDefault(); if (st.busy) return;
    const f = e.target as HTMLFormElement;
    if (f.id === 'f-phone') {
      const raw = (document.getElementById('phone') as HTMLInputElement).value; st.phone = raw;
      const p = normPhone(raw);
      if (!p) { st.err = 'Enter a 10-digit mobile number.'; render(); return; }
      st.busy = true; st.err = ''; render(false);
      try { const r = await sendCode(p); st.phone = p; st.testCode = r.testCode ?? ''; st.step = 'code'; $('#ml-live').textContent = 'Code sent'; }
      catch { st.err = 'Could not send a code. Try again in a minute.'; }
      st.busy = false; render();
    } else if (f.id === 'f-code') {
      const code = (document.getElementById('code') as HTMLInputElement).value.replace(/\D/g, '');
      if (code.length !== 6) { st.err = 'Enter the 6-digit code.'; render(); return; }
      st.busy = true; st.err = ''; render(false);
      const ok = await verifyCode(st.phone, code);
      st.busy = false;
      if (!ok) { st.err = 'That code is not right or has expired.'; render(); return; }
      $('#ml-live').textContent = 'Signed in';
      await loadProfile();
    }
  });

  $('#ml-view').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null; if (!b) return;
    const act = b.dataset.act;
    if (act === 'change') { st.step = 'phone'; st.err = ''; render(); }
    else if (act === 'resend') { st.busy = true; render(false); try { const r = await sendCode(st.phone); st.testCode = r.testCode ?? ''; $('#ml-live').textContent = 'New code sent'; } catch { st.err = 'Could not send a code.'; } st.busy = false; render(); }
    else if (act === 'signout') { await signOut(); st.profile = null; st.step = 'phone'; st.phone = ''; render(); $('#ml-live').textContent = 'Signed out'; }
    else if (act === 'wipe') { clearTestData(); st.profile = null; st.step = 'phone'; render(); $('#ml-live').textContent = 'Test data cleared'; }
    else if (b.dataset.rm) {
      if (!confirm('Remove this saved place?')) return;
      await removePlace(b.dataset.rm); await loadProfile(); $('#ml-live').textContent = 'Place removed';
    }
  });

  if (TEST) $('#ml-testbar').hidden = false;
  if (signedIn()) loadProfile(); else { st.step = 'phone'; render(false); }
</script>
