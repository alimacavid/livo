---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="mx-auto max-w-xl px-6 py-24 text-center">
    <div class="font-heading font-extrabold text-7xl text-purple">404</div>
    <h1 class="mt-4 text-2xl font-extrabold">This page moved or doesn't exist.</h1>
    <div class="mt-8 flex gap-3 justify-center"><a href="/" class="btn-dark">Home</a><a href="/services" class="btn-lime">Services</a></div>
  </section>
</Base>
