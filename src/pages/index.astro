---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { Image } from 'astro:assets';
import heroVan from '../assets/photos/hero-van.png';
import interiorBefore from '../assets/photos/interior-before.jpg';
import interiorAfter from '../assets/photos/interior-after.jpg';
import airbnbBefore from '../assets/photos/airbnb-before.jpg';
import airbnbAfter from '../assets/photos/airbnb-after.jpg';
import powerBefore from '../assets/photos/power-before.jpg';
import powerAfter from '../assets/photos/power-after.jpg';
import junkBefore from '../assets/photos/junk-before.png';
import junkAfter from '../assets/photos/junk-after.png';
import { DIVISIONS, AREAS, minPrice, subMin, PHONE, PHONE_TEL } from '../data/services';

const [interior, airbnb, power, junk] = ['interior', 'airbnb', 'power', 'junk'].map((id) => DIVISIONS.find((d) => d.id === id)!);
const popular = [
  ['interior', 'move-in-move-out'],
  ['interior', 'deep-cleaning'],
  ['interior', 'post-construction-cleaning'],
  ['airbnb', 'turnover-cleaning'],
  ['power', 'driveway-cleaning'],
  ['junk', 'junk-removal'],
].map(([d, s]) => {
  const div = DIVISIONS.find((x) => x.id === d)!;
  return { div, sub: div.subs.find((x) => x.slug === s)! };
});
const results = [
  { id: 'interior', label: 'Interior', before: interiorBefore, after: interiorAfter },
  { id: 'airbnb', label: 'Airbnb', before: airbnbBefore, after: airbnbAfter },
  { id: 'power', label: 'Exterior', before: powerBefore, after: powerAfter },
  { id: 'junk', label: 'Junk', before: junkBefore, after: junkAfter },
];
const bento = [
  { d: interior, cls: 'col-span-2 aspect-[16/10] md:aspect-auto md:row-span-2 md:col-span-2' },
  { d: airbnb, cls: 'aspect-[4/5] md:aspect-auto' },
  { d: power, cls: 'aspect-[4/5] md:aspect-auto' },
  { d: junk, cls: 'col-span-2 aspect-[16/9] md:aspect-auto md:col-span-2' },
];
---
<Base title="LIVO Property Services — Cleaning, Power Washing & Junk Removal in the Tri-Cities" header="overlay">

  <!-- ═════════ HERO ═════════ -->
  <section class="px-3 md:px-6 pt-1 md:pt-6">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[30px] md:rounded-[36px] h-[min(78svh,660px)] md:h-[600px] bg-purple-ink">
      <Image src={heroVan} alt="LIVO Property Services crew with the LIVO van" class="absolute inset-0 size-full object-cover object-[64%_center] md:object-[70%_center] scale-[1.02]"
        widths={[480, 800, 1200, 1800]} sizes="(min-width:1152px) 1152px, 100vw" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-purple-ink via-purple-ink/60 to-purple-ink/0 md:bg-gradient-to-r md:from-purple-ink md:via-purple-ink/70 md:to-transparent"></div>

      <div class="absolute inset-x-0 bottom-0 px-6 pb-16 md:pb-0 md:px-14 md:inset-y-0 md:flex md:flex-col md:justify-center md:max-w-[620px]">
        <!-- brand lockup -->
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-lime"></span>
          <span class="text-[11.5px] md:text-[13px] font-heading font-bold uppercase tracking-[.28em] text-white/90">LIVO Property Services</span>
        </div>
        <h1 class="mt-4 text-white font-extrabold text-[2.5rem] leading-[1] md:text-[4.1rem] md:leading-[.98]">
          Fall in love with your property.
        </h1>
        <p class="mt-3 font-heading font-extrabold italic text-lime text-[1.35rem] md:text-3xl">We make it happen.</p>
        <p class="hidden md:block mt-5 text-white/75 text-lg max-w-md">Interior cleaning, Airbnb turnovers, power washing and junk removal — one trusted team across the Tri-Cities.</p>
        <div class="mt-7 hidden md:flex gap-3">
          <a href="/book" class="btn-lime h-14 px-8 text-base">Book a service <Icon name="arrow" class="size-4" /></a>
          <a href={`tel:${PHONE_TEL}`} class="btn-ghost h-14 px-7 text-white"><Icon name="phone" class="size-4" />{PHONE}</a>
        </div>
      </div>
    </div>

    <!-- quick service picker (overlaps hero, app style) -->
    <div class="relative z-10 mx-auto max-w-6xl -mt-11 md:-mt-14 px-3 md:px-10">
      <div class="rounded-[24px] bg-white shadow-lift ring-1 ring-black/[.04] p-2.5 md:p-3">
        <div class="grid grid-cols-4 gap-1 md:gap-2">
          {DIVISIONS.map((d) => (
            <a href={`/services/${d.id}`} class="group flex flex-col md:flex-row items-center md:gap-4 rounded-[18px] py-3 md:p-4 hover:bg-cloud active:scale-[.97] transition">
              <span class="size-12 md:size-14 rounded-2xl bg-purple-soft text-purple grid place-items-center group-hover:bg-purple group-hover:text-white transition"><Icon name={d.icon} class="size-6" stroke={1.9} /></span>
              <span class="mt-2 md:mt-0 text-center md:text-left">
                <span class="block text-[12px] md:text-[15px] font-semibold leading-tight">{d.short}</span>
                <span class="block text-[11px] md:text-[13px] text-muted mt-0.5">from ${minPrice(d)}</span>
              </span>
            </a>
          ))}
        </div>
        <a href="/book" class="md:hidden btn-lime w-full mt-2 h-[52px]">Book a service <Icon name="arrow" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- ═════════ TRUST TICKER ═════════ -->
  <section class="mt-6 md:mt-10">
    <div class="flex gap-2 overflow-x-auto no-scrollbar px-4 md:justify-center">
      {[['wallet', 'Upfront prices'], ['check', 'Pay after the job'], ['shield', 'Licensed & insured'], ['clock', 'Same-day response'], ['sparkle', 'Supplies included']].map(([i, t]) => (
        <span class="shrink-0 inline-flex items-center gap-2 h-10 pl-2 pr-4 rounded-full bg-cloud text-[13px] font-semibold">
          <span class="size-7 rounded-full bg-white grid place-items-center text-lime-deep"><Icon name={i} class="size-4" stroke={2.2} /></span>{t}
        </span>
      ))}
    </div>
  </section>

  <!-- ═════════ ONE TEAM — BENTO ═════════ -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 mt-14 md:mt-24">
    <div class="md:flex md:items-end md:justify-between">
      <div>
        <div class="eyebrow">One team · Four services</div>
        <h2 class="mt-2 text-[1.75rem] md:text-5xl font-extrabold leading-[1.05]">Everything your property needs.</h2>
      </div>
      <p class="mt-2 md:mt-0 text-muted md:max-w-xs md:text-right">Inside, outside and in between — one call, one crew, one standard.</p>
    </div>
    <div class="mt-6 grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 md:h-[560px] gap-3 md:gap-4">
      {bento.map(({ d, cls }) => (
        <a href={`/services/${d.id}`} class:list={['group relative overflow-hidden rounded-[24px] bg-cloud active:scale-[.98] transition', cls]} data-reveal>
          <Image src={d.image} alt={d.name} class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-105" widths={[400, 700, 1100]} sizes="(min-width:768px) 560px, 100vw" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <span class="absolute top-3.5 right-3.5 size-9 rounded-full bg-white/95 grid place-items-center text-ink transition group-hover:bg-lime"><Icon name="arrow" class="size-4 -rotate-45" stroke={2.2} /></span>
          <div class="absolute inset-x-0 bottom-0 p-4 md:p-6 text-white">
            <div class="font-heading font-extrabold text-[17px] md:text-2xl leading-tight">{d.name}</div>
            <div class="mt-1 text-[12.5px] md:text-sm text-white/75 line-clamp-1">{d.subs.map((s) => s.name).slice(0, 3).join(' · ')}</div>
            <span class="mt-3 inline-flex items-center rounded-full bg-lime text-ink px-2.5 py-1 text-[12px] font-bold">From ${minPrice(d)}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═════════ POPULAR ═════════ -->
  <section class="mt-14 md:mt-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6 flex items-end justify-between">
      <div>
        <div class="eyebrow">Most booked</div>
        <h2 class="mt-2 text-[1.75rem] md:text-5xl font-extrabold leading-[1.05]">Popular right now.</h2>
      </div>
      <a href="/services" class="shrink-0 text-sm font-semibold text-purple inline-flex items-center gap-1">All services <Icon name="chevron" class="size-4" /></a>
    </div>
    <div class="mt-6 flex gap-3 md:gap-5 overflow-x-auto no-scrollbar snap-x snap-mandatory scroll-px-4 md:scroll-px-6 px-4 md:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] pb-3">
      {popular.map(({ div, sub }) => (
        <a href={`/services/${div.id}/${sub.slug}`} class="group snap-start shrink-0 w-[72%] sm:w-[42%] md:w-[320px] active:scale-[.98] transition">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[22px] bg-cloud">
            <Image src={sub.image} alt={sub.name} class="size-full object-cover transition duration-700 group-hover:scale-105" widths={[360, 640]} sizes="320px" />
            <span class="absolute top-3 left-3 rounded-full bg-white/95 backdrop-blur px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider">{div.short}</span>
            <span class="absolute bottom-3 right-3 rounded-full bg-ink/85 backdrop-blur text-white px-3 py-1.5 text-[13px] font-bold">{subMin(sub) ? `From $${subMin(sub)}` : 'Quote'}</span>
          </div>
          <div class="mt-3 px-1">
            <div class="font-heading font-bold text-[16px]">{sub.name}</div>
            <div class="text-[13px] text-muted line-clamp-1">{sub.short}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═════════ HOW IT WORKS (dark) ═════════ -->
  <section id="how" class="mt-14 md:mt-24 px-3 md:px-6 scroll-mt-20">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[30px] bg-purple-ink text-white px-6 py-10 md:p-16">
      <div class="absolute -top-24 -right-24 size-72 rounded-full bg-purple/60 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-10 size-64 rounded-full bg-lime/15 blur-3xl"></div>
      <div class="relative">
        <div class="text-[11px] font-bold uppercase tracking-[.16em] text-lime">How it works</div>
        <h2 class="mt-2 text-white text-[1.75rem] md:text-5xl font-extrabold leading-[1.05]">Booked in 60 seconds.</h2>
        <ol class="mt-8 md:mt-12 grid md:grid-cols-3 gap-0 md:gap-10">
          {[
            ['Pick & see the price', 'Choose your service and size. The price shows instantly — no quote forms.'],
            ['Choose a time', 'Pick a day and time window. Confirmation comes by text and email.'],
            ['Pay after', 'A uniformed LIVO crew does the job. You pay only when you are happy.'],
          ].map(([t, s], i) => (
            <li class="relative flex md:block gap-5 pb-8 md:pb-0 last:pb-0">
              {i < 2 && <span class="md:hidden absolute left-[21px] top-12 bottom-0 w-px bg-white/15"></span>}
              <span class="relative shrink-0 size-11 rounded-full bg-lime text-ink font-heading font-extrabold grid place-items-center text-lg">{i + 1}</span>
              <div class="md:mt-5">
                <div class="font-heading font-bold text-lg text-white">{t}</div>
                <p class="mt-1 text-[14.5px] text-white/65 leading-relaxed">{s}</p>
              </div>
            </li>
          ))}
        </ol>
        <a href="/book" class="btn-lime mt-10 w-full md:w-auto">Start booking <Icon name="arrow" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- ═════════ RESULTS (tabs) ═════════ -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 mt-14 md:mt-24" id="results">
    <div class="md:grid md:grid-cols-5 md:gap-12 md:items-center">
      <div class="md:col-span-2">
        <div class="eyebrow">Real results</div>
        <h2 class="mt-2 text-[1.75rem] md:text-5xl font-extrabold leading-[1.05]">See the difference.</h2>
        <p class="mt-2 text-muted">Drag the slider. Real LIVO jobs.</p>
        <div class="mt-5 inline-flex p-1 rounded-full bg-cloud" role="tablist">
          {results.map((r, i) => (
            <button role="tab" data-res={r.id} aria-selected={i === 0 ? 'true' : 'false'} class="h-9 px-4 rounded-full text-[13px] font-semibold text-muted transition aria-selected:bg-white aria-selected:text-ink aria-selected:shadow-soft">{r.label}</button>
          ))}
        </div>
      </div>
      <div class="mt-5 md:mt-0 md:col-span-3">
        {results.map((r, i) => (
          <div data-res-panel={r.id} class:list={[i !== 0 && 'hidden']}>
            <BeforeAfter before={r.before} after={r.after} alt={r.label} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ PROMISE ═════════ -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 mt-14 md:mt-24">
    <div class="rounded-[30px] bg-lime-soft p-6 md:p-12 md:grid md:grid-cols-2 md:gap-12 md:items-center">
      <div>
        <div class="text-[11px] font-bold uppercase tracking-[.16em] text-lime-deep">The LIVO promise</div>
        <h2 class="mt-2 text-[1.75rem] md:text-5xl font-extrabold leading-[1.05]">Not right? We fix it before we leave.</h2>
      </div>
      <ul class="mt-6 md:mt-0 space-y-3">
        {[
          ['wallet', 'You pay after the job — never before.'],
          ['shield', 'Licensed, insured, uniformed crews.'],
          ['sparkle', 'All supplies and equipment included.'],
        ].map(([i, t]) => (
          <li class="flex items-center gap-3 rounded-2xl bg-white p-4 shadow-soft">
            <span class="size-10 shrink-0 rounded-full bg-lime grid place-items-center"><Icon name={i} class="size-5" stroke={2} /></span>
            <span class="font-semibold text-[15px]">{t}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ AREAS ═════════ -->
  <section id="areas" class="mx-auto max-w-6xl px-4 md:px-6 mt-14 md:mt-24 scroll-mt-20">
    <div class="md:grid md:grid-cols-5 md:gap-12">
      <div class="md:col-span-2">
        <div class="eyebrow">Where we work</div>
        <h2 class="mt-2 text-[1.75rem] md:text-5xl font-extrabold leading-[1.05]">Home base: the Tri-Cities.</h2>
        <p class="mt-2 text-muted">Based in Port Coquitlam. Serving all of Greater Vancouver.</p>
      </div>
      <div class="mt-5 md:mt-0 md:col-span-3 flex flex-wrap gap-2 content-start">
        {AREAS.map((a, i) => (
          <span class:list={['inline-flex items-center gap-1.5 px-3.5 h-10 rounded-full text-[13px] font-semibold', i < 3 ? 'bg-purple text-white' : 'bg-cloud text-ink']}>
            {i < 3 && <Icon name="pin" class="size-3.5 text-lime" stroke={2.2} />}{a}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ CTA ═════════ -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 mt-14 md:mt-24">
    <div class="hero-grad rounded-[30px] p-7 md:p-16 text-white relative overflow-hidden">
      <div class="absolute -right-20 -bottom-24 size-80 rounded-full bg-lime/20 blur-3xl"></div>
      <div class="relative">
        <div class="text-[11px] md:text-[13px] font-heading font-bold uppercase tracking-[.28em] text-white/70">LIVO Property Services</div>
        <h2 class="mt-3 text-white text-[1.9rem] md:text-6xl font-extrabold leading-[1.02] max-w-xl">Ready when you are.</h2>
        <p class="mt-3 text-white/75 max-w-md">Book online in a minute, or call and we will set it up for you.</p>
        <div class="mt-7 flex flex-col sm:flex-row gap-3">
          <a href="/book" class="btn-lime h-14 px-8">Book a service <Icon name="arrow" class="size-4" /></a>
          <a href={`tel:${PHONE_TEL}`} class="btn-ghost h-14 px-7 text-white"><Icon name="phone" class="size-4" />{PHONE}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-res]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-res]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-res-panel]').forEach((p) => p.classList.toggle('hidden', p.dataset.resPanel !== b.dataset.res));
    }),
  );
</script>
