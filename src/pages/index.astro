---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { Image } from 'astro:assets';
import heroVan from '../assets/photos/hero-van.png';
import interiorBefore from '../assets/photos/interior-before.jpg';
import interiorAfter from '../assets/photos/interior-after.jpg';
import { AREAS, CARDS, HERO_VIDEO, PHONE, PHONE_TEL, getDivision, subMin, type Card } from '../data/services';

// residential, fixed-price services only (quote-only work never shows here)
const popular = [
  ['move-cleaning', 'move-in-move-out-cleaning'],
  ['house-cleaning', 'deep-cleaning'],
  ['airbnb-cleaning', 'turnover-cleaning'],
  ['junk-removal', 'junk-removal-by-load'],
].map(([d, s]) => {
  const div = getDivision(d);
  return { div, sub: div.subs.find((x) => x.slug === s)! };
});
const trust = [
  { icon: 'wallet', t: 'Instant prices or a free quote', s: 'Homes priced online, businesses quoted same day' },
  { icon: 'check', t: 'Pay after the job', s: 'Only when you are happy' },
  { icon: 'user', t: 'Uniformed LIVO crews', s: 'Branded van, LIVO polo and cap' },
  { icon: 'clock', t: 'Same-day response', s: 'Call or book online' },
];
const tileCls = (list: Card[], i: number) =>
  list.length % 2 === 1 && i === 0 ? 'col-span-2 aspect-[2/1] md:col-span-1 md:aspect-[3/4]' : 'aspect-square md:aspect-[3/4]';
---
<Base title="LIVO Property Services — House, Commercial Cleaning & Junk Removal in Coquitlam" header="overlay">

  <!-- ───── HERO ───── -->
  <section class="px-3 md:px-6 pt-1 md:pt-6">
    <div class="on-dark relative mx-auto max-w-6xl overflow-hidden rounded-[28px] md:rounded-[32px] h-[min(76svh,640px)] md:h-[560px] bg-purple-ink">
      <Image src={heroVan} alt="LIVO crew with the LIVO van" class="kenburns absolute inset-0 size-full object-cover object-[62%_center] md:object-center"
        widths={[480, 800, 1200, 1800]} sizes="(min-width:1152px) 1152px, 100vw" loading="eager" fetchpriority="high" />
      {HERO_VIDEO && <video data-hero-video class="absolute inset-0 size-full object-cover motion-reduce:hidden" src={HERO_VIDEO} muted loop playsinline preload="none" aria-hidden="true"></video>}
      <div class="absolute inset-0 bg-gradient-to-t from-purple-ink via-purple-ink/55 to-transparent md:bg-gradient-to-r md:from-purple-ink/90 md:via-purple-ink/40"></div>
      {HERO_VIDEO && <button type="button" data-video-toggle aria-label="Pause video" class="press motion-reduce:hidden absolute top-3 right-3 size-11 rounded-full bg-white/85 backdrop-blur text-ink grid place-items-center"><Icon name="pause" class="size-4" stroke={2.4} /></button>}
      <div class="absolute inset-x-0 bottom-0 p-6 md:p-14 md:inset-y-0 md:flex md:flex-col md:justify-center md:max-w-xl">
        <div class="rise flex items-center gap-2.5" style="--i:0">
          <span class="h-px w-7 bg-lime" aria-hidden="true"></span>
          <span class="text-[12px] md:text-[13px] font-heading font-bold uppercase tracking-[.24em] text-white/90">LIVO Property Services</span>
        </div>
        <h1 class="mt-4 text-white font-extrabold text-[2.35rem] leading-[1.02] md:text-6xl">
          <span class="rise block" style="--i:1">Fall in love with your property.</span>
          <em class="rise block not-italic text-lime mt-1 text-[1.35rem] md:text-3xl font-bold" style="--i:2">We make it happen.</em>
        </h1>
        <div class="rise mt-6 grid grid-cols-1 sm:flex gap-2.5" style="--i:3">
          <a href="/book?seg=residential" class="sheen btn-lime">Book a home service <Icon name="arrow" class="size-4" /></a>
          <a href="#services" data-pick="commercial" class="btn-ghost text-white">Get a business quote</a>
        </div>
        <p class="rise mt-4 text-[13px] text-white/80 flex items-center gap-2" style="--i:4"><Icon name="check" class="size-4 text-lime" stroke={2.4} />Instant prices or a free quote · Pay after the job</p>
      </div>
    </div>
  </section>

  <!-- ───── SERVICES: Residential | Commercial ───── -->
  <section id="services" class="mx-auto max-w-6xl px-4 md:px-6 mt-8 md:mt-20 scroll-mt-20">
    <div class="flex items-end justify-between">
      <h2 class="text-[1.4rem] md:text-4xl font-extrabold">What do you need?</h2>
      <a href="/services" class="text-sm font-semibold text-purple inline-flex items-center gap-1 min-h-11">All <Icon name="chevron" class="size-4" /></a>
    </div>

    <div role="tablist" aria-label="Customer type" class="mt-4 grid grid-cols-2 p-1 rounded-full bg-cloud md:max-w-sm" data-seg-tabs>
      <button role="tab" id="tab-residential" aria-controls="panel-residential" aria-selected="true" data-seg="residential" class="press h-11 rounded-full text-[14px] font-heading font-bold transition-colors aria-selected:bg-white aria-selected:shadow-soft aria-selected:text-purple text-muted">Residential</button>
      <button role="tab" id="tab-commercial" aria-controls="panel-commercial" aria-selected="false" tabindex="-1" data-seg="commercial" class="press h-11 rounded-full text-[14px] font-heading font-bold transition-colors aria-selected:bg-white aria-selected:shadow-soft aria-selected:text-purple text-muted">Commercial</button>
    </div>

    {(['residential', 'commercial'] as const).map((seg) => (
      <div role="tabpanel" id={`panel-${seg}`} aria-labelledby={`tab-${seg}`} hidden={seg === 'commercial'} data-panel={seg}>
        <p class="mt-3 text-[13.5px] text-muted">{seg === 'residential' ? 'Homes, condos and rentals. Prices show right away.' : 'Offices, stores, strata and restaurants. Free quote, usually the same day.'}</p>
        <div class:list={['mt-3 md:mt-5 grid grid-cols-2 gap-2.5 md:gap-5', seg === 'residential' ? 'md:grid-cols-5' : 'md:grid-cols-4']}>
          {CARDS[seg].map((c, i) => (
            <a href={c.href} class:list={['press group relative overflow-hidden rounded-panel bg-cloud', tileCls(CARDS[seg], i)]}>
              <Image src={c.div.image} alt="" class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-105" widths={[320, 520, 700]} sizes="(min-width:768px) 220px, 50vw" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
              <span class="absolute top-3 left-3 size-9 rounded-full bg-white/90 backdrop-blur grid place-items-center text-purple" aria-hidden="true"><Icon name={c.div.icon} class="size-[18px]" /></span>
              <div class="absolute inset-x-0 bottom-0 p-3.5 md:p-4 text-white">
                <div class="font-heading font-bold text-[14px] md:text-base leading-tight">{c.name}</div>
                <div class="mt-1 text-[12px] md:text-[13px] text-white/85">{c.price != null ? <>From <b class="text-lime">${c.price}</b></> : <b class="text-lime font-semibold">Free quote</b>}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <a href="/my-livo" class="press mt-4 flex items-center gap-3 rounded-panel border border-line p-3.5 pr-4 hover:border-gray transition-colors">
      <span class="size-10 shrink-0 rounded-full bg-purple-soft text-purple grid place-items-center" aria-hidden="true"><Icon name="user" class="size-5" /></span>
      <span class="flex-1 min-w-0"><span class="block font-semibold text-[14.5px]">Booked before?</span><span class="block text-[13px] text-muted">Sign in with your phone. Your details are filled in.</span></span>
      <Icon name="chevron" class="size-5 text-muted" />
    </a>
  </section>

  <!-- ───── POPULAR (swipe row, residential prices) ───── -->
  <section class="mt-8 md:mt-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6 flex items-end justify-between">
      <h2 class="text-[1.4rem] md:text-4xl font-extrabold">Popular right now</h2>
    </div>
    <div class="mt-5 flex gap-3 md:gap-5 overflow-x-auto no-scrollbar snap-x snap-mandatory scroll-px-4 md:scroll-px-6 px-4 md:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] pb-2">
      {popular.map(({ div, sub }) => (
        <a href={`/services/${div.id}/${sub.slug}`} class="press group snap-start shrink-0 w-[68%] sm:w-[40%] md:w-[300px] card overflow-hidden hover:shadow-lift transition-shadow">
          <div class="aspect-[16/10] overflow-hidden bg-cloud">
            <Image src={sub.image} alt="" class="size-full object-cover transition duration-700 group-hover:scale-105" widths={[320, 600]} sizes="300px" />
          </div>
          <div class="p-4">
            <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{div.short}</div>
            <div class="mt-1 font-heading font-bold text-[15px] leading-snug">{sub.name}</div>
            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm text-muted">From <b class="text-ink">${subMin(sub)}</b></span>
              <span class="size-8 rounded-full bg-lime grid place-items-center transition duration-300 group-hover:translate-x-1" aria-hidden="true"><Icon name="arrow" class="size-4" stroke={2.2} /></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ───── TRUST ───── -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 mt-8 md:mt-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
      {trust.map((x) => (
        <div class="rounded-panel bg-cloud p-4 md:p-6" data-reveal>
          <span class="size-10 rounded-full bg-white grid place-items-center text-purple shadow-soft"><Icon name={x.icon} class="size-5" stroke={2} /></span>
          <div class="mt-3 font-heading font-bold text-[14px] md:text-base leading-snug">{x.t}</div>
          <div class="mt-0.5 text-[12.5px] md:text-sm text-muted leading-snug">{x.s}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───── HOW IT WORKS (desktop) ───── -->
  <section id="how" class="hidden md:block mx-auto max-w-6xl px-4 md:px-6 mt-24 scroll-mt-20">
    <div class="eyebrow">How it works</div>
    <h2 class="mt-2 text-[1.4rem] md:text-4xl font-extrabold">Two simple ways to start.</h2>
    <div class="mt-6 grid md:grid-cols-2 gap-5">
      {[
        ['Residential', 'Book online', [['Pick your service', 'The price shows right away.'], ['Choose a time', 'Text and email confirm it.'], ['Pay after', 'A uniformed crew does the job.']]],
        ['Commercial', 'Get a free quote', [['Send photos', 'Tell us about the space.'], ['Get your quote', 'Usually the same day.'], ['Pick a date', 'We work around your hours.']]],
      ].map(([lane, title, steps]) => (
        <div class="card p-6" data-reveal>
          <div class="text-[12px] font-bold uppercase tracking-wider text-muted">{lane as string}</div>
          <div class="mt-1 font-heading font-extrabold text-xl">{title as string}</div>
          <ol class="mt-5 space-y-4">
            {(steps as string[][]).map(([t, s], i) => (
              <li class="flex gap-4">
                <span class="shrink-0 size-9 rounded-full bg-purple text-white font-heading font-extrabold grid place-items-center" aria-hidden="true">{i + 1}</span>
                <div><div class="font-heading font-bold">{t}</div><p class="text-sm text-muted">{s}</p></div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- ───── RESULTS ───── -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 mt-9 md:mt-24">
    <div class="md:grid md:grid-cols-5 md:gap-10 md:items-center">
      <div class="md:col-span-2">
        <div class="eyebrow">Results</div>
        <h2 class="mt-2 text-[1.4rem] md:text-4xl font-extrabold">See the difference.</h2>
        <p class="mt-2 text-muted text-sm md:text-base">Drag the slider to compare.</p>
      </div>
      <BeforeAfter before={interiorBefore} after={interiorAfter} alt="House cleaning" class="mt-5 md:mt-0 md:col-span-3" />
    </div>
  </section>

  <!-- ───── AREAS ───── -->
  <section id="areas" class="mx-auto max-w-6xl px-4 md:px-6 mt-9 md:mt-24 scroll-mt-20">
    <div class="eyebrow">Where we work</div>
    <h2 class="mt-2 text-[1.4rem] md:text-4xl font-extrabold">Tri-Cities & Greater Vancouver.</h2>
    <ul class="mt-5 flex flex-wrap gap-2 outline-none" aria-label="Service areas">
      {AREAS.map((a, i) => (
        <li class:list={['px-3.5 py-2 rounded-full text-[13px] font-medium', i < 3 ? 'bg-purple text-white' : 'bg-cloud text-ink', i >= 3 && 'hidden md:block area-more']}>{a}</li>
      ))}
      <li class="md:hidden"><button type="button" data-more-areas class="press px-3.5 py-2 min-h-11 rounded-full text-[13px] font-semibold bg-cloud text-purple" aria-expanded="false">+{AREAS.length - 3} more</button></li>
    </ul>
  </section>

  <!-- ───── CTA (desktop) ───── -->
  <section class="hidden md:block mx-auto max-w-6xl px-4 md:px-6 mt-24">
    <div class="on-dark hero-grad rounded-[28px] p-7 md:p-14 text-white relative overflow-hidden" data-reveal>
      <div class="glow absolute -right-16 -top-16 size-64 rounded-full bg-lime/20 blur-2xl" aria-hidden="true"></div>
      <h2 class="text-white text-[1.6rem] md:text-5xl font-extrabold leading-tight max-w-lg">Ready when you are.</h2>
      <p class="mt-2 text-white/80 max-w-md">Book a home service online in a minute, ask for a business quote, or call us and we will set it up for you.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a href="/book?seg=residential" class="sheen btn-lime">Book a home service <Icon name="arrow" class="size-4" /></a>
        <a href="/book?seg=commercial" class="btn-ghost text-white">Get a business quote</a>
        <a href={`tel:${PHONE_TEL}`} class="btn-ghost text-white"><Icon name="phone" class="size-4" />{PHONE}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Residential | Commercial tabs (arrow keys move between them; #commercial opens Commercial)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-seg-tabs] [role=tab]')];
  function pick(seg: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.seg === seg;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== seg));
    try { sessionStorage.setItem('livo-seg', seg); } catch { /* ignore */ }
  }
  tabs.forEach((t) => {
    t.addEventListener('click', () => pick(t.dataset.seg!));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); pick(t.dataset.seg === 'residential' ? 'commercial' : 'residential', true); }
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => a.addEventListener('click', () => pick(a.dataset.pick!)));
  let start = location.hash === '#commercial' ? 'commercial' : '';
  try { start ||= sessionStorage.getItem('livo-seg') ?? ''; } catch { /* ignore */ }
  if (start) pick(start);

  document.querySelector<HTMLButtonElement>('[data-more-areas]')?.addEventListener('click', (e) => {
    document.querySelectorAll('.area-more').forEach((el) => el.classList.remove('hidden'));
    const ul = (e.currentTarget as HTMLElement).closest('ul')!; (e.currentTarget as HTMLElement).parentElement!.remove();
    ul.setAttribute('tabindex', '-1'); ul.focus();
  });

  // hero video: plays only when motion is allowed and not on data-saver; pause button
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const tg = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const saveData = (navigator as any).connection?.saveData;
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches && !saveData) {
    v.preload = 'auto'; v.play().catch(() => {});
    new IntersectionObserver(([e]) => (e.isIntersecting && tg?.dataset.paused !== '1' ? v.play().catch(() => {}) : v.pause())).observe(v);
  } else if (v) { v.remove(); tg?.remove(); }
  tg?.addEventListener('click', () => {
    const paused = tg.dataset.paused === '1';
    paused ? v?.play() : v?.pause();
    tg.dataset.paused = paused ? '0' : '1';
    tg.setAttribute('aria-label', paused ? 'Pause video' : 'Play video');
    tg.innerHTML = paused ? '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg>' : '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"/></svg>';
  });
</script>

<style is:global>
  @keyframes drift { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-30px,24px) scale(1.15); } }
  .glow { animation: drift 9s ease-in-out infinite; }
</style>
