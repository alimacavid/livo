---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { Image } from 'astro:assets';
import heroVan from '../assets/photos/hero-van.png';
import interiorBefore from '../assets/photos/interior-before.jpg';
import interiorAfter from '../assets/photos/interior-after.jpg';
import { AREAS, CARDS, HERO_VIDEO, PHONE, PHONE_TEL } from '../data/services';

const trust = [
  { icon: 'wallet', t: 'Instant prices or a free quote' },
  { icon: 'check', t: 'Pay after the job' },
  { icon: 'user', t: 'Uniformed LIVO crews' },
];
---
<Base title="LIVO Property Services — House, Commercial Cleaning & Junk Removal in Coquitlam">

  <!-- ───── HERO (minimal: words on white, photo clean, two choices) ───── -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 pt-3 md:pt-12 md:grid md:grid-cols-[1fr_1.05fr] md:gap-14 md:items-center">
    <div>
      <p class="rise text-[12px] md:text-[13px] font-semibold text-muted" style="--i:0">LIVO Property Services · Tri-Cities</p>
      <h1 class="rise mt-2 font-extrabold text-ink text-[2.15rem] leading-[1.05] md:text-[3.6rem] tracking-tight" style="--i:1">Fall in love with your property.</h1>
      <p class="rise mt-2 font-heading font-bold text-purple text-[1.15rem] md:text-2xl" style="--i:2">We make it happen.</p>

      <div class="hidden md:grid mt-9 grid-cols-2 gap-3 max-w-[460px]" data-choices>
        <a href="/book?seg=residential" class="sheen press relative overflow-hidden group flex items-center justify-between gap-3 h-[76px] px-5 rounded-[20px] bg-lime text-ink">
          <span><span class="block font-heading font-extrabold text-[16px]">For my home</span><span class="block text-[13px] text-ink/85">Instant price</span></span>
          <Icon name="arrow" class="size-5 transition group-hover:translate-x-0.5" stroke={2.2} />
        </a>
        <a href="/book?seg=commercial" class="press group flex items-center justify-between gap-3 h-[76px] px-5 rounded-[20px] bg-purple-soft text-purple">
          <span><span class="block font-heading font-extrabold text-[16px]">For my business</span><span class="block text-[13px] text-purple">Free quote</span></span>
          <Icon name="arrow" class="size-5 transition group-hover:translate-x-0.5" stroke={2.2} />
        </a>
      </div>
      <p class="hidden md:flex mt-4 text-[13px] text-muted items-center gap-2"><Icon name="check" class="size-4 text-lime-ink" stroke={2.4} />Pay after the job</p>
    </div>

    <div class="rise relative mt-5 md:mt-0 overflow-hidden rounded-[24px] md:rounded-[32px] bg-cloud h-[min(30svh,260px)] md:h-[430px]" style="--i:3">
      <Image src={heroVan} alt="LIVO crew with the LIVO van" class="kenburns absolute inset-0 size-full object-cover object-[60%_70%] md:object-[55%_85%]"
        widths={[480, 800, 1200, 1600]} sizes="(min-width:768px) 600px, 100vw" loading="eager" fetchpriority="high" />
      {HERO_VIDEO && <video data-hero-video class="absolute inset-0 size-full object-cover motion-reduce:hidden" src={HERO_VIDEO} muted loop playsinline preload="none" aria-hidden="true"></video>}
      {HERO_VIDEO && <button type="button" data-video-toggle aria-label="Pause video" class="press motion-reduce:hidden absolute top-3 right-3 size-11 rounded-full bg-white/85 backdrop-blur text-ink grid place-items-center"><Icon name="pause" class="size-4" stroke={2.4} /></button>}
    </div>

    <!-- mobile choices (under the photo, thumb reach) -->
    <div class="md:hidden rise mt-3 grid grid-cols-2 gap-2.5" style="--i:4">
      <a href="/book?seg=residential" class="sheen press relative overflow-hidden flex flex-col justify-between h-[96px] p-4 rounded-[20px] bg-lime text-ink">
        <span class="flex items-center justify-between"><Icon name="home" class="size-5" stroke={2} /><Icon name="arrow" class="size-[18px]" stroke={2.2} /></span>
        <span><span class="block font-heading font-extrabold text-[15px] leading-tight whitespace-nowrap">For my home</span><span class="block text-[12.5px] text-ink/85">Instant price</span></span>
      </a>
      <a href="/book?seg=commercial" class="press flex flex-col justify-between h-[96px] p-4 rounded-[20px] bg-purple-soft text-purple">
        <span class="flex items-center justify-between"><Icon name="building" class="size-5" stroke={2} /><Icon name="arrow" class="size-[18px]" stroke={2.2} /></span>
        <span><span class="block font-heading font-extrabold text-[15px] leading-tight whitespace-nowrap">For my business</span><span class="block text-[12.5px] text-purple">Free quote</span></span>
      </a>
    </div>
  </section>

  <!-- ───── SERVICES: Residential | Commercial ───── -->
  <section id="services" class="mx-auto max-w-6xl px-4 md:px-6 section-gap scroll-mt-20">
    <div class="flex items-end justify-between">
      <h2 class="text-[1.4rem] md:text-4xl font-extrabold">What do you need?</h2>
      <a href="/services" class="text-sm font-semibold text-purple inline-flex items-center gap-1 min-h-11">All <Icon name="chevron" class="size-4" /></a>
    </div>

    <div role="tablist" aria-label="Customer type" class="mt-4 grid grid-cols-2 p-1 rounded-full bg-cloud md:max-w-sm" data-seg-tabs>
      <button role="tab" id="tab-residential" aria-controls="panel-residential" aria-selected="true" data-seg="residential" class="press h-11 rounded-full text-[14px] font-heading font-bold transition-colors aria-selected:bg-white aria-selected:shadow-soft aria-selected:text-purple text-muted">Residential</button>
      <button role="tab" id="tab-commercial" aria-controls="panel-commercial" aria-selected="false" tabindex="-1" data-seg="commercial" class="press h-11 rounded-full text-[14px] font-heading font-bold transition-colors aria-selected:bg-white aria-selected:shadow-soft aria-selected:text-purple text-muted">Commercial</button>
    </div>

    {(['residential', 'commercial'] as const).map((seg) => (
      <div role="tabpanel" id={`panel-${seg}`} aria-labelledby={`tab-${seg}`} hidden={seg === 'commercial'} data-panel={seg}>
        <div class:list={['mt-3 md:mt-5 grid grid-cols-2 gap-2.5 md:gap-5', seg === 'residential' ? 'md:grid-cols-5' : 'md:grid-cols-4']}>
          {CARDS[seg].map((c, i) => (
            <a href={c.href} class:list={['press group block min-w-0', CARDS[seg].length % 2 === 1 && i === CARDS[seg].length - 1 && 'col-span-2 md:col-span-1']} data-reveal>
              <div class:list={['overflow-hidden rounded-panel bg-cloud', CARDS[seg].length % 2 === 1 && i === CARDS[seg].length - 1 ? 'aspect-[2/1] md:aspect-[4/3]' : 'aspect-[4/3]']}>
                <Image src={c.div.image} alt="" class="size-full object-cover transition duration-500 group-hover:scale-[1.03]" widths={[320, 520, 700]} sizes="(min-width:768px) 220px, 50vw" loading="lazy" />
              </div>
              <div class="pt-3 font-heading font-bold text-[15px] md:text-base leading-snug">{c.name}</div>
              <div class="mt-1 text-[15px] text-muted">{c.price != null ? `From $${c.price}` : 'Free quote'}</div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <a href="/my-livo" class="press mt-4 inline-flex min-h-11 items-center text-[15px] font-semibold text-purple underline underline-offset-4">Booked before? Sign in</a>
  </section>

  <!-- ───── HOW IT WORKS (desktop) ───── -->
  <section id="how" class="hidden md:block mx-auto max-w-6xl px-4 md:px-6 section-gap scroll-mt-20">
    <div class="eyebrow">How it works</div>
    <h2 class="mt-2 text-[1.4rem] md:text-4xl font-extrabold">Two simple ways to start.</h2>
    <div class="mt-6 grid md:grid-cols-2 gap-5">
      {[
        ['Residential', 'Book online', [['Pick your service', 'The price shows right away.'], ['Choose a time', 'Text and email confirm it.'], ['Pay after', 'A uniformed crew does the job.']]],
        ['Commercial', 'Get a free quote', [['Send photos', 'Tell us about the space.'], ['Get your quote', 'Usually the same day.'], ['Pick a date', 'We work around your hours.']]],
      ].map(([lane, title, steps]) => (
        <div class="py-4" data-reveal>
          <div class="text-[12px] font-bold uppercase tracking-wider text-muted">{lane as string}</div>
          <div class="mt-1 font-heading font-extrabold text-xl">{title as string}</div>
          <ol class="mt-5 space-y-4">
            {(steps as string[][]).map(([t, s], i) => (
              <li class="flex gap-4">
                <span class="shrink-0 size-9 rounded-full bg-purple text-white font-heading font-extrabold grid place-items-center" aria-hidden="true">{i + 1}</span>
                <div><div class="font-heading font-bold">{t}</div><p class="text-sm text-muted">{s}</p></div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- ───── RESULTS ───── -->
  <section class="mx-auto max-w-6xl px-4 md:px-6 section-gap">
    <div class="md:grid md:grid-cols-5 md:gap-10 md:items-center">
      <div class="md:col-span-2">
        <div class="eyebrow">Results</div>
        <h2 class="mt-2 text-[1.4rem] md:text-4xl font-extrabold">See the difference.</h2>
        <p class="mt-2 text-muted text-sm md:text-base">Drag the slider to compare.</p>
      </div>
      <BeforeAfter before={interiorBefore} after={interiorAfter} alt="House cleaning" class="mt-5 md:mt-0 md:col-span-3" />
    </div>
  </section>

  <!-- ───── TRUST ───── -->
  <section class="section-gap mx-auto max-w-6xl px-4 md:px-6">
    <h2 class="text-[1.4rem] md:text-4xl font-extrabold">Why LIVO</h2>
    <ul class="mt-6 grid gap-6 md:grid-cols-3">
      {trust.map((x) => (
        <li class="flex items-center gap-3 text-base font-semibold" data-reveal>
          <Icon name={x.icon} class="size-5 shrink-0 text-purple" stroke={2} />{x.t}
        </li>
      ))}
    </ul>
  </section>

  <!-- ───── AREAS ───── -->
  <section id="areas" class="mx-auto max-w-6xl px-4 md:px-6 section-gap scroll-mt-20">
    <div class="eyebrow">Where we work</div>
    <h2 class="mt-2 text-[1.4rem] md:text-4xl font-extrabold">Tri-Cities & Greater Vancouver.</h2>
    <ul class="mt-5 flex flex-wrap gap-2 outline-none" aria-label="Service areas">
      {AREAS.map((a, i) => (
        <li class:list={['px-3.5 py-2 rounded-full text-[13px] font-medium', i < 3 ? 'bg-purple text-white' : 'bg-cloud text-ink', i >= 3 && 'hidden md:block area-more']}>{a}</li>
      ))}
      <li class="md:hidden"><button type="button" data-more-areas class="press px-3.5 py-2 min-h-11 rounded-full text-[13px] font-semibold bg-cloud text-purple" aria-expanded="false">+{AREAS.length - 3} more</button></li>
    </ul>
  </section>

  <!-- ───── CTA (desktop) ───── -->
  <section class="hidden md:block mx-auto max-w-6xl px-4 md:px-6 section-gap">
    <div class="rounded-panel bg-purple-soft p-8 md:p-12" data-reveal>
      <h2 class="text-ink text-[1.6rem] md:text-5xl font-extrabold leading-tight max-w-lg">Ready when you are.</h2>
      <p class="mt-2 text-muted max-w-md">Book a home service online in a minute, ask for a business quote, or call us and we will set it up for you.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a href="/book?seg=residential" class="sheen btn-lime">Book a home service <Icon name="arrow" class="size-4" /></a>
        <a href="/book?seg=commercial" class="btn-ghost text-ink">Get a business quote</a>
        <a href={`tel:${PHONE_TEL}`} class="btn-ghost text-ink"><Icon name="phone" class="size-4" />{PHONE}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Residential | Commercial tabs (arrow keys move between them; #commercial opens Commercial)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-seg-tabs] [role=tab]')];
  function pick(seg: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.seg === seg;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== seg));
    try { sessionStorage.setItem('livo-seg', seg); } catch { /* ignore */ }
  }
  tabs.forEach((t) => {
    t.addEventListener('click', () => pick(t.dataset.seg!));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); pick(t.dataset.seg === 'residential' ? 'commercial' : 'residential', true); }
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => a.addEventListener('click', () => pick(a.dataset.pick!)));
  let start = location.hash === '#commercial' ? 'commercial' : '';
  try { start ||= sessionStorage.getItem('livo-seg') ?? ''; } catch { /* ignore */ }
  if (start) pick(start);

  document.querySelector<HTMLButtonElement>('[data-more-areas]')?.addEventListener('click', (e) => {
    document.querySelectorAll('.area-more').forEach((el) => el.classList.remove('hidden'));
    const ul = (e.currentTarget as HTMLElement).closest('ul')!; (e.currentTarget as HTMLElement).parentElement!.remove();
    ul.setAttribute('tabindex', '-1'); ul.focus();
  });

  // hero video: plays only when motion is allowed and not on data-saver; pause button
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const tg = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const saveData = (navigator as any).connection?.saveData;
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches && !saveData) {
    v.preload = 'auto'; v.play().catch(() => {});
    new IntersectionObserver(([e]) => (e.isIntersecting && tg?.dataset.paused !== '1' ? v.play().catch(() => {}) : v.pause())).observe(v);
  } else if (v) { v.remove(); tg?.remove(); }
  tg?.addEventListener('click', () => {
    const paused = tg.dataset.paused === '1';
    paused ? v?.play() : v?.pause();
    tg.dataset.paused = paused ? '0' : '1';
    tg.setAttribute('aria-label', paused ? 'Pause video' : 'Play video');
    tg.innerHTML = paused ? '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg>' : '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"/></svg>';
  });
</script>
