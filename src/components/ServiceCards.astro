---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { HOME_CARDS, getDivision, subMin } from '../data/services';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const cards = HOME_CARDS.map((c) => ({ ...c, division: getDivision(c.divisionId) }));
---
<div class={`grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5 ${cls}`} data-service-cards>
  {cards.map((c) => (
    <a href={c.href} data-chooser={c.divisionId !== 'junk-removal' && c.division.subs.length > 1 ? `choose-${c.divisionId}` : undefined} aria-haspopup={c.divisionId !== 'junk-removal' && c.division.subs.length > 1 ? 'dialog' : undefined}
      class="press group relative overflow-hidden rounded-panel bg-cloud aspect-[4/5] md:aspect-auto md:h-[340px]" data-reveal>
      <Image src={c.image} alt="" class={`absolute inset-0 size-full object-cover ${c.pos ?? ''} transition duration-700 group-hover:scale-105`}
        widths={[400, 700, 1000]} quality={85} sizes="(min-width:768px) 800px, 100vw" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-3.5 md:p-5 text-white">
        <div class="font-heading font-bold text-[15px] md:text-lg leading-tight">{c.name}</div>
        <div class="mt-1 text-[12px] md:text-sm text-white/85">{c.price != null ? <>From <b class="text-lime">${c.price.toLocaleString('en-CA')}</b>{c.tax && <span class="text-white/75"> + tax</span>}</> : <b class="text-lime font-semibold">Free quote</b>}</div>
      </div>
    </a>
  ))}
</div>
{cards.filter((c) => c.divisionId !== 'junk-removal' && c.division.subs.length > 1).map((c) => (
  <dialog id={`choose-${c.divisionId}`} aria-labelledby={`title-${c.divisionId}`} class="service-chooser bg-white text-ink rounded-t-[24px] md:rounded-[24px] p-4 md:p-5 shadow-lift">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 id={`title-${c.divisionId}`} class="text-xl font-extrabold">{c.name}</h2>
      <button type="button" data-close-chooser class="press size-11 shrink-0 rounded-full bg-cloud grid place-items-center" aria-label="Close service chooser" autofocus><Icon name="x" /></button>
    </div>
    <div class="grid gap-2">
      {c.division.subs.map((s) => {
        const price = subMin(s);
        return <a href={`/services/${c.divisionId}/${s.slug}`} class="press flex items-center gap-3 rounded-[16px] border border-line p-2.5 hover:bg-cloud min-h-20">
          <Image src={s.image} alt="" class={`size-10 shrink-0 rounded-[10px] object-cover ${s.pos ?? ''}`} widths={[80, 160]} sizes="40px" quality={85} />
          <span class="flex-1 min-w-0"><span class="block text-sm font-semibold leading-snug">{s.name}</span><span class="block text-[12px] text-muted mt-1">{price != null ? `from $${price.toLocaleString('en-CA')}${c.tax ? ' + tax' : ''}` : 'Free quote'}</span></span>
          <Icon name="chevron" class="size-4 shrink-0 text-purple" />
        </a>;
      })}
    </div>
  </dialog>
))}
<style>
  .service-chooser { position: fixed; inset: auto 0 0; margin: 0; width: 100%; max-width: none; max-height: 85dvh; overflow-y: auto; padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
  .service-chooser::backdrop { background: rgb(36 20 58 / .55); backdrop-filter: blur(4px); }
  @media (min-width: 768px) {
    .service-chooser { inset: 0; margin: auto; max-width: 480px; max-height: 85dvh; height: fit-content; }
  }
</style>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-chooser]').forEach((card) => {
    const dialog = document.getElementById(card.dataset.chooser!) as HTMLDialogElement;
    let overflow = '';
    card.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      overflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const controls = [...dialog.querySelectorAll<HTMLElement>('button:not(:disabled), a[href]')];
      const first = controls[0], last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    dialog.querySelector('[data-close-chooser]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      const r = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = overflow;
      card.focus({ preventScroll: true });
    });
  });
</script>
