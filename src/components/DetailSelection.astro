---
import type { Addon } from '../data/services';
type Props = { item?: Addon; items?: Addon[]; visitFee?: number; minOrder?: number; bookUrl?: string };
const { item, items, visitFee, minOrder, bookUrl } = Astro.props;
---
{item && <div class="mt-3" data-item-control={item.id} data-qty={String(!!item.qty)}>
  <button type="button" data-item-add aria-pressed="false" aria-label={`Add ${item.name}`} class="item-button">+ Add</button>
  <div data-item-selected hidden class="inline-flex items-center gap-2">
    {item.qty ? <><button type="button" data-item-minus aria-label={`One less ${item.name}`} class="item-button">−</button><span data-item-count class="font-bold w-6 text-center">1</span><button type="button" data-item-plus aria-label={`One more ${item.name}`} class="item-button">+</button></> : <button type="button" data-item-remove aria-pressed="true" aria-label={`Remove ${item.name}`} class="item-button">Added ✓ · Remove</button>}
  </div>
</div>}
{items && <div hidden data-detail-bar data-config={JSON.stringify({ items: items.map(({id, price, qty}) => ({id, price, qty})), visitFee, minOrder, bookUrl })} class="fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-xl border-t border-line pb-safe">
  <div class="mx-auto max-w-6xl flex items-center justify-between gap-3 px-4 min-h-[76px] py-3">
    <div role="status" aria-live="polite"><div data-detail-total class="font-heading font-extrabold text-lg"></div><div data-detail-min class="text-xs text-muted"></div></div>
    <button type="button" data-detail-book class="btn-lime px-6 disabled:opacity-50">Book now</button>
  </div>
</div>}
<style>
  .item-button { min-width: 44px; min-height: 44px; padding: 8px 16px; border: 2px solid var(--color-lime, #c6dc00); border-radius: 999px; font-weight: 700; background: white; color: #21162f; }
  .item-button:focus-visible { outline: 3px solid #67439b; outline-offset: 3px; }
  [hidden] { display: none !important; }
</style>
<script>
  function initDetail() {
    const bar = document.querySelector<HTMLElement>('[data-detail-bar]');
    if (!bar || bar.dataset.ready) return;
    bar.dataset.ready = 'true';
    const config = JSON.parse(bar.dataset.config!);
    const key = 'livo-detail-items';
    let selected: Record<string, number> = {};
    try { selected = JSON.parse(sessionStorage.getItem(key) ?? '{}'); } catch {}
    if (!selected || typeof selected !== 'object' || Array.isArray(selected)) selected = {};
    const items: { id: string; price: number; qty: boolean }[] = config.items;
    selected = Object.fromEntries(items.flatMap(a => {
      const n = selected[a.id]; return Number.isSafeInteger(n) && n > 0 ? [[a.id, a.qty ? n : 1]] : [];
    }));
    const controls = [...document.querySelectorAll<HTMLElement>('[data-item-control]')];
    function render() {
      controls.forEach(el => {
        const n = selected[el.dataset.itemControl!] ?? 0;
        const add = el.querySelector<HTMLButtonElement>('[data-item-add]')!;
        const chosen = el.querySelector<HTMLElement>('[data-item-selected]')!;
        const focus = el.contains(document.activeElement);
        add.hidden = n > 0; add.setAttribute('aria-pressed', String(n > 0)); chosen.hidden = n === 0;
        const count = el.querySelector('[data-item-count]'); if (count) count.textContent = String(n);
        if (focus && (document.activeElement as HTMLElement)?.closest('[hidden]')) (n ? chosen.querySelector('button')! : add).focus({preventScroll:true});
      });
      const n = Object.values(selected).reduce((a,b) => a+b,0);
      const total = config.visitFee + items.reduce((sum,a) => sum+a.price*(selected[a.id] ?? 0),0);
      bar!.hidden = n === 0;
      const defaultBar = document.querySelector<HTMLElement>('[data-default-bookbar]'); if (defaultBar) defaultBar.style.display = n ? 'none' : '';
      bar!.querySelector('[data-detail-total]')!.textContent = `${n} ${n === 1 ? 'item' : 'items'} · $${total}`;
      bar!.querySelector('[data-detail-min]')!.textContent = total < config.minOrder ? `Add $${config.minOrder-total} more (min $${config.minOrder})` : '';
      bar!.querySelector<HTMLButtonElement>('[data-detail-book]')!.disabled = total < config.minOrder;
      try { sessionStorage.setItem(key, JSON.stringify(selected)); } catch {}
    }
    controls.forEach(el => el.addEventListener('click', e => {
      const button = (e.target as HTMLElement).closest('button'); if (!button) return;
      const id = el.dataset.itemControl!;
      if (button.hasAttribute('data-item-add')) selected[id] = 1;
      if (button.hasAttribute('data-item-plus')) selected[id] = (selected[id] ?? 0)+1;
      if (button.hasAttribute('data-item-minus')) selected[id] = Math.max(0,(selected[id] ?? 0)-1);
      if (button.hasAttribute('data-item-remove') || selected[id] === 0) delete selected[id];
      render();
    }));
    bar.querySelector('[data-detail-book]')!.addEventListener('click', () => {
      const a = items.filter(a => selected[a.id]).map(a => `${a.id}:${selected[a.id]}`).join(',');
      window.location.href = `${config.bookUrl}&a=${a}`;
    });
    render();
  }
  initDetail();
  document.addEventListener('astro:page-load', initDetail);
</script>
