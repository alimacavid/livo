---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { subMin, type Division, type Sub } from '../data/services';
interface Props { div: Division; sub: Sub }
const { div, sub } = Astro.props;
const p = subMin(sub);
---
<a href={`/services/${div.id}/${sub.slug}`} class="press group flex items-center gap-4 py-4 pr-2 bg-white border-b border-line hover:bg-cloud transition-colors">
  <div class="shrink-0 size-[72px] md:size-20 rounded-card overflow-hidden bg-cloud">
    <Image src={sub.image} alt="" class="size-full object-cover transition duration-500 group-hover:scale-110" widths={[160]} sizes="80px" />
  </div>
  <div class="min-w-0 flex-1">
    <div class="font-heading font-bold text-[15px] leading-snug">{sub.name}</div>
    <div class="hidden md:block text-[15px] text-muted leading-snug mt-1 line-clamp-2">{sub.short}</div>
    <div class="mt-1.5 text-[15px]">{p ? <>From <b>${p}</b> <span class="text-muted">· {sub.unit}</span></> : <span class="font-semibold text-purple">Free quote</span>}</div>
  </div>
  <Icon name="chevron" class="size-5 text-muted group-hover:text-ink group-hover:translate-x-0.5 transition shrink-0" />
</a>
