---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { before: ImageMetadata; after: ImageMetadata; alt: string; class?: string }
const { before, after, alt, class: cls = '' } = Astro.props;
---
<div class:list={['ba relative overflow-hidden rounded-panel bg-cloud select-none aspect-[4/3] md:aspect-[16/9]', cls]} style="--p:50%">
  <Image src={after} alt={`${alt} — after`} class="absolute inset-0 size-full object-cover" widths={[480, 800, 1200]} sizes="(min-width:768px) 720px, 100vw" />
  <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--p)) 0 0)">
    <Image src={before} alt={`${alt} — before`} class="absolute inset-0 size-full object-cover" widths={[480, 800, 1200]} sizes="(min-width:768px) 720px, 100vw" />
  </div>
  <span aria-hidden="true" class="absolute top-3 left-3 text-[11px] font-bold tracking-wider uppercase bg-black/55 text-white px-2.5 py-1 rounded-full backdrop-blur">Before</span>
  <span aria-hidden="true" class="absolute top-3 right-3 text-[11px] font-bold tracking-wider uppercase bg-lime text-ink px-2.5 py-1 rounded-full">After</span>
  <div class="pointer-events-none absolute inset-y-0 w-0.5 bg-white shadow-[0_0_0_1px_rgb(0_0_0/.08)]" style="left:var(--p)">
    <div class="ba-handle absolute top-1/2 -translate-y-1/2 -translate-x-1/2 size-11 rounded-full bg-white shadow-lift grid place-items-center text-ink transition-[scale] duration-300">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"/></svg>
    </div>
  </div>
  <input type="range" min="0" max="100" value="50" aria-label={`${alt}: drag to compare before and after`} aria-valuetext="50% before, 50% after" class="absolute inset-0 size-full opacity-0 cursor-ew-resize" />
</div>
<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((el) => {
    const r = el.querySelector('input')!;
    r.addEventListener('input', () => {
      el.style.setProperty('--p', r.value + '%');
      r.setAttribute('aria-valuetext', `${r.value}% before, ${100 - +r.value}% after`);
      el.classList.remove('hint');
    });
    // one gentle nudge the first time it's seen, so people know it moves
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { el.classList.add('hint'); io.disconnect(); } }, { threshold: 0.6 });
    io.observe(el);
  });
</script>
<style is:global>
  .ba:has(input:focus-visible) .ba-handle { outline: 3px solid var(--color-purple); outline-offset: 3px; }
  .ba:active .ba-handle { scale: 1.12; }
</style>
